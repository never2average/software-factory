# App-level credentials: what ONE deployed app needs. Sample of NAMES only; never fill it in or commit it.
# The app's state lists the same names (infrastructure.json: secrets_user, secrets_derived, secrets_optional).
# Values live in the deploy target only: Vercel's environment (production) or the app server's
# /etc/software-factory/<app>/env (mode 600). Never in the repository, a state file or a chat.
#
# How to set one you provide (you type it at a hidden prompt, in your own terminal):
#   python3 .claude/scripts/provision.py <app> --set-secret NAME

# --- You provide these (once per operator; `mint.py <app> reuse-keys <other_app>` copies them between apps) ---
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id          # Workers AI inference (Cloudflare dashboard, top right)
CLOUDFLARE_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx      # API token with Workers AI read + edit
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx         # sends sign-in codes and notifications
PLATFORM_NOTIFY_FROM="Your App <notify@yourcompany.com>"   # sender of those emails (domain verified in Resend)
EXA_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx               # web search for the agents
GOOGLE_CLIENT_ID=000000000000-xxxx.apps.googleusercontent.com             # "Sign in with Google" in the browser
NEXT_PUBLIC_GOOGLE_CLIENT_ID=000000000000-xxxx.apps.googleusercontent.com # same value, for the web page

# --- Optional: Google sign-in for the app's coding-agent package (desktop OAuth client) ---------------------
WORKSPACE_OAUTH_CLIENT_ID=000000000000-xxxx.apps.googleusercontent.com
WORKSPACE_OAUTH_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx      # Vercel apps only; used when the package is built
WORKSPACE_CLI_CLIENT_ID=000000000000-xxxx.apps.googleusercontent.com      # extra client ids still accepted (comma-separated)
WORKSPACE_LOGIN_DOMAINS=yourcompany.com                     # single-company mode only: who may sign in with Google

# --- The factory makes these itself during the deploy (you never set them) ---------------------------------
# DATABASE_URL, DATABASE_URL_UNPOOLED (Vercel) or POSTGRES_ADMIN_URL (own server), BLOB_READ_WRITE_TOKEN (Vercel),
# CRON_SECRET, OPS_SECRETS_KEY, AUTH_JWT_PRIVATE_KEY, AUTH_JWT_PUBLIC_KEY, MODEL_PROVIDER,
# TASK_WORKFLOW_SERVICE_TOKEN, TASK_WORKFLOW_SERVICE_URL, NEXT_PUBLIC_EVE_API_URL
