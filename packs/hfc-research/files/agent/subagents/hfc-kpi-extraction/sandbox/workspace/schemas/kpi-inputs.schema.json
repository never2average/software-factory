{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Input of compute_kpis.py",
 "description": "Extracted inputs for one company and one quarter. Amounts are Rs crore unless the object form names another unit; flows (disbursements, opex, employee_cost, nii, pat_quarter) MUST be the discrete quarter.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "primary_context_entity",
  "period",
  "basis",
  "flows_are_discrete_quarter"
 ],
 "properties": {
  "primary_context_entity": {
   "type": "string",
   "minLength": 1,
   "description": "the company's company_id: the entity this row is about"
  },
  "period": {
   "type": "string",
   "pattern": "^Q[1-4] FY\\d{2}$"
  },
  "basis": {
   "enum": [
    "standalone",
    "consolidated"
   ]
  },
  "flows_are_discrete_quarter": {
   "type": "boolean",
   "description": "the extractor's confirmation that every flow below is a three-month figure (taken from a quarter column or derived with derive_quarter.py); when false, no flow-based KPI is computed"
  },
  "opex_definition": {
   "type": "string",
   "description": "which lines of the filing make up `opex`, e.g. 'employee benefits + depreciation + other expenses' or 'other expenses only'"
  },
  "opex_includes_employee_cost": {
   "type": [
    "boolean",
    "null"
   ],
   "description": "true/false as read from the filing; null or absent = not determined (the footnote will say so)"
  },
  "published": {
   "type": "object",
   "description": "the company's own published figure for a computed KPI, kpi key -> percent/multiple/amount"
  },
  "sell_down_tolerance_pct": {
   "type": "number",
   "minimum": 0,
   "maximum": 5
  },
  "aum": {
   "type": [
    "number",
    "object",
    "null"
   ],
   "description": "a number, or {value, unit?, document?, page_or_slide?, source?, status?, footnote?, period?}",
   "additionalProperties": false,
   "required": [
    "value"
   ],
   "properties": {
    "value": {
     "type": [
      "number",
      "string",
      "null"
     ]
    },
    "unit": {
     "enum": [
      "crore",
      "lakh",
      "million",
      "billion",
      "thousand",
      "rupee",
      "%",
      "x",
      "count"
     ]
    },
    "document": {
     "type": "string"
    },
