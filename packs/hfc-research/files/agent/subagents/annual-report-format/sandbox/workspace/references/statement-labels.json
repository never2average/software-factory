{
 "version": 1,
 "about": "Label-normalisation table for the financial statements of an Indian housing finance company (NBFC format, Division III of Schedule III). Read by normalise_statement.py and validate_ar_data.py. Patterns are Python regexes applied case-insensitively to a cleaned label: enumerators such as (a), (i), I., 1. and a trailing note reference are removed first. 'side' restricts a balance-sheet label to the assets, liabilities or equity half, which the script tracks from the statement's own ASSETS / LIABILITIES AND EQUITY heading rows. 'component_of': borrowings is the analysts' total = debt securities + borrowings (other than debt securities) + deposits + subordinated liabilities. value_kind per_share values are never unit-converted. A label that matches nothing is kept as the company printed it and listed as unknown; a label that matches two different entries is kept as-is and listed as ambiguous. A copy sits in skills/financial-statements-division-iii/references/.",
 "side_headers": {
  "assets": [
   "^assets$",
   "^i\\.? ?assets$",
   "^financial assets$",
   "^non[- ]?financial assets$"
  ],
  "liabilities": [
   "^liabilities$",
   "^liabilities and equity$",
   "^equity and liabilities$",
   "^financial liabilities$",
   "^non[- ]?financial liabilities$"
  ],
  "equity": [
   "^equity$"
  ]
 },
 "restructured_patterns": [
  "restructur",
  "resolution (framework|plan)",
  "one[- ]time (restructuring|settlement scheme for msme)",
  "\\botr\\b",
  "covid[- ]?19.{0,40}(resolution|regulatory package|moratorium)"
 ],
 "derived": {
  "borrowings": {
   "sum_of": [
    "debt_securities",
    "borrowings_other_than_debt_securities",
    "deposits",
    "subordinated_liabilities"
   ],
   "statement": "balance_sheet"
  }
 },
 "labels": [
  {
   "normalised": "cash_and_cash_equivalents",
   "statements": [
    "balance_sheet",
    "cash_flow"
   ],
   "value_kind": "amount",
   "patterns": [
    "^cash and cash equivalents( \\(.*\\))?$"
   ],
   "side": "assets"
  },
  {
   "normalised": "bank_balances_other",
   "statements": [
    "balance_sheet"
   ],
   "value_kind": "amount",
   "patterns": [
    "^(other )?bank balances?( other than .*)?$",
    "^bank balances? other than"
   ],
   "side": "assets"
  },
  {
   "normalised": "derivative_financial_instruments_assets",
   "statements": [
    "balance_sheet"
   ],
   "value_kind": "amount",
   "patterns": [
    "^derivative financial (instruments|assets)( \\(.*\\))?$"
   ],
   "side": "assets"
  },
  {
   "normalised": "trade_receivables",
   "statements": [
    "balance_sheet"
   ],
   "value_kind": "amount",
   "patterns": [
    "^(receivables ?[-:]? ?)?(\\(?i\\)? ?)?trade receivables( \\(.*\\))?$"
   ],
   "side": "assets"
  },
  {
   "normalised": "other_receivables",
   "statements": [
    "balance_sheet"
   ],
   "value_kind": "amount",
   "patterns": [
    "^(\\(?ii\\)? ?)?other receivables( \\(.*\\))?$"
   ],
   "side": "assets"
  },
  {
   "normalised": "loan_book",
   "statements": [
    "balance_sheet"
   ],
   "value_kind": "amount",
   "patterns": [
    "^loans( \\(.*\\))?$",
    "^loans and advances( \\(.*\\))?$",
    "^housing and other loans( \\(.*\\))?$"
   ],
   "side": "assets",
   "note": "The analysts' Loan Book Value: the balance-sheet Loans line, net of the impairment allowance as the balance sheet shows it."
  },
  {
   "normalised": "investments",
   "statements": [
    "balance_sheet"
   ],
   "value_kind": "amount",
   "patterns": [
    "^investments( \\(.*\\))?$"
