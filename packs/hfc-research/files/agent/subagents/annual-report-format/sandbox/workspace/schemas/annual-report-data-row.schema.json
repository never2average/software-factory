{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "annual-report-data.jsonl row",
  "description": "One line item extracted from an annual report, appended to Companies/{company_id}/filings/annual-report-data.jsonl. Checked by validate_ar_data.py, which adds the rules a schema cannot express (fy parses, duplicates, restructured-book items absent, amounts in crore).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "primary_context_entity",
    "fy",
    "section",
    "label",
    "normalised_label",
    "value",
    "unit",
    "basis",
    "printed_page",
    "pdf_page"
  ],
  "properties": {
    "primary_context_entity": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "the company's company_id: the entity this row is about"
    },
    "fy": {
      "type": "string",
      "pattern": "^FY[0-9]{2}$",
      "description": "The financial year the FIGURE belongs to. A comparative column in the FY26 report is fy FY25 with report_fy FY26."
    },
    "report_fy": {
      "type": "string",
      "pattern": "^FY[0-9]{2}$",
      "description": "The annual report the figure was read from."
    },
    "section": {
      "enum": [
        "corporate_information",
        "directors_report",
        "mdna",
        "corporate_governance_report",
        "brsr",
        "standalone_financial_statements",
        "consolidated_financial_statements",
        "ind_as_109_notes",
        "loans_and_borrowings_notes",
        "transfer_of_loan_exposures",
        "rbi_hfc_disclosures",
        "related_party_transactions",
        "auditors_report"
      ]
    },
    "statement": {
      "enum": [
        "balance_sheet",
        "profit_and_loss",
        "cash_flow",
        "changes_in_equity",
        "loans_note",
        "borrowings_note",
        "staging",
        "ecl_movement",
        "note",
        "report_text"
      ]
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "description": "The company's own label, as printed."
    },
    "normalised_label": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "From statement-labels.json or the skill's own list; null when the label is unknown."
    },
    "dimension": {
      "type": "string",
      "minLength": 1,
      "description": "What tells two rows with the same label apart: a stage, a maturity bucket, a product, a party."
    },
    "value": {
      "type": [
        "number",
        "null"
      ]
    },
    "unit": {
      "enum": [
        "crore",
        "percent",
        "times",
        "count",
        "rupees",
        "months",
        "years"
      ],
      "description": "Amounts are always crore. lakh, million and billion are never written here: convert first."
    },
    "original_value": {
      "type": "number"
    },
    "original_unit": {
      "enum": [
        "crore",
        "lakh",
        "million",
        "billion",
        "thousand",
        "rupee"
      ]
    },
    "basis": {
      "enum": [
        "standalone",
        "consolidated"
      ]
    },
    "printed_page": {
      "type": "string",
      "pattern": "^([0-9]{1,4}|[ivxlcdm]{1,8}|unnumbered)$"
    },
    "pdf_page": {
      "type": "integer",
      "minimum": 1
    },
    "stitched_pdf_pages": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "note_ref": {
      "type": "string"
    },
    "restated": {
      "type": "boolean",
      "description": "true when the report marks this comparative as restated, regrouped or reclassified."
    },
    "note": {
      "type": "string",
      "minLength": 1
    },
    "source_file": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "value": {
            "type": "null"
          }
        },
        "required": [
          "value"
        ]
      },
      "then": {
        "required": [
          "note"
        ]
      }
    },
    {
      "if": {
        "required": [
          "original_unit"
        ]
      },
      "then": {
        "required": [
          "original_value"
        ],
        "properties": {
          "unit": {
            "const": "crore"
          }
        }
      }
    }
  ]
}