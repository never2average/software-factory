{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Annual report section map",
  "description": "Written by section_map.py, checked by validate_section_map.py, rendered to {fy}_annual-report-map.md by render_section_map_md.py. Page numbers are kept twice: printed_page is the label printed on the page (arabic or roman, as a string), pdf_page is the 1-based index in the PDF.",
  "type": "object",
  "required": [
    "schema_version",
    "customer_id",
    "fy",
    "page_count",
    "offsets",
    "offset_inconsistencies",
    "sections"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "customer_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "fy": {
      "type": "string",
      "pattern": "^FY[0-9]{2}$"
    },
    "source_file": {
      "type": [
        "string",
        "null"
      ]
    },
    "page_count": {
      "type": "integer",
      "minimum": 1
    },
    "content_type": {
      "enum": [
        "text",
        "mixed",
        "scanned",
        null
      ]
    },
    "image_pages": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "method_summary": {
      "enum": [
        "outline",
        "contents",
        "heading_search",
        "manual"
      ]
    },
    "contents_pdf_pages": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "contents_unparsed_lines": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sampled_pages_without_text": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "offsets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "style",
          "pages_per_pdf_page",
          "b",
          "offset",
          "from_pdf_page",
          "to_pdf_page",
          "samples"
        ],
        "additionalProperties": false,
        "properties": {
          "style": {
            "enum": [
              "arabic",
              "roman"
            ]
          },
          "pages_per_pdf_page": {
            "enum": [
              1,
              2
            ]
          },
          "b": {
            "type": "integer"
          },
          "offset": {
            "type": [
              "integer",
              "null"
            ]
          },
          "from_pdf_page": {
            "type": "integer",
            "minimum": 1
          },
          "to_pdf_page": {
            "type": "integer",
            "minimum": 1
          },
          "first_printed": {
            "type": "string"
          },
          "last_printed": {
            "type": "string"
          },
          "samples": {
            "type": "integer",
            "minimum": 1
          },
          "single_sample": {
            "type": "boolean"
          }
        }
      }
    },
    "offset_inconsistencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "statement_order": {
          "enum": [
            "standalone_first",
            "consolidated_first",
            "standalone_only",
            "consolidated_only",
            "unknown"
          ]
        },
        "statutory_reports_first": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "notice_of_agm_inside": {
          "type": "boolean"
        },
        "brsr_inside": {
          "type": "boolean"
        },
        "report_style": {
          "enum": [
            "integrated",
            "statutory_only",
            "debt_listed_slim",
            null
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "title_as_printed",
          "printed_page",
          "pdf_page",
          "end_pdf_page",
          "method",
          "confidence",
          "level",
          "parent",
          "basis",
          "notes"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "enum": [
              "standalone_auditors_report",
              "consolidated_auditors_report",
              "caro_annexure",
              "ifc_annexure",
              "consolidated_financial_statements",
              "standalone_financial_statements",
              "standalone_balance_sheet",
              "consolidated_balance_sheet",
              "standalone_statement_of_profit_and_loss",
              "consolidated_statement_of_profit_and_loss",
              "standalone_cash_flow_statement",
              "consolidated_cash_flow_statement",
              "standalone_statement_of_changes_in_equity",
              "consolidated_statement_of_changes_in_equity",
              "standalone_notes_to_financial_statements",
              "consolidated_notes_to_financial_statements",
              "directors_report",
              "mdna",
              "corporate_governance_report",
              "brsr",
              "corporate_information",
              "notice_of_agm",
              "aoc_2",
              "aoc_1",
              "secretarial_audit_report",
              "csr_report",
              "particulars_of_employees",
              "conservation_of_energy",
              "loans_note",
              "borrowings_notes",
              "ind_as_109_notes",
              "transfer_of_loan_exposures",
              "rbi_hfc_disclosures",
              "related_party_transactions"
            ]
          },
          "title_as_printed": {
            "type": [
              "string",
              "null"
            ]
          },
          "printed_page": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^([0-9]{1,4}|[ivxlcdm]{1,8})$"
          },
          "pdf_page": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "end_printed_page": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^([0-9]{1,4}|[ivxlcdm]{1,8})$"
          },
          "end_pdf_page": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "method": {
            "enum": [
              "outline",
              "contents",
              "heading_search",
              "manual",
              "none"
            ]
          },
          "confidence": {
            "enum": [
              "found",
              "unconfirmed",
              "not_found"
            ]
          },
          "level": {
            "enum": [
              "top",
              "sub"
            ]
          },
          "parent": {
            "type": [
              "string",
              "null"
            ]
          },
          "basis": {
            "enum": [
              "standalone",
              "consolidated",
              null
            ]
          },
          "index_section": {
            "enum": [
              "corporate_information",
              "directors_report",
              "mdna",
              "corporate_governance_report",
              "brsr",
              "standalone_financial_statements",
              "consolidated_financial_statements",
              "ind_as_109_notes",
              "loans_and_borrowings_notes",
              "transfer_of_loan_exposures",
              "rbi_hfc_disclosures",
              "related_party_transactions",
              "auditors_report",
              "financial_statements",
              null
            ]
          },
          "candidates": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "confidence": {
                  "const": "found"
                }
              },
              "required": [
                "confidence"
              ]
            },
            "then": {
              "properties": {
                "pdf_page": {
                  "type": "integer"
                },
                "method": {
                  "enum": [
                    "outline",
                    "contents",
                    "heading_search",
                    "manual"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "confidence": {
                  "const": "not_found"
                }
              },
              "required": [
                "confidence"
              ]
            },
            "then": {
              "properties": {
                "pdf_page": {
                  "type": "null"
                },
                "method": {
                  "const": "none"
                }
              }
            }
          }
        ]
      }
    },
    "other_entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "printed_page": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^([0-9]{1,4}|[ivxlcdm]{1,8})$"
          },
          "pdf_page": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    },
    "layout_memories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}