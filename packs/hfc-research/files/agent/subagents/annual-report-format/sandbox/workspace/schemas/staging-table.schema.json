            "gross_carrying_amount": {
              "type": [
                "number",
                "null"
              ]
            },
            "ecl_allowance": {
              "type": [
                "number",
                "null"
              ]
            },
            "net_carrying_amount": {
              "type": [
                "number",
                "null"
              ]
            },
            "coverage_pct": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "share_of_gross_pct": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 100
            },
            "source_rows": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "stage_3": {
          "type": "object",
          "required": [
            "gross_carrying_amount",
            "ecl_allowance",
            "net_carrying_amount",
            "coverage_pct",
            "share_of_gross_pct",
            "source_rows"
