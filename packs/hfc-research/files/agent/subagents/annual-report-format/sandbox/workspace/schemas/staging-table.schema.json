          "additionalProperties": false,
          "properties": {
            "gross_carrying_amount": {
              "type": [
                "number",
                "null"
              ]
            },
            "ecl_allowance": {
              "type": [
                "number",
                "null"
              ]
            },
            "net_carrying_amount": {
              "type": [
                "number",
                "null"
              ]
            },
            "coverage_pct": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "share_of_gross_pct": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 100
            },
            "source_rows": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "poci": {
          "type": "object",
          "required": [
            "gross_carrying_amount",
            "ecl_allowance",
            "net_carrying_amount",
            "coverage_pct",
            "share_of_gross_pct",
            "source_rows"
          ],
          "additionalProperties": false,
          "properties": {
            "gross_carrying_amount": {
              "type": [
                "number",
                "null"
              ]
            },
            "ecl_allowance": {
              "type": [
                "number",
                "null"
              ]
            },
            "net_carrying_amount": {
              "type": [
                "number",
                "null"
              ]
            },
            "coverage_pct": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "share_of_gross_pct": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 100
            },
            "source_rows": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "total": {
      "type": "object",
      "required": [
        "gross_carrying_amount",
        "ecl_allowance",
        "net_carrying_amount",
        "coverage_pct",
        "share_of_gross_pct",
        "source_rows"
      ],
      "additionalProperties": false,
      "properties": {
        "gross_carrying_amount": {
          "type": [
            "number",
            "null"
          ]
        },
        "ecl_allowance": {
          "type": [
            "number",
            "null"
          ]
        },
        "net_carrying_amount": {
          "type": [
            "number",
            "null"
          ]
        },
        "coverage_pct": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "share_of_gross_pct": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "source_rows": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "footing": {
      "type": "object",
      "required": [
        "gross_carrying_amount",
        "ecl_allowance"
      ],
      "additionalProperties": false,
      "properties": {
        "gross_carrying_amount": {
          "type": "object",
          "required": [
            "checked",
            "foots"
          ],
          "additionalProperties": false,
          "properties": {
            "checked": {
              "type": "boolean"
            },
            "foots": {
              "type": [
                "boolean",
