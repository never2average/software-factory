    "status": {
      "enum": [
        "ok",
        "does_not_foot",
        "incomplete"
      ]
    },
    "excluded_restructured": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unrecognised_rows": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unparseable_values": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "printed_page": {
      "type": [
        "string",
        "null"
      ]
    },
    "pdf_page": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
