{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ind AS 109 staging table",
  "description": "Output of staging_table.py: Stage 1/2/3 gross carrying amount and ECL allowance in Rs crore, coverage computed, totals footed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fy",
    "basis",
    "filing_unit",
    "unit",
    "stages",
    "total",
    "footing",
    "status",
    "excluded_restructured",
    "unrecognised_rows",
    "unparseable_values"
  ],
  "properties": {
    "customer_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "fy": {
      "type": "string",
      "pattern": "^FY[0-9]{2}$"
    },
    "basis": {
      "enum": [
        "standalone",
        "consolidated"
      ]
    },
    "portfolio": {
      "type": [
        "string",
        "null"
      ]
    },
    "filing_unit": {
      "enum": [
        "crore",
        "lakh",
        "million",
        "billion",
        "thousand",
        "rupee"
      ]
    },
    "unit": {
      "const": "crore"
    },
    "stages": {
      "type": "object",
      "required": [
        "stage_1",
        "stage_2",
        "stage_3"
      ],
      "additionalProperties": false,
      "properties": {
        "stage_1": {
          "type": "object",
          "required": [
            "gross_carrying_amount",
            "ecl_allowance",
            "net_carrying_amount",
            "coverage_pct",
            "share_of_gross_pct",
            "source_rows"
          ],
          "additionalProperties": false,
          "properties": {
            "gross_carrying_amount": {
              "type": [
                "number",
                "null"
              ]
            },
            "ecl_allowance": {
              "type": [
                "number",
                "null"
              ]
            },
            "net_carrying_amount": {
              "type": [
                "number",
                "null"
              ]
            },
            "coverage_pct": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "share_of_gross_pct": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 100
            },
            "source_rows": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "stage_2": {
          "type": "object",
          "required": [
            "gross_carrying_amount",
            "ecl_allowance",
            "net_carrying_amount",
            "coverage_pct",
            "share_of_gross_pct",
            "source_rows"
          ],
