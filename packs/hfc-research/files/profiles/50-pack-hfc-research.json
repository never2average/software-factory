      "stalled": "Companies not looked at recently"
    },
    "starter_cards": {
      "owner_label": "Covering analyst",
      "quiet_title": "Refresh the coverage",
      "quiet_summary": "Nothing logged in {days} days.",
      "quiet_summary_long": "Nothing logged for over a month.",
      "quiet_prompt": "{name} has had nothing logged for {days} days. Check the exchanges for filings and any new investor presentation since then, file what you find, and tell me what changed."
    },
    "account_search": {
      "title": "Company context",
      "description": "Pick the companies this conversation is about — the agent grounds itself in their filings and record.",
      "placeholder": "Search companies…",
      "empty": "No companies found.",
      "pill_empty": "Set the company context for this chat"
    }
  },
  "dataroom": {
    "root_label": "Research Room",
    "domains": {
      "Customers": {
        "label": "Companies",
        "description": "One folder per covered company: its SEBI LODR filings, investor presentations and concalls, and the KPI tables built from them.",
        "visible": true
      },
      "People": {
        "label": "People",
        "description": "Management and investor-relations contacts at covered companies.",
        "visible": true
