{
  "$comment": "Vendored workflow engine: generated by scripts/sync-workflow-engine.mjs, never edited by hand. Source, commit and local patches: lib/workflow-engine/UPSTREAM.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:workflow-engine:dsl:v2",
  "title": "Workflow DSL v2",
  "description": "A deterministic workflow definition. Organization and attached-object identity are registration/runtime metadata, not part of the reusable DSL document.",
  "type": "object",
  "required": ["init", "diff"],
  "properties": {
    "_notes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "_feasibility_notes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "user_attributes": {
      "type": "array",
      "description": "The user attributes this workflow's directory queries may filter on, each with its valid options. The platform offers the options as a drop-down on the user account and sends the chosen value with the user. When declared, a directory query may name only these and the platform attributes (semantic validator).",
      "items": { "$ref": "#/$defs/userAttribute" }
    },
    "init": { "$ref": "#/$defs/initBlock" },
    "diff": {
      "type": "array",
      "items": { "$ref": "#/$defs/diffRule" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "userAttribute": {
      "type": "object",
      "required": ["key"],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "description": "Field name on the directory user, as queries spell it."
        },
        "type": {
          "enum": ["choice", "multi_choice", "boolean", "text"],
          "description": "How a person's value is held and compared. choice (default): one of options; multi_choice: any of options; boolean; text. Only the two choice types take options, and they need them (semantic validator). A number range is a choice whose options are the bands, e.g. \"5-10L\"."
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      },
      "additionalProperties": false
    },
    "stepState": {
      "enum": ["open", "completed", "rejected", "escalated"]
    },
    "mongoExpression": {
      "type": "object",
      "description": "A MongoDB-style expression. Supported operators are checked by the semantic validator.",
      "additionalProperties": true
    },
    "delta": {
      "type": "object",
      "properties": {
        "days": { "type": "number" },
        "hours": { "type": "number" },
        "minutes": { "type": "number" }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "orResolution": {
      "type": "object",
      "required": ["$or"],
      "properties": {
        "$or": {
          "type": "object",
          "properties": {
            "prompt": { "$ref": "#/$defs/nonEmptyString" },
            "query": { "$ref": "#/$defs/mongoExpression" }
          },
          "minProperties": 1,
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "requirement": {
      "type": "object",
      "required": ["default"],
      "properties": {
        "default": { "type": "boolean" },
        "evaluation_criterion": { "type": "string" },
        "condition": { "$ref": "#/$defs/orResolution" },
        "required_on": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stepState" }
        }
      },
      "additionalProperties": false
    },
    "relativeAssignee": {
      "type": "object",
      "description": "Walk the reporting matrix from an anchor. Exactly one of from_step (another step's holders) or from_query (a directory query, which may carry {\"$object\": \"<path>\"} tokens read from the attached object's data).",
      "oneOf": [
        {
          "properties": { "from_step": { "$ref": "#/$defs/nonEmptyString" } },
          "required": ["from_step"]
        },
        {
          "properties": { "from_query": { "$ref": "#/$defs/mongoExpression" } },
          "required": ["from_query"]
        }
      ],
      "properties": {
        "from_step": { "$ref": "#/$defs/nonEmptyString" },
        "from_query": { "$ref": "#/$defs/mongoExpression" },
        "direction": { "enum": ["up", "down"] },
        "levels": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "assignee": {
      "type": "object",
      "required": ["condition"],
      "properties": {
        "limit": { "type": "integer", "minimum": 1 },
        "condition": { "$ref": "#/$defs/orResolution" },
        "require_active": { "type": "boolean" },
        "strategy": { "enum": ["first", "least_loaded", "round_robin"] },
        "reresolve_on": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stepState" }
        },
        "relative": { "$ref": "#/$defs/relativeAssignee" }
      },
      "additionalProperties": false
    },
    "stepTemplate": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "description": { "type": "string" },
        "due_on": {
          "type": "object",
          "required": ["$delta"],
          "properties": {
            "$delta": { "$ref": "#/$defs/delta" }
          },
          "additionalProperties": false
        },
        "due_on_extension": {
          "type": "object",
          "properties": {
            "max_days": { "type": "number", "exclusiveMinimum": 0 },
            "window_days": { "type": "number", "minimum": 0 },
            "once": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "evidence_required": { "$ref": "#/$defs/requirement" },
        "status": {
          "type": "object",
          "required": ["default"],
          "properties": {
            "default": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "state": {
          "type": "object",
          "required": ["default"],
          "properties": {
            "default": { "$ref": "#/$defs/stepState" }
          },
          "additionalProperties": false
        },
        "comments_required": { "$ref": "#/$defs/requirement" },
        "ai_review": {
          "type": "boolean",
          "description": "Flags the step for AI review of what is submitted on it (evidence against evaluation_criterion). Advisory: the engine stores it and draws it; it gates nothing."
        },
        "completed_on_delta": {
          "type": "object",
          "required": ["default"],
          "properties": {
            "default": { "type": "number", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "evidence": {
          "type": "object",
          "description": "Evidence the step starts with: a record migrated from elsewhere. Recorded as added by the step's first holder unless an actor is given.",
          "required": ["default"],
          "properties": {
            "default": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["ref"],
                "properties": {
                  "ref": { "$ref": "#/$defs/nonEmptyString" },
                  "at": { "$ref": "#/$defs/nonEmptyString" },
                  "actor": { "$ref": "#/$defs/nonEmptyString" }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "completed_at": {
          "type": "object",
          "description": "When a step that starts completed was completed (a migrated record). Only with state.default completed.",
          "required": ["default"],
          "properties": {
            "default": { "$ref": "#/$defs/nonEmptyString" }
          },
          "additionalProperties": false
        },
        "assignee": { "$ref": "#/$defs/assignee" },
        "changes": {
          "type": "array",
          "items": { "type": "object" }
        }
      },
      "additionalProperties": false
    },
    "transitionMatrix": {
      "type": "object",
      "properties": {
        "open": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stepState" }
        },
        "completed": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stepState" }
        },
        "rejected": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stepState" }
        },
        "escalated": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stepState" }
        }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "guard": {
      "type": "object",
      "required": ["selector", "all"],
      "properties": {
        "selector": { "$ref": "#/$defs/mongoExpression" },
        "all": { "$ref": "#/$defs/mongoExpression" },
        "min_matching": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "initBlock": {
      "type": "object",
      "required": ["start_id", "steps"],
      "properties": {
        "condition": { "$ref": "#/$defs/mongoExpression" },
        "apply": {
          "type": "object",
          "required": ["default"],
          "properties": {
            "default": { "$ref": "#/$defs/mongoExpression" }
          },
          "additionalProperties": false
        },
        "start_id": { "$ref": "#/$defs/nonEmptyString" },
        "flatten_order": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "transitions": { "$ref": "#/$defs/transitionMatrix" },
        "terminal_when": { "$ref": "#/$defs/guard" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/stepTemplate" }
        }
      },
      "additionalProperties": false
    },
    "selector": {
      "type": "object",
      "required": ["rule"],
      "properties": {
        "rule": { "enum": ["forAll", "first", "firstN", "group", "single"] },
        "n": { "type": "integer", "minimum": 1 },
        "group_selector": { "$ref": "#/$defs/mongoExpression" }
      },
      "allOf": [
        {
          "if": { "properties": { "rule": { "const": "firstN" } }, "required": ["rule"] },
          "then": {
            "properties": { "n": { "type": "integer", "minimum": 1 } },
            "required": ["n"]
          }
        },
        {
          "if": { "properties": { "rule": { "enum": ["group", "single"] } }, "required": ["rule"] },
          "then": {
            "properties": { "group_selector": { "$ref": "#/$defs/mongoExpression" } },
            "required": ["group_selector"]
          }
        }
      ],
      "additionalProperties": false
    },
    "stepCondition": {
      "oneOf": [
        {
          "type": "object",
          "required": ["$condn"],
          "properties": {
            "$condn": { "$ref": "#/$defs/mongoExpression" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["$delta"],
          "properties": {
            "$delta": {
              "type": "object",
              "required": ["before", "after"],
              "properties": {
                "before": true,
                "after": true
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "setExpression": {
      "type": "object",
      "properties": {
        "$condn": { "$ref": "#/$defs/mongoExpression" },
        "prompt": { "type": "string" },
        "value": true
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "internalAction": {
      "type": "object",
      "required": ["scope", "set"],
      "properties": {
        "scope": { "enum": ["self", "other"] },
        "other_selector": { "$ref": "#/$defs/mongoExpression" },
        "set": {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "status": { "$ref": "#/$defs/setExpression" },
            "state": { "$ref": "#/$defs/setExpression" },
            "completed_at": { "$ref": "#/$defs/setExpression" },
            "due_on": { "$ref": "#/$defs/setExpression" },
            "assignee": { "$ref": "#/$defs/setExpression" },
            "completed_on_delta": { "$ref": "#/$defs/setExpression" }
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": { "properties": { "scope": { "const": "other" } }, "required": ["scope"] },
          "then": {
            "properties": { "other_selector": { "$ref": "#/$defs/mongoExpression" } },
            "required": ["other_selector"]
          }
        }
      ],
      "additionalProperties": false
    },
    "emailAction": {
      "type": "object",
      "required": ["recipients"],
      "properties": {
        "recipients": { "$ref": "#/$defs/orResolution" },
        "subject": { "$ref": "#/$defs/setExpression" },
        "body": { "$ref": "#/$defs/setExpression" },
        "attachments": {
          "type": "object",
          "properties": {
            "$generate": { "type": "string" },
            "$search": { "type": "string" }
          },
          "minProperties": 1,
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "agentAction": {
      "type": "object",
      "required": ["_id", "name", "prompt"],
      "properties": {
        "_id": { "$ref": "#/$defs/nonEmptyString" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "prompt": { "$ref": "#/$defs/nonEmptyString" },
        "state": true
      },
      "additionalProperties": false
    },
    "externalAction": {
      "type": "object",
      "properties": {
        "email": { "$ref": "#/$defs/emailAction" },
        "agent": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/agentAction" }
        }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "cohortGuard": {
      "type": "object",
      "required": ["join_on", "steps", "all"],
      "properties": {
        "join_on": { "$ref": "#/$defs/nonEmptyString" },
        "instances": { "$ref": "#/$defs/mongoExpression" },
        "steps": { "$ref": "#/$defs/mongoExpression" },
        "all": { "$ref": "#/$defs/mongoExpression" },
        "min_matching": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "diffRule": {
      "type": "object",
      "required": ["priority", "applicability", "selector", "condition", "action"],
      "properties": {
        "priority": { "type": "number" },
        "applicability": { "enum": ["all", "query"] },
        "applicability_query": { "$ref": "#/$defs/setExpression" },
        "selector": { "$ref": "#/$defs/selector" },
        "condition": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/stepCondition" }
        },
        "guard": { "$ref": "#/$defs/guard" },
        "cohort_guard": { "$ref": "#/$defs/cohortGuard" },
        "once": { "type": "boolean" },
        "action": {
          "type": "object",
          "properties": {
            "internal": { "$ref": "#/$defs/internalAction" },
            "external": { "$ref": "#/$defs/externalAction" }
          },
          "minProperties": 1,
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": { "properties": { "applicability": { "const": "query" } }, "required": ["applicability"] },
          "then": {
            "properties": { "applicability_query": { "$ref": "#/$defs/setExpression" } },
            "required": ["applicability_query"]
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
