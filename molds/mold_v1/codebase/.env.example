# Delivered — environment reference
#
# Copy to .env.local and fill in what you need. NOTHING here is a real value.
#
# Vercel is the source of truth for deployed environments; this file documents
# what exists and what it does. Two caveats worth knowing before you rely on it:
#
#   * `vercel env pull` returns an EMPTY STRING for variables marked Sensitive.
#     That is fine for a remote build, but it silently breaks a local
#     `vercel build --prebuilt` — NEXT_PUBLIC_* get inlined as "" and the app
#     boots misconfigured. Source those from .env.local locally.
#   * A trailing newline in a value is not trimmed by every consumer. One got
#     into MODEL_PROVIDER and the whole fleet ran (and billed) the wrong
#     provider for weeks. Use `printf %s "$(...)" | vercel env add NAME env`.


# ─────────────────────────────────────────────────────────────────────────────
# CAPABILITY FLAGS — remove a capability from a deployment
# ─────────────────────────────────────────────────────────────────────────────
# Both DEFAULT ON: unset behaves exactly as before. Only an explicit
# false/0/off/no disables. Fail-open is deliberate here — the failure mode is a
# missing capability, not an open door (contrast CRON_SECRET below, which fails
# CLOSED because there the failure mode is an unauthenticated endpoint).
#
# READ AT BUILD TIME. These export eve's `disableTool()` sentinel, so the tool
# is never registered and — per eve's docs — "the model never sees it". That is
# stronger than refusing at call time, which still burns context and can be
# argued with. The trade: flipping one needs a rebuild + redeploy, not just an
# env change.

# Removes `web_search` (Exa). Gated in FOUR places — the root agent plus the
# research, app-author and customer-context subagents — because gating only the
# root leaves those three with full web access while the flag reads "off".
ENABLE_WEB_SEARCH=true

# Removes the browser subagent's 8 tools (open/goto/read/screenshot/act/login/
# wait/close). With all 8 gone the subagent has nothing to call.
ENABLE_BROWSER=true

# Removes `read_image`, the vision TOOL (agent/lib/vision-tools.ts). Setting
# CLOUDFLARE_MODEL_VISION=off removes it the same way, for a deployment on an
# account with no vision model: a present tool that cannot work is worse than an
# absent one, because the model keeps calling it.
ENABLE_VISION=true


# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — the app does not work without these
# ─────────────────────────────────────────────────────────────────────────────

# Postgres (Supabase). MUST point at the `app_rw` role, NOT the admin/postgres
# user: app_rw is NOBYPASSRLS, and a role that bypasses RLS silently disables
# every tenant-isolation policy while everything appears to work. /api/ops/health
# reports the connected role for exactly this reason.
# There is deliberately NO POSTGRES_URL fallback — a missing value fails loudly.
DATABASE_URL=postgres://app_rw.<project-ref>:<password>@<host>:6543/postgres

# MIGRATION SCRIPTS ONLY (db:migrate:production, db:migrate:task-workflows). They
# require TLS. "disable" turns it off for a Postgres on THIS machine (localhost,
# 127.x.x.x, ::1, a unix socket) and is refused for any other host. Unset =
# "require". See docs/self-hosting/DATABASE_AND_AGENT_URL.md.
DATABASE_SSL=

# Guards /api/cron/* and /api/ops/run. FAILS CLOSED: if unset, those endpoints
# return 503 rather than running unauthenticated.
CRON_SECRET=

# Encrypts connector secrets at rest (AES-256-GCM, per-workspace HKDF).
# 32 bytes: `openssl rand -base64 32`. Losing it makes stored secrets
# unrecoverable. Rotate by adding the next version and leaving the old in place:
#   OPS_SECRETS_KEY_V2, _V3, … — the highest present version is used for new
#   writes, older ones stay readable. (Read dynamically, so a grep for
#   OPS_SECRETS_KEY_V2 finds nothing — it is constructed at runtime.)
OPS_SECRETS_KEY=

# Google sign-in. The NEXT_PUBLIC_ copy is inlined into the client bundle at
# BUILD time — see the vercel env pull caveat above.
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# The file store — the data room and published artifacts live here.
#
# Vercel Blob by default: leave STORAGE_DRIVER unset and set the store's token. Nothing else in this block is read.
BLOB_READ_WRITE_TOKEN=

# A deployment that is NOT on Vercel selects another store (docs/STORAGE.md). The web app and the agent API are two
# processes: give BOTH the same values. A selected driver that is missing a setting is an error (the health check at
# /api/ops/health says which), never a silent fall back to another store.
#
#   vercel-blob   (default when unset)  BLOB_READ_WRITE_TOKEN above
#   filesystem    a directory on the server's own disk
#   s3            any S3-compatible bucket (DigitalOcean Spaces, MinIO)
STORAGE_DRIVER=

# filesystem: an absolute directory, writable by the service user only, on a disk that is backed up. Nothing serves
# it: files leave through the app's own routes. Not DATAROOM_DIR (that is a developer's scratch tree, used only when
# no store is configured at all).
STORAGE_FS_ROOT=
# filesystem: 1 only when the web app and the agent API run as two different users that share STORAGE_FS_ROOT. Folders
# become 2770 and files 0660 (one group, nobody else) instead of 0700 and 0600, and the root is refused unless it is
# mode 2770 in a group made for the files with both users in it. Set it for BOTH services. docs/STORAGE.md,
# "Two service users sharing the directory". Unset: one user, as before.
STORAGE_FS_GROUP_SHARED=
# filesystem: signs the app's own expiring file links (what a presigned URL is on Vercel Blob). 32+ characters:
# `openssl rand -base64 48`. Rotating it invalidates every link already handed out (the console asks for fresh ones).
STORAGE_SIGNING_SECRET=
# filesystem: the web app's public https address, where a signed file link points. Falls back to WEB_ORIGIN.
STORAGE_PUBLIC_URL=

# s3: endpoint (https://<region>.digitaloceanspaces.com, or a MinIO address), a PRIVATE bucket, and a key pair that
# can read and write it. Region defaults to us-east-1 (what Spaces and MinIO expect). Addressing is `path`
# (<endpoint>/<bucket>/<key>, the default) or `virtual` (<bucket>.<endpoint>/<key>).
STORAGE_S3_ENDPOINT=
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_ADDRESSING=
# s3 only, BUILD time: the host name signed links are served from (the endpoint's host for `path`, <bucket>.<host>
# for `virtual`), so the browser can tell a link to one of our files from a link to another site.
NEXT_PUBLIC_STORAGE_HOST=

# Where the front-end reaches the eve agent.
NEXT_PUBLIC_EVE_API_URL=https://fde-agent-api.vercel.app
# OFF VERCEL THIS IS REQUIRED: a production build or server that is not on
# Vercel refuses to build or start without it, instead of proxying chat to the
# agent above. On Vercel, in `next dev` and in a CI build, leaving it unset
# still falls back to that agent. EVE_API_URL is optional; if set, it must be
# the same address. EVE_API_URL_OPTIONAL=1 marks a hand-made test build that
# talks to no agent.
EVE_API_URL=
WEB_ORIGIN=https://fde-agent.vercel.app


# ─────────────────────────────────────────────────────────────────────────────
# MODEL PROVIDER
# ─────────────────────────────────────────────────────────────────────────────
# "cloudflare" (default) or "gateway". Values are trimmed before matching —
# a trailing newline here once sent the whole fleet to the wrong provider.
MODEL_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/zai-org/glm-5.2
# Optional, tiered by role like the gateway; ORCHESTRATOR and SPECIALIST each fall back to CLOUDFLARE_MODEL.
#   ORCHESTRATOR talks to the person. It NO LONGER has to be a vision model: images go to the vision role
#   below, through the `read_image` tool. Pick it for reasoning and reliability, e.g. @cf/zai-org/glm-5.3.
#   SPECIALIST runs the delegated text-heavy work, e.g. @cf/zai-org/glm-5.3 (1.31M-token window).
#   VISION is the model behind `read_image`, called once per image instead of on every turn. Default
#   @cf/zai-org/glm-5.3-flash (reads images; reasoning levels low/high/max; $0.15/M in, $0.50/M out;
#   needs Workers Paid, which an account running @cf/zai-org/glm-5.3 already has). Set it to
#   @cf/moonshotai/kimi-k2.6 to go back to the previous default. It deliberately does NOT fall back to
#   CLOUDFLARE_MODEL: that names the text-only fleet model, which does not error on an image — it answers
#   "I cannot see the image", and a wrong answer is worse than a missing capability. "off"/"none"/"false"
#   removes the tool entirely; EMPTY means unset (a Vercel Sensitive variable pulls down as an empty string,
#   and that must not delete a capability).
CLOUDFLARE_MODEL_ORCHESTRATOR=
CLOUDFLARE_MODEL_SPECIALIST=
CLOUDFLARE_MODEL_VISION=
CLOUDFLARE_BASE_URL=
# Override only for a model whose window this app does not know (agent/lib/model.ts). Per role:
# CLOUDFLARE_CONTEXT_WINDOW_ORCHESTRATOR / CLOUDFLARE_CONTEXT_WINDOW_SPECIALIST; both fall back to this one.
CLOUDFLARE_CONTEXT_WINDOW=

# THE PER-CALL OUTPUT BUDGET, PER ROLE — how many tokens ONE call may produce.
# Not the context window above (how much it may READ), and on a reasoning model
# not "how long the answer may be" either: the budget pays for the THINKING
# first and the answer out of what is left. On 2026-09-23 the vision call ran on
# 1,500 tokens and the live row read `finish=length out=1500 out_thinking=1500` —
# the whole budget spent thinking about one scanned page, nothing delivered, and
# `read_image` reporting "returned no text" on a page it could have read.
#
# Defaults 8192 / 16384 / 16384 (orchestrator / specialist / vision). Probed on
# this account: max_tokens 256 reproduces the failure exactly, 8192 and 16384 are
# accepted and answer normally. Why each number is that number and what it
# trades: agent/lib/model-output-budget.ts.
#
# UNPREFIXED, unlike the CLOUDFLARE_* variables above, because a budget is a
# property of the role's JOB rather than of a provider's model — the same three
# numbers are right on either provider.
#
# EMPTY means unset, i.e. the default — NOT "off". A Vercel variable marked
# Sensitive pulls down as an empty string and that must never silently change
# behaviour. "off"/"none"/"false"/"disabled"/"0" sends no budget at all (the
# pre-fix behaviour, and the escape hatch for a provider that rejects
# max_tokens); anything that is not a positive whole number is ignored, loudly.
MODEL_MAX_OUTPUT_TOKENS_ORCHESTRATOR=
MODEL_MAX_OUTPUT_TOKENS_SPECIALIST=
MODEL_MAX_OUTPUT_TOKENS_VISION=
# Reasoning effort for the root agent on Workers AI: minimal|low|medium|high|xhigh.
# EMPTY = unset (the provider's default, which on GLM 5.3 reasons at length).
# "low" cut GLM 5.3's reasoning roughly five-fold in a 2026-09-24 probe; Kimi
# K2.6 ignores it. Set it per deployment once its answers are checked.
CLOUDFLARE_REASONING_EFFORT=
# Reasoning effort `read_image` asks the vision model for: minimal|low|medium|high|xhigh, or
# "off"/"none" to send no field. EMPTY = unset = "low" (reading a page is transcription; GLM 5.3
# Flash otherwise reasons at "max" and spends the output budget thinking before it answers).
# GLM 5.3 Flash documents only low/high/max; a level it refuses is dropped by the retry below.
# Unprefixed like MODEL_MAX_OUTPUT_TOKENS_VISION, and on either provider it is sent ONLY to a model
# on the reasoning allow-list (agent/lib/empty-model-response.ts, RECOVERY_REASONING_MODELS); a
# provider that answers 4xx naming the field gets the same call once more without it.
MODEL_REASONING_VISION=
# Only when MODEL_PROVIDER=gateway — explicit opt-in, never auto-selected.
GATEWAY_MODEL_ORCHESTRATOR=
GATEWAY_MODEL_SPECIALIST=
GATEWAY_REASONING_EFFORT=


# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL CAPABILITIES — absent means the feature is simply unavailable
# ─────────────────────────────────────────────────────────────────────────────

# Web search. Without it, web_search is present but cannot return results —
# use ENABLE_WEB_SEARCH=false to remove the tool entirely instead.
EXA_API_KEY=

# Browser runtime (Browserbase). Key only; no project id.
BROWSERBASE_API_KEY=
BROWSER_LOCAL=
BROWSER_ALLOWED_ORIGINS=
# Concurrent real-browser sessions. Default 3 — the Browserbase plan's OWN
# concurrent limit (it also allows 5 new sessions per minute). Setting this
# HIGHER does not buy concurrency, it just moves the rejection to the provider:
# a six-way fan-out produced five 429s and six subagents waiting on sessions
# that were never going to open. Raise the plan first, then this.
BROWSER_MAX_SESSIONS=
# Remote browser viewport. Defaults 1280x800 (16:10). Set these to match the
# ASPECT RATIO of the panel the live view is embedded in — unset, Browserbase
# picks its own and the embed arrives letterboxed with sites laying out for a
# viewport nobody is looking at. Width matters for which layout a site serves
# (drop below ~1024 and many switch to tablet/mobile), so prefer changing the
# ratio via height.
BROWSER_VIEWPORT_WIDTH=
BROWSER_VIEWPORT_HEIGHT=
BROWSER_SESSION_IDLE_MS=
BROWSER_SESSION_TIMEOUT=

# THE SANDBOX, OFF VERCEL ONLY (docs/self-hosting/SANDBOX.md). On Vercel leave all
# four unset: eve runs sandboxes on Vercel Sandbox, as it always has.
# READ AT BUILD TIME as well as at run time (the research prompt names a path
# that depends on the backend): build and run with the same values.
#   SANDBOX_BACKEND       unset or "vercel" = today's behaviour. "microsandbox" =
#                         a KVM microVM on this host (needs /dev/kvm), with the
#                         network deny list (cloud metadata, private ranges,
#                         loopback). Any other value stops the build.
#   SANDBOX_CPUS          virtual CPUs per sandbox, microsandbox only. Default 2.
#   SANDBOX_MEMORY_MIB    memory per sandbox in MiB, microsandbox only. Default 1024.
#   SANDBOX_DENY_SUBNETS  extra addresses/CIDRs to block, comma or space separated.
#                         Not the web app's own public address when the data room
#                         uses STORAGE_DRIVER=filesystem: sandboxes download its
#                         file links from there (checked by build and prewarm).
SANDBOX_BACKEND=
SANDBOX_CPUS=
SANDBOX_MEMORY_MIB=
SANDBOX_DENY_SUBNETS=

# Outbound mail (invites, notifications).
#
# REQUIRED for email sign-in below: the one-time code has no other delivery
# path (deliberately — a credential is not posted into Slack).
RESEND_API_KEY=
PLATFORM_NOTIFY_FROM=

# ---------------------------------------------------------------------------
# Email sign-in (the second door, for people Google cannot vouch for)
# ---------------------------------------------------------------------------
# Without these, sign-in is Google-only and an invite to a gmail.com address —
# or any address on a domain with no Google Workspace — is created, emailed and
# then refused at the gate. With them, that invitee gets a code and a session.
#
# ES256 (P-256), so the key that VERIFIES is not the key that can FORGE. Three
# places verify (the Next proxy on the Edge, the ops routes, and the eve agent
# in a separate Vercel project); only the web project's two mint routes sign.
#
#   AUTH_JWT_PRIVATE_KEY   PKCS8 PEM. WEB PROJECT ONLY — never on the agent.
#   AUTH_JWT_PUBLIC_KEY    SPKI PEM. BOTH projects (web + fde-agent-api).
#
# Either raw PEM or base64-of-PEM is accepted. Prefer base64: a PEM is
# multi-line, and this deployment has already been bitten once by an env var
# whose whitespace silently changed behaviour.
#
# Generate:
#   node -e 'const{generateKeyPairSync}=require("crypto");const{publicKey:a,privateKey:b}=generateKeyPairSync("ec",{namedCurve:"P-256"});console.log("PRIVATE:",Buffer.from(b.export({type:"pkcs8",format:"pem"})).toString("base64"));console.log("PUBLIC:",Buffer.from(a.export({type:"spki",format:"pem"})).toString("base64"))'
#
# Rotating them invalidates every live email session (people sign in again).
# Codes themselves are hashed with OPS_SECRETS_KEY, so that must also be set.
#
# GUESTS of a shared chat (someone outside its workspace) sign in from the
# chat's link with an emailed code OR with Google (app/api/auth/guest/google).
# Both doors end in the same email session, so BOTH need these keys, plus
# RESEND_API_KEY + PLATFORM_NOTIFY_FROM for the code. For the Google door to
# admit an outside guest's Google account, the OAuth client behind
# NEXT_PUBLIC_GOOGLE_CLIENT_ID must belong to a project whose consent screen is
# External and In production (an Internal one admits only its own company).
AUTH_JWT_PRIVATE_KEY=
AUTH_JWT_PUBLIC_KEY=

# Inbound mail. DRAFT-ONLY by design: the agent composes drafts into IMAP and
# never sends. Platform/org notifications above are the only sending path.
#
# NOT USED BY INBOX INGESTION. The Inbox reads IMAP_* from each workspace's own
# `gmail` connector (encrypted per-workspace in connector_secrets), because a
# platform-level mailbox would mean every workspace ingesting the same inbox.
# These remain for the agent's own draft path and for single-tenant dev.
IMAP_HOST=
IMAP_PORT=
IMAP_SECURE=
IMAP_USER=
IMAP_PASSWORD=
IMAP_DRAFTS_MAILBOX=

# Connectors.
# A GitHub credential here is server-wide. It is used only for the one workspace named by CONNECTIONS_WORKSPACE
# (set it even when there is a single workspace); otherwise each workspace stores its own in the Ops Center
# (docs/self-hosting/CONNECTORS.md).
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_MCP_URL=
SLACK_BOT_TOKEN=
SLACK_MCP_URL=
SLACK_TEAM_CHANNEL_ID=
GRANOLA_API_KEY=
GRANOLA_API_URL=
PAGERDUTY_API_TOKEN=
PAGERDUTY_ROUTING_KEY=

# Durable task-workflow service.
TASK_WORKFLOW_SERVICE_URL=
TASK_WORKFLOW_SERVICE_TOKEN=


# ─────────────────────────────────────────────────────────────────────────────
# DESKTOP NOTIFICATIONS (Web Push) — optional
# ─────────────────────────────────────────────────────────────────────────────
# "Desktop notifications" (the bell beside the account) tells a person when a
# reply is ready, the agent needs their answer, or a turn failed — even with
# the tab in the background or closed. The browser needs a VAPID key pair to
# accept pushes from this server. Unset (any of the three): the bell says
# "not available here yet" and nothing else changes.
#
# Set ALL THREE on BOTH projects (web and agent): the web app hands the public
# key to the browser; the agent's hook (agent/hooks/notifications.ts) signs and
# sends. Generate a pair once and keep it: a new pair silently orphans every
# device that already subscribed (they turn notifications on again).
#   node -e 'import("./agent/lib/web-push.ts").then(m=>console.log(m.generateVapidKeys()))' --experimental-strip-types
#   VAPID_PUBLIC_KEY    base64url, 65-byte uncompressed P-256 point.
#   VAPID_PRIVATE_KEY   base64url, the 32-byte private scalar. Sensitive.
#   VAPID_SUBJECT       mailto:someone@your-domain (or an https: URL) — who
#                       the push services may contact about this sender.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ─────────────────────────────────────────────────────────────────────────────
# QUEUED CHAT MESSAGES — no new variables
# ─────────────────────────────────────────────────────────────────────────────
# Messages typed while the agent is working are held on the server
# (chat_queue_items, migration 0021) and sent when the chat comes to rest, even
# after the tab is closed. That uses what is already here:
#   - CRON_SECRET, on BOTH projects: the agent signs its "this chat is at rest"
#     nudge to the web app (POST /api/chat-queue/nudge) with it, and the web
#     app refuses any nudge not signed with it; /api/cron/deliver-queued (the
#     once-a-minute sweep) is guarded by it like every cron;
#   - WEB_ORIGIN (above), where the agent sends that nudge;
#   - AUTH_JWT_PRIVATE_KEY (above, web): to send as the person with no tab
#     open, the web app signs a QUEUE-DELIVERY token — two minutes, one chat
#     session, accepted only by the agent (with AUTH_JWT_PUBLIC_KEY) on that
#     session's routes, never a sign-in anywhere. Without it, queued messages
#     are sent only while one of that person's tabs is open.

# ─────────────────────────────────────────────────────────────────────────────
# TENANCY / MISC
# ─────────────────────────────────────────────────────────────────────────────
OPS_MULTI_TENANT=
# Ship the CSP as Report-Only instead of enforcing — for testing a policy
# change without breaking the app. Leave unset in production.
CSP_REPORT_ONLY=
# Overrides the model used for summarisation only.
SUMMARY_MODEL=
DATAROOM_DIR=
# Build time only. `npm run check:dataroom-folders` (run before every build) looks at the data room this build is
# configured for and stops the build if it holds files under a folder name the deployment profile does not use
# (docs/DEPLOYMENT_PROFILE.md, "Stored folder names"). Set to `skip` for a build that cannot reach its store on
# purpose; writes stay guarded at run time. Leave unset otherwise.
DATAROOM_FOLDERS_CHECK=
# An EXTRA Google OAuth audience to admit, for rotating the CLI/desktop client
# without a code change. Read by lib/ops-auth.ts and agent/channels/eve.ts, which
# must agree. Was FDE_CLI_CLIENT_ID: that name is still read, with a warning.
WORKSPACE_CLI_CLIENT_ID=
# Where `npx skills add` points, if you self-host the skill catalogue.
DELIVERED_SKILL_INSTALL=

# Test-only. Injects a people fixture so the workbook People sheets are
# testable; with no database there are no people unless a local demo loads the
# sample. Never set in production.
# Was FDE_PEOPLE_SEED; the old name is still read, with a warning.
WORKSPACE_PEOPLE_SEED=

# LOCAL DEMO ONLY. With no database, start the in-memory system of record (and
# the data room's previews) from two INVENTED sample accounts and their people
# (data/sample/*.json, agent/lib/sample-data.ts). Unset, a workspace with no
# database is empty. Never set on a deployment: a real workspace shows only its
# own records. DEMO_SAMPLE_DATA_DIR reads the sample from another directory.
DEMO_SAMPLE_DATA=
DEMO_SAMPLE_DATA_DIR=
