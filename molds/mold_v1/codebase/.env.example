# Delivered — environment reference
#
# Copy to .env.local and fill in what you need. NOTHING here is a real value.
#
# Vercel is the source of truth for deployed environments; this file documents
# what exists and what it does. Two caveats worth knowing before you rely on it:
#
#   * `vercel env pull` returns an EMPTY STRING for variables marked Sensitive.
#     That is fine for a remote build, but it silently breaks a local
#     `vercel build --prebuilt` — NEXT_PUBLIC_* get inlined as "" and the app
#     boots misconfigured. Source those from .env.local locally.
#   * A trailing newline in a value is not trimmed by every consumer. One got
#     into MODEL_PROVIDER and the whole fleet ran (and billed) the wrong
#     provider for weeks. Use `printf %s "$(...)" | vercel env add NAME env`.


# ─────────────────────────────────────────────────────────────────────────────
# CAPABILITY FLAGS — remove a capability from a deployment
# ─────────────────────────────────────────────────────────────────────────────
# Both DEFAULT ON: unset behaves exactly as before. Only an explicit
# false/0/off/no disables. Fail-open is deliberate here — the failure mode is a
# missing capability, not an open door (contrast CRON_SECRET below, which fails
# CLOSED because there the failure mode is an unauthenticated endpoint).
#
# READ AT BUILD TIME. These export eve's `disableTool()` sentinel, so the tool
# is never registered and — per eve's docs — "the model never sees it". That is
# stronger than refusing at call time, which still burns context and can be
# argued with. The trade: flipping one needs a rebuild + redeploy, not just an
# env change.

# Removes `web_search` (Exa). Gated in FOUR places — the root agent plus the
# research, app-author and customer-context subagents — because gating only the
# root leaves those three with full web access while the flag reads "off".
ENABLE_WEB_SEARCH=true

# Removes the browser subagent's 8 tools (open/goto/read/screenshot/act/login/
# wait/close). With all 8 gone the subagent has nothing to call.
ENABLE_BROWSER=true


# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — the app does not work without these
# ─────────────────────────────────────────────────────────────────────────────

# Postgres (Supabase). MUST point at the `app_rw` role, NOT the admin/postgres
# user: app_rw is NOBYPASSRLS, and a role that bypasses RLS silently disables
# every tenant-isolation policy while everything appears to work. /api/ops/health
# reports the connected role for exactly this reason.
# There is deliberately NO POSTGRES_URL fallback — a missing value fails loudly.
DATABASE_URL=postgres://app_rw.<project-ref>:<password>@<host>:6543/postgres

# Guards /api/cron/* and /api/ops/run. FAILS CLOSED: if unset, those endpoints
# return 503 rather than running unauthenticated.
CRON_SECRET=

# Encrypts connector secrets at rest (AES-256-GCM, per-workspace HKDF).
# 32 bytes: `openssl rand -base64 32`. Losing it makes stored secrets
# unrecoverable. Rotate by adding the next version and leaving the old in place:
#   OPS_SECRETS_KEY_V2, _V3, … — the highest present version is used for new
#   writes, older ones stay readable. (Read dynamically, so a grep for
#   OPS_SECRETS_KEY_V2 finds nothing — it is constructed at runtime.)
OPS_SECRETS_KEY=

# Google sign-in. The NEXT_PUBLIC_ copy is inlined into the client bundle at
# BUILD time — see the vercel env pull caveat above.
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Vercel Blob — the data room lives here.
BLOB_READ_WRITE_TOKEN=

# Where the front-end reaches the eve agent.
NEXT_PUBLIC_EVE_API_URL=https://fde-agent-api.vercel.app
WEB_ORIGIN=https://fde-agent.vercel.app


# ─────────────────────────────────────────────────────────────────────────────
# MODEL PROVIDER
# ─────────────────────────────────────────────────────────────────────────────
# "cloudflare" (default) or "gateway". Values are trimmed before matching —
# a trailing newline here once sent the whole fleet to the wrong provider.
MODEL_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/zai-org/glm-5.2
# Optional, tiered by role like the gateway; each falls back to CLOUDFLARE_MODEL.
#   ORCHESTRATOR talks to the person. For native image input it must be a vision model (the chat sends images as
#   file parts), e.g. @cf/moonshotai/kimi-k2.6. A text-only model (GLM 5.2, GLM 5.3) answers "I cannot see it".
#   SPECIALIST runs the delegated text-heavy work, e.g. @cf/zai-org/glm-5.3 (1.31M-token window).
CLOUDFLARE_MODEL_ORCHESTRATOR=
CLOUDFLARE_MODEL_SPECIALIST=
CLOUDFLARE_BASE_URL=
# Override only for a model whose window this app does not know (agent/lib/model.ts). Per role:
# CLOUDFLARE_CONTEXT_WINDOW_ORCHESTRATOR / CLOUDFLARE_CONTEXT_WINDOW_SPECIALIST; both fall back to this one.
CLOUDFLARE_CONTEXT_WINDOW=
# Only when MODEL_PROVIDER=gateway — explicit opt-in, never auto-selected.
GATEWAY_MODEL_ORCHESTRATOR=
GATEWAY_MODEL_SPECIALIST=
GATEWAY_REASONING_EFFORT=


# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL CAPABILITIES — absent means the feature is simply unavailable
# ─────────────────────────────────────────────────────────────────────────────

# Web search. Without it, web_search is present but cannot return results —
# use ENABLE_WEB_SEARCH=false to remove the tool entirely instead.
EXA_API_KEY=

# Browser runtime (Browserbase). Key only; no project id.
BROWSERBASE_API_KEY=
BROWSER_LOCAL=
BROWSER_ALLOWED_ORIGINS=
# Concurrent real-browser sessions. Default 3 — the Browserbase plan's OWN
# concurrent limit (it also allows 5 new sessions per minute). Setting this
# HIGHER does not buy concurrency, it just moves the rejection to the provider:
# a six-way fan-out produced five 429s and six subagents waiting on sessions
# that were never going to open. Raise the plan first, then this.
BROWSER_MAX_SESSIONS=
# Remote browser viewport. Defaults 1280x800 (16:10). Set these to match the
# ASPECT RATIO of the panel the live view is embedded in — unset, Browserbase
# picks its own and the embed arrives letterboxed with sites laying out for a
# viewport nobody is looking at. Width matters for which layout a site serves
# (drop below ~1024 and many switch to tablet/mobile), so prefer changing the
# ratio via height.
BROWSER_VIEWPORT_WIDTH=
BROWSER_VIEWPORT_HEIGHT=
BROWSER_SESSION_IDLE_MS=
BROWSER_SESSION_TIMEOUT=

# Outbound mail (invites, notifications).
#
# REQUIRED for email sign-in below: the one-time code has no other delivery
# path (deliberately — a credential is not posted into Slack).
RESEND_API_KEY=
PLATFORM_NOTIFY_FROM=

# ---------------------------------------------------------------------------
# Email sign-in (the second door, for people Google cannot vouch for)
# ---------------------------------------------------------------------------
# Without these, sign-in is Google-only and an invite to a gmail.com address —
# or any address on a domain with no Google Workspace — is created, emailed and
# then refused at the gate. With them, that invitee gets a code and a session.
#
# ES256 (P-256), so the key that VERIFIES is not the key that can FORGE. Three
# places verify (the Next proxy on the Edge, the ops routes, and the eve agent
# in a separate Vercel project); only the web project's two mint routes sign.
#
#   AUTH_JWT_PRIVATE_KEY   PKCS8 PEM. WEB PROJECT ONLY — never on the agent.
#   AUTH_JWT_PUBLIC_KEY    SPKI PEM. BOTH projects (web + fde-agent-api).
#
# Either raw PEM or base64-of-PEM is accepted. Prefer base64: a PEM is
# multi-line, and this deployment has already been bitten once by an env var
# whose whitespace silently changed behaviour.
#
# Generate:
#   node -e 'const{generateKeyPairSync}=require("crypto");const{publicKey:a,privateKey:b}=generateKeyPairSync("ec",{namedCurve:"P-256"});console.log("PRIVATE:",Buffer.from(b.export({type:"pkcs8",format:"pem"})).toString("base64"));console.log("PUBLIC:",Buffer.from(a.export({type:"spki",format:"pem"})).toString("base64"))'
#
# Rotating them invalidates every live email session (people sign in again).
# Codes themselves are hashed with OPS_SECRETS_KEY, so that must also be set.
AUTH_JWT_PRIVATE_KEY=
AUTH_JWT_PUBLIC_KEY=

# Inbound mail. DRAFT-ONLY by design: the agent composes drafts into IMAP and
# never sends. Platform/org notifications above are the only sending path.
#
# NOT USED BY INBOX INGESTION. The Inbox reads IMAP_* from each workspace's own
# `gmail` connector (encrypted per-workspace in connector_secrets), because a
# platform-level mailbox would mean every workspace ingesting the same inbox.
# These remain for the agent's own draft path and for single-tenant dev.
IMAP_HOST=
IMAP_PORT=
IMAP_SECURE=
IMAP_USER=
IMAP_PASSWORD=
IMAP_DRAFTS_MAILBOX=

# Connectors.
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_MCP_URL=
SLACK_BOT_TOKEN=
SLACK_MCP_URL=
SLACK_TEAM_CHANNEL_ID=
GRANOLA_API_KEY=
GRANOLA_API_URL=
PAGERDUTY_API_TOKEN=
PAGERDUTY_ROUTING_KEY=

# Durable task-workflow service.
TASK_WORKFLOW_SERVICE_URL=
TASK_WORKFLOW_SERVICE_TOKEN=


# ─────────────────────────────────────────────────────────────────────────────
# TENANCY / MISC
# ─────────────────────────────────────────────────────────────────────────────
OPS_MULTI_TENANT=
# Ship the CSP as Report-Only instead of enforcing — for testing a policy
# change without breaking the app. Leave unset in production.
CSP_REPORT_ONLY=
# Overrides the model used for summarisation only.
SUMMARY_MODEL=
DATAROOM_DIR=
FDE_CLI_CLIENT_ID=
# Where `npx skills add` points, if you self-host the skill catalogue.
DELIVERED_SKILL_INSTALL=

# Test-only. Injects a people fixture so the workbook People sheets are
# testable; data/people.json ships empty on purpose. Never set in production.
FDE_PEOPLE_SEED=
