{
  "_notes": [
    "Five steps in a line: the maker scopes, collects and submits; a checker reviews; the department's lead signs off. Step 3 may send back to step 1; steps 4 and 5 send back to step 2, after which 3 and 4 run again. Every holder comes from the record's department."
  ],
  "user_attributes": [
    {
      "key": "duty",
      "options": [
        "maker",
        "checker"
      ]
    }
  ],
  "init": {
    "start_id": "s1_scope",
    "flatten_order": [
      "s1_scope",
      "s2_collect",
      "s3_submit",
      "s4_review",
      "s5_signoff"
    ],
    "transitions": {
      "open": [
        "completed",
        "rejected",
        "escalated"
      ],
      "completed": [
        "open"
      ],
      "rejected": [
        "open"
      ],
      "escalated": [
        "completed",
        "rejected",
        "open"
      ]
    },
    "terminal_when": {
      "selector": {
        "id": "s5_signoff"
      },
      "all": {
        "state": "completed"
      }
    },
    "steps": [
