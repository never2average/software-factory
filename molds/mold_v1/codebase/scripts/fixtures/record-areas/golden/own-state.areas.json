  "label": {
   "singular": "Work item",
   "plural": "Work items"
  },
  "description": "One row per piece of work for an account: what it is, where it stands and when it started.",
  "id": {
   "field": "deploymentId",
   "label": "Item id",
   "placeholder": "item-001"
  },
  "relations": {
   "account": {
    "required": true
   },
   "tasks": true
  },
  "icon": "file-text",
  "title": "{deployedVersion}",
  "lifecycle": {
   "field": "stage",
   "initial": "queued",
   "enforce": "warn",
   "categories": {
    "queued": "open",
    "working": "active",
    "finished": "done"
   },
   "transitions": [
    {
     "from": [
      "queued"
     ],
     "to": "working",
     "label": "Start"
    },
    {
     "from": [
      "working"
     ],
     "to": "finished",
     "label": "Finish"
    }
   ]
  },
  "views": {
   "default": "board",
   "available": [
    "board",
    "table",
    "calendar"
   ],
   "table": {
    "columns": [
     "account",
     "deployedVersion",
     "stage",
     "started_on",
     "size",
     "deployOwnerEmail"
    ]
   },
   "board": {
    "by": "stage",
    "card": {
     "title": "title",
     "meta": [
      "started_on",
      "size"
     ],
     "badge": "stage"
    }
   },
   "calendar": {
    "date": "started_on"
   },
   "filters": [
    {
     "field": "stage"
    }
   ],
   "sorts": [
    {
     "field": "started_on",
     "dir": "asc",
     "default": true
    },
    {
     "field": "stage"
    }
   ],
   "group_by": [
    "account",
    "stage"
   ],
   "detail": {
    "sections": [
     {
      "label": "Item",
      "fields": [
       "deployedVersion",
       "stage",
       "started_on",
       "size",
       "deployOwnerEmail"
      ]
     }
    ]
   },
   "create": {
    "fields": [
     "deploymentId",
     "deployedVersion",
     "started_on"
    ]
   }
  },
  "metrics": [
   {
    "id": "working",
    "label": "Working",
    "count": {
     "where": {
      "stage": "working"
     }
    }
   },
   {
    "id": "size",
    "label": "Total size",
    "sum": {
     "field": "size",
     "where": {
      "stage": {
       "in": [
        "queued",
        "working"
       ]
      }
     }
    }
   }
  ],
  "redefined": true,
  "declared": true
 },
