 "domains": {
  "deployments": {
   "label": {
    "singular": "Shipment",
    "plural": "Shipments"
   },
   "description": "Every shipment, by owner.",
   "id_label": "Shipment id",
   "kind_field": "runtime",
   "kinds": [
    "Parcel",
    "Pallet",
    "Container"
   ],
   "create_fields": [
    "runtime",
    "lastDeployAt",
    "notes"
   ],
   "detail_fields": [
    "runtime",
    "lastDeployAt",
    "approvedByEmail",
    "notes"
   ],
   "custom_fields": [
    {
     "key": "weight_kg",
     "label": "Weight (kg)",
     "type": "number",
     "required": true,
     "show_in_list": true
    },
    {
     "key": "fill_rate",
     "label": "Fill rate",
     "type": "percent",
     "help": "Share of the box used."
    },
    {
     "key": "arrives_on",
     "label": "Arrives on",
     "type": "date",
     "show_in_list": true
    },
    {
     "key": "contact",
     "label": "Contact",
     "type": "email"
    },
    {
     "key": "tracking",
     "label": "Tracking link",
     "type": "link"
    },
    {
     "key": "carrier",
     "label": "Carrier",
     "type": "pick_list",
     "options": [
      "Road",
      "Rail",
      "Air"
     ],
     "show_in_list": true
    },
    {
     "key": "reference",
     "label": "Reference",
     "type": "text"
    },
    {
     "key": "handling",
     "label": "Handling notes",
     "type": "long_text"
    }
   ],
   "fields": {
    "deploymentId": {
     "placeholder": "SHP-001"
    },
    "environment": {
     "label": "Environment",
     "options": {
      "prod": "Production",
      "staging": "Staging",
      "uat": "UAT",
      "sandbox": "Sandbox",
      "dev": "Development"
     },
     "hidden": true,
     "fixed": "prod"
    },
    "region": {
     "label": "Depot",
     "placeholder": "ap-south-1",
     "options": {
      "eu-west-1": "West depot",
      "ap-south-1": "South depot"
     }
    },
    "deployedVersion": {
     "label": "Version",
     "placeholder": "1.0.0"
    },
    "releaseStatus": {
     "label": "State",
     "options": {
      "deployed": "Delivered",
      "in-progress": "In transit",
      "pending-approval": "Pending approval",
      "rolled-back": "Rolled back",
      "failed": "Failed"
     },
     "short_label": "State",
     "help": "Where the shipment is."
    },
    "healthStatus": {
     "label": "Health",
     "options": {
      "healthy": "Healthy",
      "degraded": "Degraded",
      "down": "Down"
     },
     "hidden": true,
     "fixed": "unknown"
    },
    "deployOwnerEmail": {
     "label": "Owner",
     "placeholder": "name@company.com"
    },
    "lastDeployAt": {
     "label": "Shipped on",
     "placeholder": "2026-01-31"
    },
    "approvedByEmail": {
     "label": "Signed by"
    },
    "notes": {
     "label": "Remarks"
    }
   }
  },
  "implementations": {
   "label": {
    "singular": "Route",
    "plural": "Routes"
   },
   "description": "Routes, grouped by network.",
