  },
  "label": {
   "singular": "Regulatory filing",
   "plural": "Regulatory filings"
  },
  "description": "One row per return, disclosure or report filed with a regulator: the period, who prepared and signed it off, and whether it went in on time.",
  "id": {
   "field": "deploymentId",
   "label": "Filing id",
   "placeholder": "Q2FY27-ALM-return",
   "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,63}$"
  },
  "relations": {
   "account": {
    "required": true
   },
   "tasks": true
  },
  "icon": "file-check",
  "nav": {
   "order": 20
  },
  "title": "{runtime} · {deployedVersion}",
  "lifecycle": {
   "field": "releaseStatus",
   "initial": "in-progress",
   "enforce": "warn",
   "categories": {
    "in-progress": "active",
    "pending-approval": "active",
    "deployed": "done",
    "rolled-back": "done",
    "failed": "cancelled"
   },
   "transitions": [
    {
     "from": [
      "in-progress"
     ],
     "to": "pending-approval",
     "label": "Send for sign-off",
     "requires": [
      "deployOwnerEmail",
      "evidence"
     ]
    },
    {
     "from": [
      "pending-approval"
     ],
     "to": "in-progress",
     "label": "Send back",
     "requires_comment": true
    },
    {
     "from": [
      "pending-approval"
     ],
     "to": "deployed",
     "label": "Mark filed",
     "roles": [
      "owner",
      "admin"
     ],
     "not_by": "deployOwnerEmail",
     "requires": [
      "lastDeployAt",
      "liveUrl"
     ],
     "set": {
      "approvedByEmail": "{me}"
     }
    },
    {
     "from": [
      "in-progress",
      "pending-approval"
     ],
     "to": "failed",
     "label": "Mark missed",
     "roles": [
      "owner",
      "admin"
     ],
     "requires_comment": true
    },
    {
     "from": [
      "deployed"
     ],
     "to": "rolled-back",
     "label": "Refile"
    },
    {
     "from": [
      "rolled-back"
     ],
     "to": "pending-approval",
     "label": "Send for sign-off"
    }
   ]
  },
  "views": {
   "default": "table",
   "available": [
    "table",
    "board",
    "calendar"
   ],
   "table": {
    "columns": [
     "account",
     "runtime",
     "deployedVersion",
     "due_date",
     "releaseStatus",
     "timeliness",
     "penalty_exposure",
     "deployOwnerEmail"
    ]
   },
   "board": {
    "by": "releaseStatus",
    "card": {
     "title": "title",
     "meta": [
      "due_date",
      "deployOwnerEmail"
     ],
     "badge": "timeliness"
    }
   },
   "calendar": {
    "date": "due_date"
   },
   "filters": [
    {
     "field": "releaseStatus"
    },
    {
     "field": "runtime"
    },
    {
     "field": "penalty_exposure"
    },
    {
     "field": "due_date",
     "presets": [
      "overdue",
      "due_7d",
      "due_30d"
     ]
    },
    {
     "scope": "people",
     "field": "deployOwnerEmail"
    }
   ],
   "sorts": [
    {
     "field": "due_date",
     "dir": "asc",
     "default": true
    },
    {
     "field": "account"
    },
    {
     "field": "releaseStatus"
    }
   ],
   "group_by": [
    "account",
    "runtime"
   ],
   "detail": {
    "sections": [
     {
      "label": "Filing",
      "fields": [
       "runtime",
       "deployedVersion",
       "due_date",
       "releaseStatus",
       "timeliness"
      ]
     },
     {
      "label": "Sign-off",
      "fields": [
       "deployOwnerEmail",
       "approvedByEmail",
       "lastDeployAt",
       "liveUrl"
      ]
     },
     {
      "label": "Basis",
      "fields": [
       "source_requirement",
       "penalty_exposure",
       "notes"
      ]
     },
     {
      "related": "files"
     },
     {
      "related": "tasks"
     },
     {
      "related": "activity"
     },
     {
      "related": "comments"
     }
    ]
   },
   "create": {
    "fields": [
     "account",
     "deploymentId",
     "runtime",
     "deployedVersion",
     "due_date",
     "deployOwnerEmail",
     "source_requirement"
    ],
    "submit_label": "Add filing"
   }
  },
  "permissions": {
   "read": "*",
   "create": "*",
   "update": "*",
   "delete": [
    "owner",
    "admin"
   ],
   "fields": {
    "approvedByEmail": {
     "update": [
      "owner",
      "admin"
     ]
    }
   }
  },
  "reminders": [
   {
    "id": "due-soon",
    "date": "due_date",
    "before_days": [
     7,
     2
    ],
    "unless": {
     "releaseStatus": {
      "category": [
       "done",
       "cancelled"
      ]
     }
    },
    "notify": [
     "deployOwnerEmail"
    ],
    "channels": [
     "inbox",
     "push"
    ]
   },
   {
    "id": "overdue",
    "date": "due_date",
    "after_days": [
     0,
     3
    ],
    "unless": {
     "releaseStatus": {
      "category": [
       "done",
       "cancelled"
      ]
     }
    },
    "notify": [
     "deployOwnerEmail",
     "{manager_of:deployOwnerEmail}"
    ],
    "channels": [
     "inbox",
     "push"
    ]
   }
  ],
  "metrics": [
   {
    "id": "overdue",
    "label": "Overdue filings",
    "count": {
     "where": {
      "timeliness": "Overdue"
     }
    },
    "attention": true
   },
   {
    "id": "on-time-rate",
    "label": "Filed on time",
    "format": "percent",
    "ratio": {
     "num": {
      "timeliness": "On time"
     },
     "den": {
      "releaseStatus": {
       "category": "done"
      }
     }
    }
   }
  ],
  "agent": {
   "tools": {
    "read": true,
    "write": true,
    "delete": false
   },
   "describe": "A filing is one submission to one regulator for one period. Always record the due date. A filing is marked filed only by an admin who did not prepare it, and only with the filed-on date and the acknowledgement link.",
   "rules": [
    "Never mark a filing filed without the acknowledgement link.",
    "Timeliness is computed: never set it."
   ]
  },
  "io": {
   "export": {
    "csv": true,
    "workbook_sheet": true
   },
   "import": {
    "csv": true,
    "match_on": [
     "account",
     "deploymentId"
    ]
   }
  },
  "redefined": true,
  "declared": true
 },
 "implementations": {
  "enabled": true,
  "kind": "record",
  "storage": "implementation",
  "columns": "all",
  "fields": {
   "rolloutId": {
    "order": 10010,
    "type": "text",
    "key": "rolloutId",
