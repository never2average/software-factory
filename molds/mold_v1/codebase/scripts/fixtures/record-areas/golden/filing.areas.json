    "key": "due_date",
    "column": false
   },
   "timeliness": {
    "order": 60,
    "type": "pick_list",
    "label": "Timeliness",
    "computed": {
     "when": [
      {
       "if": {
        "lastDeployAt": {
         "set": false
        },
        "due_date": {
         "lt": "{today}"
        }
       },
       "then": "Overdue"
      },
      {
       "if": {
        "lastDeployAt": {
         "lte": "{due_date}"
        }
       },
       "then": "On time"
      },
      {
       "if": {
        "lastDeployAt": {
         "set": true
        }
       },
       "then": "Filed late"
      }
     ],
     "else": "Not yet due"
    },
    "options": [
     {
      "value": "On time",
      "tone": "green"
     },
     {
      "value": "Filed late",
      "tone": "amber"
     },
     {
      "value": "Overdue",
      "tone": "red",
      "attention": true
     },
     {
      "value": "Not yet due",
      "tone": "slate"
     }
    ],
    "key": "timeliness",
    "column": false
   },
   "evidence": {
    "order": 95,
    "type": "file",
    "many": true,
    "label": "Filed copy and workings",
    "folder": "{folder:deliveries}/{customer_id}/{id}/",
    "key": "evidence",
