                "reresolve_on": [
                  "open"
                ]
              }
            },
            {
              "id": "review",
              "title": "Review",
              "status": {
                "default": false
              },
              "comments_required": {
                "default": true,
                "evaluation_criterion": "Why it is approved, or what is missing.",
                "required_on": [
                  "completed",
                  "rejected"
                ]
              },
              "assignee": {
                "condition": {
                  "$or": {
                    "query": {
                      "email": {
                        "$object": "reviewer"
                      }
                    }
                  }
                },
                "reresolve_on": [
                  "open"
                ]
              }
            }
          ]
        },
        "diff": [
          {
            "priority": 0,
            "applicability": "all",
            "selector": {
              "rule": "forAll"
            },
            "condition": {
              "step$state": {
                "$delta": {
                  "before": "",
                  "after": "completed"
                }
              }
            },
            "action": {
              "internal": {
                "scope": "self",
                "set": {
                  "completed_at": {
                    "value": {
                      "$delta": {}
                    }
                  }
                }
              }
            }
          },
          {
            "priority": 0.5,
            "applicability": "all",
            "selector": {
              "rule": "forAll"
            },
            "condition": {
              "step$state": {
                "$delta": {
                  "before": "completed",
                  "after": ""
                }
              }
            },
            "action": {
              "internal": {
                "scope": "self",
                "set": {
                  "completed_at": {
                    "value": null
                  }
                }
              }
            }
          },
          {
            "priority": 1,
            "applicability": "all",
            "selector": {
              "rule": "single",
              "group_selector": {
                "id": "prepare"
              }
            },
            "condition": {
              "step$state": {
                "$delta": {
                  "before": "",
                  "after": "completed"
                }
              }
            },
            "action": {
              "internal": {
                "scope": "other",
                "other_selector": {
                  "id": "review"
                },
                "set": {
                  "status": {
                    "value": true
                  },
                  "state": {
                    "value": "open"
                  }
                }
              }
            }
          },
          {
            "priority": 2,
            "applicability": "all",
            "selector": {
              "rule": "single",
              "group_selector": {
                "id": "review"
              }
            },
            "condition": {
              "step$state": {
                "$delta": {
                  "before": "",
                  "after": "rejected"
                }
              }
            },
            "action": {
              "internal": {
                "scope": "other",
                "other_selector": {
                  "id": "prepare"
                },
                "set": {
                  "status": {
                    "value": true
                  },
                  "state": {
                    "value": "open"
                  },
                  "completed_at": {
                    "value": null
                  }
                }
              }
            }
          },
          {
            "priority": 3,
            "applicability": "all",
            "selector": {
              "rule": "single",
              "group_selector": {
                "id": "review"
              }
            },
            "condition": {
              "step$state": {
                "$delta": {
                  "before": "",
                  "after": "rejected"
                }
              }
            },
            "action": {
              "internal": {
                "scope": "self",
                "set": {
                  "status": {
                    "value": false
                  }
