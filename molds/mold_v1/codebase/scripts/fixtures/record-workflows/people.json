        "init": {
          "start_id": "prepare",
          "transitions": {
            "open": [
              "completed",
              "rejected",
              "escalated"
            ],
            "completed": [
              "open"
            ],
            "rejected": [
              "open"
            ],
            "escalated": [
              "completed",
              "rejected",
              "open"
            ]
          },
          "terminal_when": {
            "selector": {
              "id": "review"
            },
            "all": {
              "state": "completed"
            }
          },
          "steps": [
            {
              "id": "prepare",
              "title": "Prepare",
              "comments_required": {
                "default": true,
                "evaluation_criterion": "What was done.",
                "required_on": [
                  "completed"
                ]
              },
              "evidence_required": {
                "default": true,
                "evaluation_criterion": "The material that shows it.",
                "required_on": [
                  "completed"
                ]
              },
              "assignee": {
                "condition": {
                  "$or": {
                    "query": {
                      "email": {
                        "$object": "assignee"
                      }
                    }
                  }
