{
  "version": 1,
  "about": "Section-heading regex table for Indian housing finance company annual reports. Read by section_map.py, validate_section_map.py and render_section_map_md.py. Patterns are Python regexes applied case-insensitively to a cleaned title (straight quotes, plain hyphens, single spaces). Order matters: the first entry whose pattern matches (and whose exclude does not) wins. A copy sits in skills/build-the-section-map/references/; ar_common.py --self-test fails when the two differ.",
  "contents_headers": [
    "^(table of )?contents?$",
    "^index$",
    "^(what'?s )?inside( this report| the report)?$",
    "^in this report$",
    "^across the pages$"
  ],
  "group_headers": [
    "^corporate (overview|review)$",
    "^company overview$",
    "^strategic (review|report)$",
    "^statutory (reports?|section)$",
    "^management reports?$",
    "^financial (section|reports?)$",
    "^governance$",
    "^(about|know) (us|the company)$",
    "^overview$"
  ],
  "protected_phrases": [
    "\\bind\\s*-?\\s*as\\s*-?\\s*\\d+",
    "\\bsection\\s+\\d+[a-z]{0,2}(\\s*\\(\\d+\\))?",
    "\\bregulation\\s+\\d+[a-z]?(\\s*\\(\\d+\\))?",
    "\\brule\\s+\\d+(\\s*\\(\\d+\\))?",
    "\\b(form\\s+)?(no\\.?\\s*)?(aoc|mr|mgt|dpt)\\s*-?\\s*\\d+",
    "\\bschedule\\s+([ivx]+|\\d+)\\b",
    "\\bdivision\\s+([ivx]+|\\d+)\\b",
    "\\bnote\\s+(no\\.?\\s*)?\\d+",
    "\\bannexure\\s*-?\\s*(\\d+|[ivx]+)\\b",
    "\\bpart\\s*-?\\s*(\\d+|[ivx]+)\\b",
    "\\b(19|20)\\d{2}\\s*[-/]\\s*(19|20)?\\d{2}\\b",
    "\\b(19|20)\\d{2}\\b",
    "\\b\\d+(st|nd|rd|th)\\b",
    "\\d+\\.\\d+",
    "\\d+\\s*%",
    "\\b(fy|q[1-4]|h[12]|9m)\\s*'?\\d{2,4}\\b"
  ],
  "sections": [
    {
      "key": "auditors_report",
      "title": "Independent Auditor's Report",
      "index_section": "auditors_report",
      "slug": "independent-auditors-report",
      "level": "top",
      "contextual": true,
      "required": true,
      "search": "top_of_page",
      "patterns": [
        "^(independent )?auditor'?s'? report\\b",
        "^report of the (independent |statutory )?auditors?\\b",
        "\\bindependent auditor'?s'? report\\b"
      ],
      "exclude": ["^annexure", "secretarial", "certificate", "\\bcaro\\b", "internal financial controls"]
    },
    {
      "key": "caro_annexure",
      "title": "CARO annexure to the auditor's report",
      "index_section": "auditors_report",
      "slug": "independent-auditors-report",
      "level": "sub",
      "parent": "standalone_auditors_report",
      "required": false,
      "search": "anywhere_in_range",
      "patterns": [
        "companies \\(auditor'?s'? report\\) order",
        "\\bcaro\\b,? ?20\\d{2}",
        "^annexure.{0,6}to the (independent )?auditor'?s'? report.{0,80}(other legal and regulatory requirements|clause \\(?i\\)?)"
      ]
    },
    {
      "key": "ifc_annexure",
      "title": "Auditor's report on internal financial controls",
      "index_section": "auditors_report",
      "slug": "independent-auditors-report",
      "level": "sub",
      "parent": "standalone_auditors_report",
      "required": false,
      "search": "anywhere_in_range",
      "patterns": [
        "report on the internal financial controls",
        "internal financial controls (over financial reporting|with reference to).{0,80}(section 143|clause \\(i\\))"
      ]
    },
    {
      "key": "consolidated_financial_statements",
      "title": "Consolidated financial statements",
      "index_section": "consolidated_financial_statements",
      "slug": "consolidated-financial-statements",
      "level": "top",
      "basis": "consolidated",
      "required": true,
      "search": "top_of_page",
      "patterns": [
        "^consolidated (ind as )?(financial statements?|financials|accounts)\\b",
        "^consolidated$"
      ],
      "exclude": ["auditor", "salient features", "\\baoc\\b"]
    },
    {
      "key": "standalone_financial_statements",
      "title": "Standalone financial statements",
      "index_section": "standalone_financial_statements",
      "slug": "standalone-financial-statements",
      "level": "top",
      "basis": "standalone",
      "required": true,
      "search": "top_of_page",
      "patterns": [
        "^standalone (ind as )?(financial statements?|financials|accounts)\\b",
        "^standalone$"
      ],
      "patterns_unlabelled": [
        "^financial statements?$",
        "^(annual )?accounts$",
        "^financials$"
      ],
      "exclude": ["auditor"]
    },
    {
      "key": "balance_sheet",
      "title": "Balance sheet",
      "index_section": "financial_statements",
      "slug": "financial-statements",
      "level": "sub",
      "contextual": true,
      "parent": "financial_statements",
      "required": false,
      "search": "top_of_page",
      "patterns": [
        "^(standalone |consolidated )?balance sheet\\b",
        "^(standalone |consolidated )?statement of assets and liabilities\\b"
      ],
      "exclude": ["abstract", "^notes"]
    },
    {
      "key": "statement_of_profit_and_loss",
      "title": "Statement of profit and loss",
      "index_section": "financial_statements",
      "slug": "financial-statements",
      "level": "sub",
      "contextual": true,
      "parent": "financial_statements",
      "required": false,
      "search": "top_of_page",
      "patterns": [
        "^(standalone |consolidated )?statement of profit (and|&) loss\\b",
        "^(standalone |consolidated )?profit (and|&) loss (account|statement)\\b"
      ]
    },
    {
