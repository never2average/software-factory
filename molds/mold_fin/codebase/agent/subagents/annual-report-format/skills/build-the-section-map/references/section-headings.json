      "level": "sub",
      "contextual": true,
      "parent": "financial_statements",
      "required": false,
      "search": "top_of_page",
      "patterns": [
        "^(standalone |consolidated )?(statement of cash ?flows?|cash ?flow statement)\\b"
      ]
    },
    {
      "key": "statement_of_changes_in_equity",
      "title": "Statement of changes in equity",
      "index_section": "financial_statements",
      "slug": "financial-statements",
      "level": "sub",
      "contextual": true,
      "parent": "financial_statements",
      "required": false,
      "search": "top_of_page",
      "patterns": [
        "^(standalone |consolidated )?statement of changes in equity\\b"
      ]
    },
    {
      "key": "notes_to_financial_statements",
      "title": "Notes to the financial statements",
      "index_section": "financial_statements",
      "slug": "financial-statements",
      "level": "sub",
      "contextual": true,
      "parent": "financial_statements",
      "required": false,
      "search": "top_of_page",
      "patterns": [
        "^notes (to|forming part of|annexed to)( and forming part of)? the (standalone |consolidated )?(ind as )?(financial statements|accounts)\\b",
        "^notes to (standalone |consolidated )?(financial statements|accounts)\\b",
        "^(significant|material|summary of (significant|material)) accounting polic(y|ies)\\b"
      ]
    },
    {
      "key": "directors_report",
      "title": "Board's / Directors' Report",
      "index_section": "directors_report",
      "slug": "directors-report",
      "level": "top",
      "required": true,
      "search": "top_of_page",
      "patterns": [
        "^(the )?(board'?s'?|directors'?|director'?s) report\\b",
        "^report of the (board of )?directors\\b",
        "^(board'?s'?|directors'?) report (and|&|including) (its )?(annexures?|management discussion)"
