{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Input of reconcile_sources.py",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "kpi",
  "period",
  "listing"
 ],
 "properties": {
  "kpi": {
   "enum": [
    "aum",
    "loan_book",
    "disbursements",
    "networth",
    "borrowings",
    "branches",
    "employees",
    "sell_down_volume",
    "buy_out_volume",
    "gnpa_pct",
    "nnpa_pct",
    "pcr_stage3_pct",
    "yield_pct",
    "cost_of_funds_pct",
    "spread_pct",
    "nim_pct",
    "crar_pct",
    "debt_equity",
    "cost_to_income_pct",
    "opex_to_loan_book_pct",
    "opex_to_aum_pct",
    "roa_pct",
    "roe_pct",
    "disbursement_per_branch",
    "disbursement_per_employee",
    "expense_per_employee",
    "employee_cost_per_employee"
   ]
  },
  "period": {
   "type": "string",
   "pattern": "^Q[1-4] FY\\d{2}$"
  },
  "listing": {
   "enum": [
    "listed",
    "unlisted"
   ]
  },
  "qr": {
   "type": [
    "object",
    "null"
   ],
   "additionalProperties": false,
   "required": [
    "value"
   ],
   "properties": {
    "value": {
     "type": [
      "number",
      "string",
      "null"
     ],
     "description": "as printed ('1,23,456.78') or a number"
    },
    "unit": {
     "enum": [
      "crore",
      "lakh",
      "million",
      "billion",
      "thousand",
      "rupee",
      "%",
      "x",
      "count"
     ]
    },
    "header": {
     "type": "string",
     "description": "the table/slide header naming the unit, used when `unit` is absent"
    },
    "document": {
     "type": "string",
     "minLength": 1
    },
    "page_or_slide": {
     "type": [
      "string",
      "integer"
     ]
    },
    "period": {
     "type": "string"
    },
    "basis": {
     "enum": [
      "standalone",
      "consolidated"
     ]
    },
    "definition": {
     "type": "string"
    }
   }
  },
  "ip": {
   "type": [
    "object",
    "null"
   ],
   "additionalProperties": false,
   "required": [
    "value"
   ],
   "properties": {
    "value": {
     "type": [
      "number",
      "string",
      "null"
     ],
     "description": "as printed ('1,23,456.78') or a number"
    },
    "unit": {
     "enum": [
      "crore",
      "lakh",
      "million",
      "billion",
      "thousand",
      "rupee",
      "%",
      "x",
      "count"
     ]
    },
    "header": {
     "type": "string",
     "description": "the table/slide header naming the unit, used when `unit` is absent"
    },
    "document": {
     "type": "string",
     "minLength": 1
    },
    "page_or_slide": {
     "type": [
      "string",
      "integer"
     ]
    },
    "period": {
     "type": "string"
    },
    "basis": {
     "enum": [
      "standalone",
      "consolidated"
     ]
    },
    "definition": {
     "type": "string"
    }
   }
  },
  "parent_ip": {
   "type": [
    "object",
    "null"
   ],
   "additionalProperties": false,
   "required": [
    "value"
   ],
   "properties": {
    "value": {
     "type": [
      "number",
      "string",
      "null"
     ],
     "description": "as printed ('1,23,456.78') or a number"
    },
    "unit": {
     "enum": [
      "crore",
      "lakh",
      "million",
      "billion",
      "thousand",
      "rupee",
      "%",
      "x",
      "count"
     ]
    },
    "header": {
     "type": "string",
     "description": "the table/slide header naming the unit, used when `unit` is absent"
    },
    "document": {
     "type": "string",
     "minLength": 1
    },
    "page_or_slide": {
     "type": [
      "string",
      "integer"
     ]
    },
    "period": {
     "type": "string"
    },
    "basis": {
     "enum": [
      "standalone",
      "consolidated"
     ]
    },
    "definition": {
     "type": "string"
    }
   }
  },
  "tolerance_pct": {
   "type": "number",
   "minimum": 0,
   "maximum": 5,
   "description": "defaults to the rulebook's 5; may only be tightened"
  }
 }
}
