    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-use-controllable-state": "1.2.2",
    "@shikijs/core": "4.1.0",
    "@shikijs/engine-javascript": "4.1.0",
    "@shikijs/engine-oniguruma": "4.1.0",
    "@streamdown/cjk": "1.0.3",
    "@streamdown/code": "1.1.1",
    "@streamdown/math": "1.0.2",
    "@streamdown/mermaid": "1.0.2",
    "@tailwindcss/postcss": "4.3.0",
    "@vercel/blob": "^2.5.0",
    "@vercel/connect": "0.2.2",
    "acorn": "^8.17.0",
    "ai": "^7.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "docx-preview": "^0.3.7",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "eve": "^0.25.1",
    "exceljs": "^4.4.0",
    "imapflow": "^1.4.6",
    "jose": "^6.2.3",
    "lucide-react": "1.16.0",
    "motion": "12.40.0",
    "nanoid": "5.1.11",
    "next": "16.2.6",
    "playwright-core": "^1.62.0",
    "postgres": "^3.4.9",
    "quickjs-emscripten": "^0.32.0",
    "radix-ui": "1.4.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "^3.10.0",
    "server-only": "^0.0.1",
    "shiki": "4.1.0",
    "streamdown": "2.5.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.0",
    "use-stick-to-bottom": "1.1.4",
    "xlsx": "^0.18.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "24.x",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "^0.31.10",
    "microsandbox": "^0.5.10",
    "playwright": "^1.61.1",
    "typescript": "6.0.3"
  },
  "overrides": {
    "ai": "^7.0.0"
  },
  "engines": {
    "node": "24.x"
  }
