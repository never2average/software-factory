{
  "name": "fde-agent",
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "validate:schema": "node --experimental-strip-types scripts/validate-data.mjs",
    "seed:dataroom": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/seed-dataroom.ts",
    "seed:dataroom-blob": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/seed-dataroom-blob.mjs",
    "validate:dataroom": "node --experimental-strip-types scripts/validate-dataroom.mjs",
    "test:dataroom": "node --experimental-strip-types scripts/test-dataroom-store.mjs",
    "test:syncs": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/test-syncs.mjs",
    "test:alerts": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/test-alerts.mjs",
    "test:schedules": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/test-schedules.mjs",
    "test:cron-match": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/test-cron-match.mjs",
    "test:workbook-spec": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/test-workbook-spec.mjs",
    "test:render": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/test-render.mjs",
    "test:sor": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/test-system-of-record.mjs",
    "test:memory": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/test-memory.mjs",
    "test:prompt-context": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/test-prompt-context.mjs",
    "test:browser-security": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/test-browser-security.mjs",
    "test:org-isolation": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file-if-exists=.env.local scripts/test-org-isolation.mjs",
    "seed:postgres": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/seed-postgres.ts",
    "fde:onboard-self": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file=.env.local scripts/fde/onboard-self.mjs",
    "fde:new-customer": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file=.env.local scripts/fde/new-customer.mjs",
    "fde:new-org": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file=.env.local scripts/fde/new-org.mjs",
    "fde:backfill-customizations": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file=.env.local scripts/fde/backfill-customizations.mjs",
    "fde:backfill-integrations": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file=.env.local scripts/fde/backfill-integrations.mjs",
    "fde:configure-platform": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file=.env.local scripts/fde/configure-platform.mjs",
    "fde:configure-solution": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file=.env.local scripts/fde/configure-solution.mjs",
    "fde:configure-agents": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file=.env.local scripts/fde/configure-agents.mjs",
    "fde:configure-infra": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file=.env.local scripts/fde/configure-infra.mjs",
    "fde:validate-solution": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file=.env.local scripts/fde/validate-solution.mjs",
    "fde:context-graph": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file=.env.local scripts/fde/context-graph.mjs",
    "fde:doctor": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file=.env.local scripts/fde/doctor.mjs",
    "fde:seed-workflows": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file=.env.local scripts/fde/seed-workflows.mjs",
    "fde:inventory": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/fde/inventory.mjs",
    "fde:sandbox": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/fde/sandbox-prewarm.mjs",
    "fde:thread-open-perf": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/fde/thread-open-perf.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:production": "node scripts/migrate-production.mjs",
    "db:migrate:task-workflows": "node .migrate-task-workflow-service.mjs",
    "build:eve": "eve build",
    "dev:eve": "eve dev",
    "start:eve": "eve start",
    "test:cards": "playwright test",
    "test:task-workflow:stress": "playwright test --config=playwright.task-workflow.config.ts",
    "test:workflow-leases": "node scripts/test-workflow-leases.mjs",
    "test:qm-hardening": "npm run test:prompt-context && npm run test:memory && npm run test:browser-security && npm run test:workflow-leases && npm run test:step-context && npm run test:email-signin && npm run check:gates && npm run test:chat-persistence && npm run test:chat-turn-state && npm run test:chat-attachments && npm run test:chat-usage",
    "test:browser": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file=.env.local scripts/test-browser-use.mjs",
    "db:push": "drizzle-kit push",
    "build:workflow-library": "node scripts/build-workflow-library.mjs",
    "build:skill-library": "node scripts/build-skill-library.mjs",
    "prebuild": "npm run build:generated",
    "build:subagent-meta": "node scripts/gen-subagent-meta.mjs",
    "build:generated": "npm run build:skill-library && npm run build:workflow-library && npm run build:subagent-meta",
    "check:generated": "npm run build:generated && git diff HEAD --exit-code -- setup/skills agent/lib/workflow-library.generated.ts app/_components/subagent-meta.generated.ts",
    "check:tenancy": "node scripts/check-tenancy.mjs",
    "test:workflow-args": "node --experimental-strip-types scripts/test-workflow-args.mjs",
    "deploy:web": "node scripts/deploy.mjs web",
    "deploy:agent": "node scripts/deploy.mjs agent",
    "seed:inbox": "node scripts/seed-inbox-samples.mjs",
    "test:step-context": "node --conditions=react-server --experimental-strip-types scripts/test-step-context.mjs",
    "test:email-signin": "node --conditions=react-server --experimental-strip-types scripts/test-email-signin.mjs",
    "check:gates": "node --conditions=react-server --experimental-strip-types scripts/check-gates.mjs",
    "test:chat-persistence": "node scripts/test-chat-persistence.mjs",
    "test:chat-turn-state": "node --experimental-strip-types scripts/test-chat-turn-state.mjs",
    "test:attachment-e2e": "node --conditions=react-server --experimental-strip-types scripts/test-attachment-e2e.mjs",
    "test:chat-attachments": "node --experimental-strip-types scripts/test-chat-attachments.mjs",
    "test:chat-usage": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/test-chat-usage.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.5",
    "@dnd-kit/core": "^6.3.1",
