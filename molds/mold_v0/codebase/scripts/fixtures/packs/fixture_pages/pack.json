{
  "$schema": "../../../../packs/pack.schema.json",
  "id": "fixture_pages",
  "name": "Fixture pages",
  "version": "0.1.0",
  "description": "A declarative test fixture (mold_v0-253, mold_v0-254, mold_v0-256; scripts/record-pages-test.ts): record areas whose pages are laid out (detail): a header with badges, facts (some computed from related records) and actions, notices, tabs of sections, copyable fields, related lists, a record's runs, a log, the change history, code and table views and a file browser; a tab with columns computed from related records. Never shipped.",
  "record_areas": [
    {
      "name": "projects",
      "label": "Projects",
      "role": "source",
      "scope": "workspace",
      "fields": [
        {
          "name": "summary",
          "label": "Summary",
          "type": "text",
          "max_length": 500
        },
        {
          "name": "repository",
          "label": "Repository",
          "type": "url",
          "copyable": true
        },
        {
          "name": "owner",
          "label": "Owner",
          "type": "text"
        },
        {
          "name": "health",
          "label": "Health",
          "type": "enum",
          "options": [
            {
              "value": "healthy",
              "label": "Healthy"
            },
            {
              "value": "at_risk",
              "label": "At risk"
            },
            {
              "value": "blocked",
              "label": "Blocked"
            }
          ]
        },
        {
          "name": "started",
          "label": "Started",
          "type": "date"
        }
      ],
      "detail": {
        "header": {
          "subtitle": "summary",
          "badges": [
            {
              "field": "health",
              "colors": {
                "healthy": "success",
                "at_risk": "warning",
                "blocked": "danger"
              }
            }
          ],
          "facts": [
            {
              "field": "owner"
            },
            {
              "field": "started"
            },
            {
              "field": "repository"
            },
            {
              "label": "Last build",
              "computed": {
                "area": "builds",
                "op": "latest",
                "field": "status",
                "sort": {
                  "field": "started",
                  "direction": "desc"
                }
              }
            },
            {
              "label": "Builds",
              "computed": {
                "area": "builds",
                "op": "count"
              }
            },
            {
              "label": "Failed builds",
              "computed": {
                "area": "builds",
                "op": "count",
                "where": {
                  "field": "status",
                  "equals": "failed"
                }
              }
            },
            {
              "label": "Last coverage",
              "unit": "%",
              "computed": {
                "area": "builds",
                "op": "latest",
                "field": "coverage",
                "sort": {
                  "field": "started",
                  "direction": "desc"
                },
                "where": {
                  "field": "status",
                  "equals": "passed"
                }
              }
            }
          ]
        },
        "notices": [
          {
            "when": {
              "field": "health",
              "equals": "blocked"
            },
            "tone": "danger",
            "title": "Blocked",
            "text": "Something stops this project: read its builds for the failing one."
          }
        ],
        "tabs": [
          {
            "label": "Overview",
            "sections": [
              {
                "title": "About",
                "columns": 1,
                "fields": [
                  "summary",
                  "repository",
                  "owner"
                ]
              },
              {
                "title": "Builds",
                "related": {
                  "area": "builds",
                  "columns": [
                    "status",
                    "branch",
                    "environment",
                    "started",
                    "duration"
                  ],
                  "sort": {
                    "field": "started",
                    "direction": "desc"
                  },
                  "limit": 5
                },
                "empty": "No builds of this project yet. Start one from the header."
              },
              {
                "title": "Runs",
                "runs": {
                  "kinds": [
                    "build",
                    "rebuild"
                  ],
                  "limit": 5
                },
                "empty": "No runs on this project yet."
              }
            ]
          }
        ],
        "actions": [
          {
            "kind": "start_run",
            "place": "primary",
            "label": "Start a build",
            "job_kind": "build",
            "input": {
              "project": "$key"
            }
          },
          {
            "kind": "create_record",
            "place": "secondary",
            "label": "Add build",
            "area": "builds",
            "input": {
              "project": "$key",
              "summary": "$field:summary"
            }
          },
          {
            "kind": "edit",
            "place": "secondary"
          },
          {
            "kind": "copy_link"
          },
          {
            "kind": "delete"
          }
        ]
      },
      "key_from_title": true
    },
    {
      "name": "environments",
      "label": "Environments",
      "role": "source",
      "scope": "workspace",
      "fields": [
        {
          "name": "tier",
          "label": "Tier",
          "type": "enum",
          "options": [
            {
              "value": "production",
              "label": "Production"
            },
            {
              "value": "staging",
              "label": "Staging"
            },
            {
              "value": "preview",
              "label": "Preview"
            }
          ]
        },
        {
          "name": "region",
          "label": "Region",
          "type": "text"
        },
        {
          "name": "address",
          "label": "Address",
          "type": "url"
        }
      ]
    },
    {
      "name": "builds",
      "label": "Builds",
      "role": "check",
      "scope": "workspace",
      "list_columns": [
        "status",
        "project",
        "branch",
        "started"
      ],
      "fields": [
        {
          "name": "status",
          "label": "Status",
          "type": "enum",
          "required": true,
          "options": [
            {
              "value": "queued",
              "label": "Queued"
            },
            {
              "value": "running",
              "label": "Running"
            },
            {
              "value": "passed",
              "label": "Passed"
            },
            {
              "value": "failed",
              "label": "Failed"
            },
            {
              "value": "cancelled",
              "label": "Cancelled"
            }
          ]
        },
        {
          "name": "summary",
          "label": "Summary",
          "type": "text",
          "max_length": 500
        },
        {
          "name": "project",
          "label": "Project",
          "type": "reference",
          "to": "projects"
        },
        {
          "name": "environment",
          "label": "Environment",
          "type": "reference",
          "to": "environments"
        },
        {
          "name": "tier",
          "label": "Tier",
          "type": "enum",
          "options": [
            {
              "value": "production",
              "label": "Production"
            },
            {
              "value": "staging",
              "label": "Staging"
            },
            {
              "value": "preview",
              "label": "Preview"
            }
          ]
        },
        {
          "name": "branch",
          "label": "Branch",
          "type": "text",
          "copyable": true
        },
        {
          "name": "commit",
          "label": "Commit",
          "type": "text",
          "copyable": true
        },
        {
          "name": "triggered_by",
          "label": "Triggered by",
          "type": "text"
        },
        {
          "name": "started",
          "label": "Started",
          "type": "date"
        },
        {
          "name": "duration",
          "label": "Duration",
          "type": "number",
          "min": 0
        },
        {
          "name": "tests_passed",
          "label": "Tests passed",
          "type": "number",
          "min": 0
        },
        {
          "name": "tests_failed",
          "label": "Tests failed",
          "type": "number",
          "min": 0
        },
        {
          "name": "coverage",
          "label": "Coverage",
          "type": "number",
          "min": 0,
          "max": 100
        },
        {
          "name": "artifact",
          "label": "Artifact",
          "type": "url",
          "copyable": true
        },
        {
          "name": "approver",
          "label": "Approved by",
          "type": "text"
        },
        {
          "name": "approved_on",
          "label": "Approved on",
          "type": "date"
        },
        {
          "name": "failure",
          "label": "Failure",
          "type": "text",
          "max_length": 2000
        },
        {
          "name": "log_excerpt",
          "label": "Log excerpt",
          "type": "text",
          "max_length": 20000
        },
        {
          "name": "config",
          "label": "Configuration",
          "type": "json"
        },
        {
          "name": "notes",
          "label": "Notes",
          "type": "text"
        },
        {
          "name": "log",
          "label": "Build log",
          "type": "text",
          "max_length": 20000
        },
        {
          "name": "manifest",
          "label": "Manifest",
          "type": "text",
          "max_length": 20000
        },
        {
          "name": "test_suites",
          "label": "Test suites",
          "type": "json"
        },
        {
          "name": "attachments",
          "label": "Attachments",
          "type": "file",
          "multiple": true
        }
      ],
      "detail": {
        "header": {
          "subtitle": "summary",
          "badges": [
            {
              "field": "status",
              "colors": {
                "queued": "neutral",
                "running": "info",
                "passed": "success",
                "failed": "danger",
                "cancelled": "warning"
              }
            },
            {
              "field": "tier",
              "colors": {
                "production": "viz-7",
                "staging": "viz-1",
                "preview": "viz-5"
              }
            }
          ],
          "facts": [
            {
              "field": "project"
            },
            {
              "field": "environment"
            },
            {
              "field": "branch"
            },
            {
              "field": "commit"
            },
            {
              "field": "started"
            },
            {
              "field": "duration",
              "unit": "s"
            },
            {
              "field": "coverage",
              "unit": "%"
            },
            {
              "field": "artifact"
            }
          ]
        },
        "notices": [
          {
            "when": {
              "field": "status",
              "equals": "failed"
            },
            "tone": "danger",
            "title": "This build failed",
            "text": "Its failure and log excerpt are on the Logs tab; a new commit to the branch starts another build."
          },
          {
            "when": {
              "field": "status",
              "in": [
                "queued",
                "running"
              ]
            },
            "tone": "info",
            "text": "This build is still going: its results fill in when it ends."
          },
          {
            "when": {
              "field": "approver",
              "empty": true
            },
            "tone": "warning",
            "title": "Not approved yet",
            "text": "A build is released only once someone approves it."
          }
        ],
        "tabs": [
          {
            "label": "Overview",
            "sections": [
              {
                "title": "Source",
                "columns": 3,
                "fields": [
                  "project",
                  "branch",
                  "commit",
                  "environment",
                  "tier",
                  "triggered_by"
                ]
              },
              {
                "title": "Results",
                "columns": 3,
                "groups": [
                  {
                    "title": "Tests",
                    "fields": [
                      "tests_passed",
                      "tests_failed",
                      "coverage"
                    ]
                  },
                  {
                    "title": "Timing",
                    "fields": [
                      "started",
                      "duration"
                    ]
                  }
                ]
              },
              {
                "title": "Approval",
                "columns": 2,
                "fields": [
                  "approver",
                  "approved_on"
                ],
                "empty": "No one has approved this build yet."
              },
              {
                "title": "Runs",
                "runs": {
                  "limit": 5
                },
                "empty": "This build has not been re-run."
              }
            ]
          },
          {
            "label": "Logs",
            "sections": [
              {
                "title": "Failure",
                "columns": 1,
                "fields": [
                  "failure"
                ],
                "empty": "Nothing failed in this build."
              },
              {
                "title": "Log excerpt",
                "columns": 1,
                "fields": [
                  "log_excerpt"
                ],
                "empty": "No log lines were kept for this build."
              },
              {
                "title": "Build log",
                "log": {
                  "field": "log",
                  "live_when": {
                    "field": "status",
                    "in": [
                      "queued",
                      "running"
                    ]
                  }
                },
                "empty": "No log lines yet: they show here as the build writes them."
              }
            ]
          },
          {
            "label": "Configuration",
            "sections": [
              {
                "title": "Build configuration",
                "columns": 1,
                "fields": [
                  "config",
                  "artifact"
                ]
              },
              {
                "title": "Notes",
                "columns": 1,
                "fields": [
                  "notes"
                ],
                "empty": "No notes on this build."
              },
              {
                "title": "Configuration file",
                "code": {
                  "field": "config",
                  "language": "json"
                },
                "empty": "No configuration was recorded for this build."
              },
              {
                "title": "Manifest",
                "code": {
                  "field": "manifest",
                  "language": "yaml"
                },
                "empty": "No manifest was recorded for this build."
              },
              {
                "title": "Test suites",
                "table": {
                  "field": "test_suites",
                  "columns": [
                    "suite",
                    "passed",
                    "failed",
                    "seconds"
                  ]
                },
                "empty": "No test suites were recorded for this build."
              }
            ]
          },
          {
            "label": "Files",
            "sections": [
              {
                "title": "Files",
                "files": {},
                "empty": "No files were kept for this build."
              }
            ]
          },
          {
            "label": "History",
            "sections": [
              {
                "title": "Changes",
                "history": {
                  "limit": 20
                },
                "empty": "No changes recorded yet."
              }
            ]
          }
        ],
        "unplaced": "show",
        "actions": [
          {
            "kind": "start_run",
            "place": "primary",
            "label": "Re-run",
            "job_kind": "rebuild",
            "input": {
              "build": "$key",
              "branch": "branch",
              "commit": "commit"
            },
            "unavailable": [
              {
                "when": {
                  "field": "status",
                  "in": [
                    "queued",
                    "running"
                  ]
                },
                "reason": "A build that is still going can't be re-run: cancel it first, or wait for it to end."
              }
            ]
          },
          {
            "kind": "link",
            "place": "secondary",
            "field": "project",
            "label": "Open project"
          },
          {
            "kind": "edit",
            "place": "secondary"
          },
          {
            "kind": "move",
            "label": "Move"
          },
          {
            "kind": "copy_link"
          },
          {
            "kind": "delete",
            "confirm": "Delete this build and its results? Its runs stay in the runs list. This can't be undone."
          }
        ]
      },
      "lifecycle": {
        "field": "status",
        "initial": "queued",
        "transitions": [
          {
            "from": [
              "queued"
            ],
            "to": "running",
            "label": "Start"
          },
          {
            "from": [
              "running"
            ],
            "to": "passed",
            "label": "Mark passed"
          },
          {
            "from": [
              "running"
            ],
            "to": "failed",
            "label": "Mark failed"
          },
          {
            "from": [
              "queued",
              "running"
            ],
            "to": "cancelled",
            "label": "Cancel"
          },
          {
            "from": [
              "failed",
              "cancelled"
            ],
            "to": "queued",
            "label": "Queue again",
            "roles": [
              "owner"
            ]
          }
        ]
      }
    },
    {
      "name": "releases",
      "label": "Releases",
      "role": "source",
      "scope": "workspace",
      "list_columns": [
        "project",
        "version",
        "stage"
      ],
      "fields": [
        {
          "name": "project",
          "label": "Project",
          "type": "reference",
          "to": "projects",
          "required": true
        },
        {
          "name": "version",
          "label": "Version",
          "type": "text",
          "max_length": 40,
          "copyable": true
        },
        {
          "name": "stage",
          "label": "Stage",
          "type": "enum",
          "options": [
            {
              "value": "draft",
              "label": "Draft"
            },
            {
              "value": "candidate",
              "label": "Candidate"
            },
            {
              "value": "released",
              "label": "Released"
            }
          ]
        },
        {
          "name": "service",
          "label": "Service",
          "type": "reference",
          "to": "services"
        },
        {
          "name": "subject",
          "label": "Subject",
          "type": "text",
          "max_length": 120
        },
        {
          "name": "release_on",
          "label": "Release on",
          "type": "date"
        },
        {
          "name": "owner",
          "label": "Owner",
          "type": "text"
        },
        {
          "name": "changelog",
          "label": "Changelog",
          "type": "text",
          "max_length": 20000
        },
        {
          "name": "signing_secret",
          "label": "Signing secret",
          "type": "text",
          "encrypted": true
        }
      ],
      "detail": {
        "header": {
          "subtitle": "owner",
          "badges": [
            {
              "field": "stage",
              "colors": {
                "draft": "neutral",
                "candidate": "info",
                "released": "success"
              }
            }
          ],
          "facts": [
            {
              "field": "project"
            },
            {
              "field": "version"
            },
            {
              "field": "owner"
            },
            {
              "field": "service"
            },
            {
              "field": "release_on",
              "label": "Ships"
            }
          ]
        },
        "tabs": [
          {
            "label": "Overview",
            "sections": [
              {
                "title": "Release",
                "columns": 2,
                "fields": [
                  "project",
                  "version",
                  "stage",
                  "owner",
                  "service",
                  "subject",
                  "release_on"
                ]
              },
              {
                "title": "Changelog",
                "columns": 1,
                "fields": [
                  "changelog"
                ],
                "empty": "No changelog yet."
              },
              {
                "title": "Builds of this project",
                "related": {
                  "area": "builds",
                  "via": "project",
                  "match_field": "project",
                  "columns": [
                    {
                      "field": "status",
                      "label": "Build status"
                    },
                    "branch",
                    {
                      "field": "started",
                      "label": "Built on"
                    },
                    {
                      "field": "duration",
                      "label": "Took"
                    }
                  ],
                  "sort": {
                    "field": "started",
                    "direction": "desc"
                  },
                  "limit": 5
                },
                "empty": "No builds of this release's project yet."
              }
            ]
          },
          {
            "label": "History",
            "sections": [
              {
                "title": "Changes",
                "history": {},
                "empty": "No changes recorded yet."
              }
            ]
          }
        ],
        "unplaced": "hide",
        "notices": [
          {
            "when": {
              "field": "stage",
              "equals": "released"
            },
            "tone": "success",
            "title": "Released",
            "text": "This release is out: its builds and changelog are final."
          },
          {
            "when": {
              "all": [
                {
                  "field": "stage",
                  "not_in": [
                    "released"
                  ]
                },
                {
                  "field": "release_on",
                  "before": "today"
                }
              ]
            },
            "tone": "danger",
            "title": "Past its release date",
            "text": "It was due to ship before today and has not been released."
          },
          {
            "when": {
              "all": [
                {
                  "field": "stage",
                  "equals": "candidate"
                },
                {
                  "field": "release_on",
                  "within_days": 7
                }
              ]
            },
            "tone": "warning",
            "title": "Ships within a week",
            "text": "A candidate due within seven days: finish its sign-off."
          },
          {
            "when": {
              "clock": "signoff",
              "is": "overdue"
            },
            "tone": "danger",
            "title": "Sign-off overdue",
            "text": "No one has signed this release off within five days."
          },
          {
            "when": {
              "any": [
                {
                  "clock": "signoff",
                  "is": "due_soon"
                },
                {
                  "field": "owner",
                  "empty": true
                }
              ]
            },
            "tone": "info",
            "text": "Sign-off is due soon, or nobody owns this release yet."
          }
        ],
        "actions": [
          {
            "kind": "start_run",
            "place": "primary",
            "label": "Scan service",
            "job_kind": "scan",
            "target": {
              "via": "service"
            }
          },
          {
            "kind": "link",
            "place": "secondary",
            "field": "subject",
            "label": "Open subject"
          },
          {
            "kind": "link",
            "field": "project",
            "label": "Open project"
          },
          {
            "kind": "copy_link"
          }
        ]
      },
      "links": [
        {
          "field": "subject",
          "area": "builds"
        },
        {
          "field": "subject",
          "area": "environments"
        }
      ],
      "clocks": [
        {
          "name": "signoff",
          "label": "Sign-off",
          "starts": {
            "event": "created"
          },
          "after": "5d",
          "soon": "2d"
        }
      ]
    },
    {
      "name": "services",
      "label": "Services",
      "role": "asset",
      "scope": "workspace",
      "list_columns": [
        "endpoint",
        "owner"
      ],
      "fields": [
        {
          "name": "endpoint",
          "label": "Endpoint",
          "type": "url",
          "required": true
        },
        {
          "name": "owner",
          "label": "Owner",
          "type": "text"
        }
      ]
    }
  ],
  "job_kinds": [
    {
      "name": "build",
      "label": "Build a project",
      "description": "Builds a project's branch and runs its tests.",
      "runner": "agent-workspace",
      "args": [
        {
          "name": "project",
          "label": "Project",
          "type": "reference",
          "to": "projects",
          "required": true
        },
        {
          "name": "branch",
          "label": "Branch",
          "type": "text",
          "required": true,
          "max_length": 200
        }
      ],
      "budget_usd": 2,
      "token_lifetime_seconds": 1800,
      "agent": {
        "repository": "https://git.example.com/agents/fixture-builder.git",
        "commit": "0123456789abcdef0123456789abcdef01234567",
        "command": [
