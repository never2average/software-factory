{
  "$schema": "../../../../packs/pack.schema.json",
  "$comment": "mold_v0-261 fixture (redesigned by mold_v0-267): agent profiles. A pack that brings an agent profile (builder: its harness, its primary inference provider's model and its governance policy) and starts it from a record's page (Build) and from its list (Plan an application). For the agent-profile proofs and screenshots, with features.agent_harness on.",
  "id": "fixture_agent",
  "name": "Fixture agent",
  "version": "0.1.0",
  "description": "Applications a workspace asks its agent to build.",
  "record_areas": [
    {
      "name": "applications",
      "label": "Applications",
      "role": "source",
      "scope": "workspace",
      "key_from_title": true,
      "fields": [
        {
          "name": "summary",
          "label": "Summary",
          "type": "text",
          "max_length": 500
        },
        {
          "name": "stack",
          "label": "Stack",
          "type": "enum",
          "options": [
            {
              "value": "typescript",
              "label": "TypeScript"
            },
            {
              "value": "python",
              "label": "Python"
            },
            {
              "value": "go",
              "label": "Go"
            }
          ]
        },
        {
          "name": "status",
          "label": "Status",
          "type": "enum",
          "options": [
            {
              "value": "idea",
              "label": "Idea"
            },
            {
              "value": "building",
              "label": "Building"
            },
            {
              "value": "live",
              "label": "Live"
            }
          ]
        },
        {
          "name": "owner",
          "label": "Owner",
          "type": "text"
        },
        {
          "name": "brief",
          "label": "Brief",
          "type": "text",
          "max_length": 4000
        }
      ],
      "detail": {
        "header": {
          "subtitle": "summary",
          "badges": [
            {
              "field": "status",
              "colors": {
                "idea": "neutral",
                "building": "info",
                "live": "success"
              }
            }
          ],
          "facts": [
            {
              "field": "stack"
            },
            {
              "field": "owner"
            }
          ]
        },
        "tabs": [
          {
            "label": "Overview",
            "sections": [
              {
                "title": "About",
                "columns": 2,
                "fields": [
                  "summary",
                  "stack",
                  "owner",
                  "brief"
                ]
              },
              {
                "title": "Runs and agent sessions",
                "runs": {},
                "empty": "Nothing has run on it yet: Build starts the agent on it."
              }
            ]
          }
        ],
        "actions": [
          {
            "kind": "start_agent",
            "place": "primary",
            "label": "Build",
            "profile": "builder",
            "first_message": "Build the application {{title}} ({{key}}) on {{stack}}.\n\nWhat it is: {{summary}}\n\nThe brief: {{brief}}"
          },
          {
            "kind": "edit",
            "place": "secondary"
          },
          {
            "kind": "copy_link"
          }
        ]
      }
    }
  ],
  "tabs": [
    {
      "id": "applications",
      "kind": "area",
      "area": "applications",
      "icon": "rocket",
      "group": "Build",
      "charts": [],
      "views": [
        "table"
      ],
      "action": {
        "kind": "start_agent",
        "label": "Plan an application",
        "profile": "builder",
        "first_message": "Plan a new application with me: ask what it should do first."
      }
    }
  ],
  "agent_profiles": [
    {
      "id": "builder",
      "name": "Build an application",
      "description": "Builds an application from its record: plans first, then writes the code in its workspace and reports what it made.",
      "harness": "claude-code",
      "inference": {
        "provider": "anthropic",
        "model": "claude-sonnet-5-5"
      },
      "governance": {
        "egress_approvals": true,
        "web": {
          "enabled": true,
          "web_search_enabled": false,
          "web_fetch_enabled": true,
          "web_fetch_allowed_domains": [
            "docs.example.com",
            "*.example.org"
          ],
          "max_calls": 20
        },
        "tools": {
          "allowed": [
            "fixture_agent_create_applications",
            "fixture_agent_update_applications"
          ],
          "max_calls": 50
        },
        "retention_days": 30
      }
    }
  ]
}
