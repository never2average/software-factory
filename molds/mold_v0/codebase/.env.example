# Copy to .env. Defaults match `docker compose up`.
# Leave DATABASE_URL unset to use the embedded PGlite database in .pglite/ (local dev only).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app

# Raw agent transcripts (JSONL) + full-text search. Leave CLICKHOUSE_URL unset to keep transcripts in Postgres (dev only).
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=app
CLICKHOUSE_PASSWORD=app
CLICKHOUSE_DATABASE=app   # the local stack's; unset, the build's namespace (src/namespace.ts)
# ClickHouse Cloud: CLICKHOUSE_URL=https://<service>.<region>.<provider>.clickhouse.cloud:8443 and keep credentials
# in the gitignored clickhouse_credentials.txt ("Username: ..." / "Password: ..."):
# CLICKHOUSE_CREDENTIALS_FILE=clickhouse_credentials.txt

# HTTP server
PORT=3333
# HOST=0.0.0.0                       # in a container / behind a proxy
# PUBLIC_URL=https://app.example.com   # used in printed connector URLs and error messages

# Orchestrator worker API: shared secret for /api/worker/* (unset = worker API disabled)
APP_WORKER_TOKEN=change-me
# APP_LEASE_MINUTES=30         # running sessions without a heartbeat for this long are timed out

# Worker agents customers can launch: harnesses/registry.json (harness, model, pinned image, adoption weight).
# APP_REGISTRY=harnesses/registry.json
# APP_DEFAULT_SAMPLES=10       # representative runs: sessions per scenario, mixed by adoption weight
# APP_SANDBOX_UNIT=20          # running mix in whole sandboxes; N orchestrators run N x this unit
# APP_MIN_ONE_SANDBOX=0        # seed populations with honest rounding instead of >= 1 sandbox per running agent (default: min one)
# Without a registry file, agents fall back to these (equal weights):
# APP_MODELS=claude-sonnet-5-5,claude-opus-5-5
# APP_HARNESS=claude-code
APP_MAX_SESSIONS_PER_RUN=100

# Landing page access requests: optional Slack-compatible incoming webhook
# ACCESS_REQUEST_WEBHOOK_URL=https://hooks.slack.com/services/...

# Local widget preview at /preview/<tool>?key=<api key> (never enable in production)
# APP_PREVIEW=1
# Vault (a host pack's curated developer tasks + profiles): npm run pack:run -- vault-sync
# VAULT_URL=https://vault.internal
# VAULT_TOKEN=
# VAULT_DIR=packs/<pack>/vault/example
# APP_MAX_USER_TURNS=5   # questions the simulated developer answers per session

# Fleet: each orchestrator runs up to this many warm pods; the server plans the global usage-proportional mix
# APP_PODS_PER_ORCHESTRATOR=20
# APP_FLEET_STALE_SECONDS=90

# Key vault + inference gateway (docs/credentials.md). Generate: npm run keyvault -- gen-master-key
APP_VAULT_KEY=
# APP_VAULT_KEY_PREVIOUS=        # during master-key rotation, then: npm run keyvault -- rekey
# Admin API for scripts: no static token; mint one with `npm run admin:token -- create --label <purpose> --role <role>`
# CRON_SECRET=                         # Vercel sends it to /api/cron/autoscale (the only thing that opens the cron)
# APP_GATEWAY_MAX_REQUESTS=1000 # per session
# APP_GATEWAY_MAX_TOKENS=5000000

# ---------- Sign-in (mold_v0-004, docs/accounts.md "Sign-in: built-in or Clerk") ----------
# AUTH_PROVIDER=builtin                 # builtin or clerk; unset: clerk when CLERK_SECRET_KEY is set, else builtin
# Built-in: an emailed code (needs Resend connected in Key vault and emails on) and, with both set, Google.
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=...
# GOOGLE_REDIRECT_URI=https://console.example.com/api/auth/google/callback   # default: /api/auth/google/callback on the browser's origin
# APP_CONSOLE_URL=https://console.example.com    # the console's address when it is not PUBLIC_URL (two Vercel projects)
# APP_SESSION_DAYS=14
# APP_AUTH_SECRET=                # optional: the key sign-in codes are kept under (default: derived from APP_VAULT_KEY)

# ---------- Onboarding: people in Clerk, money in Stripe (docs/accounts.md) ----------
# Clerk (AUTH_PROVIDER=clerk): users, organizations, roles, invitations, sign-in (passwords, Google, Microsoft, GitHub) and OAuth on /mcp.
# CLERK_SECRET_KEY=sk_test_...
# CLERK_PUBLISHABLE_KEY=pk_test_...                   # names Clerk's Frontend API (the OAuth server); NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY also works
# CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\n..."      # optional: verify session tokens without calling Clerk (Dashboard → API keys)
# CLERK_AUTHORIZED_PARTIES=https://app.example.com   # origins allowed to mint session tokens (default: PUBLIC_URL's origin)
# CLERK_MCP_AUDIENCE=                                 # resource in the protected-resource metadata; default $PUBLIC_URL/mcp
# Stripe: plans are active prices whose lookup_key starts with the build's namespace and _ (src/namespace.ts KEY_PREFIX); metadata.monthly_budget_usd caps model spend.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_SPEND_METER=workspace_model_spend            # optional: report each session's model cost (cents) for usage-based prices
# APP_REQUIRE_SUBSCRIPTION=1                    # refuse new simulations without an active or trialing plan
# APP_ORG_MONTHLY_BUDGET_USD=1000               # budget for orgs whose plan sets none (and when Stripe is off)

# ---------- Analytics (PostHog) and observability (OpenTelemetry -> New Relic) ----------
# POSTHOG_API_KEY=phc_...
# POSTHOG_HOST=https://us.i.posthog.com
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.nr-data.net
# OTEL_EXPORTER_OTLP_HEADERS=api-key=<New Relic ingest license key>
# OTEL_SERVICE_NAME=workspace   # default: the build's namespace
# OTEL_DEPLOYMENT_ENV=production

# ---------- Platform admins (/admin) and journeys ----------
# APP_PLATFORM_ADMINS=you@company.com,*@company.com   # Clerk-verified addresses or domains that may use /admin
# APP_JOURNEY_SECRET=                              # PostHog Workflows webhook secret (docs/journeys.md)
# APP_NUDGE_INTERVAL_HOURS=20                      # at most one in-chat tip per person per interval
# Links from /admin Analytics to the systems of record for analytics and traces.
# POSTHOG_PROJECT_URL=https://us.posthog.com/project/<id>
# NEW_RELIC_DASHBOARD_URL=https://one.newrelic.com/...
# APP_URL_KEYS=allow             # off refuses connector API keys in the URL (/mcp/oct_...); keys go in a header
# APP_OAUTH_AUDIENCE=auto        # enforce: refuse OAuth tokens that name no audience; report: refuse none (src/clerk.ts)
