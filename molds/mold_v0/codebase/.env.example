# Copy to .env. Defaults match `docker compose up`.
# Leave DATABASE_URL unset to use the embedded PGlite database in .pglite/ (local dev only).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/octillion

# Raw agent transcripts (JSONL) + full-text search. Leave CLICKHOUSE_URL unset to keep transcripts in Postgres (dev only).
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=octillion
CLICKHOUSE_PASSWORD=octillion
# CLICKHOUSE_DATABASE=octillion
# ClickHouse Cloud: CLICKHOUSE_URL=https://<service>.<region>.<provider>.clickhouse.cloud:8443 and keep credentials
# in the gitignored clickhouse_credentials.txt ("Username: ..." / "Password: ..."):
# CLICKHOUSE_CREDENTIALS_FILE=clickhouse_credentials.txt

# HTTP server
PORT=3333
# HOST=0.0.0.0                       # in a container / behind a proxy
# PUBLIC_URL=https://octillion.example.com   # used in printed connector URLs and error messages

# Orchestrator worker API: shared secret for /api/worker/* (unset = worker API disabled)
OCTILLION_WORKER_TOKEN=change-me
# OCTILLION_LEASE_MINUTES=30         # running sessions without a heartbeat for this long are timed out

# Worker agents customers can launch: harnesses/registry.json (harness, model, pinned image, adoption weight).
# OCTILLION_REGISTRY=harnesses/registry.json
# OCTILLION_DEFAULT_SAMPLES=10       # representative runs: sessions per scenario, mixed by adoption weight
# OCTILLION_SANDBOX_UNIT=20          # running mix in whole sandboxes; N orchestrators run N x this unit
# OCTILLION_MIN_ONE_SANDBOX=0        # seed populations with honest rounding instead of >= 1 sandbox per running agent (default: min one)
# Without a registry file, agents fall back to these (equal weights):
# OCTILLION_MODELS=claude-sonnet-5-5,claude-opus-5-5
# OCTILLION_HARNESS=claude-code
OCTILLION_MAX_SESSIONS_PER_RUN=100

# Landing page access requests: optional Slack-compatible incoming webhook
# ACCESS_REQUEST_WEBHOOK_URL=https://hooks.slack.com/services/...

# Local widget preview at /preview/<tool>?key=<api key> (never enable in production)
# OCTILLION_PREVIEW=1
# Vault (a host pack's curated developer tasks + profiles): npm run pack:run -- vault-sync
# VAULT_URL=https://vault.internal
# VAULT_TOKEN=
# VAULT_DIR=packs/octillion/vault/example
# OCTILLION_MAX_USER_TURNS=5   # questions the simulated developer answers per session

# Fleet: each orchestrator runs up to this many warm pods; the server plans the global usage-proportional mix
# OCTILLION_PODS_PER_ORCHESTRATOR=20
# OCTILLION_FLEET_STALE_SECONDS=90

# Key vault + inference gateway (docs/credentials.md). Generate: npm run keyvault -- gen-master-key
OCTILLION_VAULT_KEY=
# OCTILLION_VAULT_KEY_PREVIOUS=        # during master-key rotation, then: npm run keyvault -- rekey
# Admin API for scripts: no static token; mint one with `npm run admin:token -- create --label <purpose> --role <role>`
# CRON_SECRET=                         # Vercel sends it to /api/cron/autoscale (the only thing that opens the cron)
# OCTILLION_GATEWAY_MAX_REQUESTS=1000 # per session
# OCTILLION_GATEWAY_MAX_TOKENS=5000000

# ---------- Onboarding: people in Clerk, money in Stripe (docs/accounts.md) ----------
# Clerk: users, organizations, roles, invitations, sign-in (passwords, Google, Microsoft, GitHub) and OAuth on /mcp.
# Unset = per-org API keys only (npm run org:create).
# CLERK_SECRET_KEY=sk_test_...
# CLERK_PUBLISHABLE_KEY=pk_test_...                   # names Clerk's Frontend API (the OAuth server); NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY also works
# CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\n..."      # optional: verify session tokens without calling Clerk (Dashboard → API keys)
# CLERK_AUTHORIZED_PARTIES=https://octillion.example.com   # origins allowed to mint session tokens (default: PUBLIC_URL's origin)
# CLERK_MCP_AUDIENCE=                                 # resource in the protected-resource metadata; default $PUBLIC_URL/mcp
# Stripe: plans are active prices whose lookup_key starts with octillion_; metadata.monthly_budget_usd caps model spend.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_SPEND_METER=octillion_model_spend            # optional: report each session's model cost (cents) for usage-based prices
# OCTILLION_REQUIRE_SUBSCRIPTION=1                    # refuse new simulations without an active or trialing plan
# OCTILLION_ORG_MONTHLY_BUDGET_USD=1000               # budget for orgs whose plan sets none (and when Stripe is off)

# ---------- Analytics (PostHog) and observability (OpenTelemetry -> New Relic) ----------
# POSTHOG_API_KEY=phc_...
# POSTHOG_HOST=https://us.i.posthog.com
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.nr-data.net
# OTEL_EXPORTER_OTLP_HEADERS=api-key=<New Relic ingest license key>
# OTEL_SERVICE_NAME=octillion
# OTEL_DEPLOYMENT_ENV=production

# ---------- Platform admins (/admin) and journeys ----------
# OCTILLION_PLATFORM_ADMINS=you@company.com,*@company.com   # Clerk-verified addresses or domains that may use /admin
# OCTILLION_JOURNEY_SECRET=                              # PostHog Workflows webhook secret (docs/journeys.md)
# OCTILLION_NUDGE_INTERVAL_HOURS=20                      # at most one in-chat tip per person per interval
# Links from /admin Analytics to the systems of record for analytics and traces.
# POSTHOG_PROJECT_URL=https://us.posthog.com/project/<id>
# NEW_RELIC_DASHBOARD_URL=https://one.newrelic.com/...
# OCTILLION_URL_KEYS=allow             # off refuses connector API keys in the URL (/mcp/oct_...); keys go in a header
# OCTILLION_OAUTH_AUDIENCE=auto        # enforce: refuse OAuth tokens that name no audience; report: refuse none (src/clerk.ts)
