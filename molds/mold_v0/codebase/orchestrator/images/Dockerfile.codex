# Octillion worker image: OpenAI Codex CLI.
# Build: orchestrator/images/build.sh codex   (or see the docker build line in README.md)
# Neutral base: node 22, python 3, git, build tools. No dev-tool SDKs, no CLAUDE.md/AGENTS.md, no MCP config.
FROM node:22-bookworm

ARG HARNESS_VERSION=0.162.1

RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      git curl ca-certificates jq ripgrep less procps unzip build-essential \
      python3 python3-pip python3-venv python-is-python3 \
 && rm -rf /var/lib/apt/lists/*

RUN npm install -g "@openai/codex@${HARNESS_VERSION}" \
 && npm cache clean --force \
 && codex --version

# Non-root user; CODEX_HOME is the per-session config dir (kept empty).
RUN useradd -m -s /bin/bash agent \
 && mkdir -p /home/agent/work /home/agent/.npm-global /home/agent/.codex \
 && chown -R agent:agent /home/agent
USER agent
ENV HOME=/home/agent \
    NPM_CONFIG_PREFIX=/home/agent/.npm-global \
    PATH=/home/agent/.npm-global/bin:/home/agent/.local/bin:$PATH \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    CODEX_HOME=/home/agent/.codex
# Metadata as labels, not env: env would be visible to the agent and leak context into its session.
LABEL dev.octillion.harness="codex" \
      dev.octillion.harness_version="${HARNESS_VERSION}"
WORKDIR /home/agent/work
# Healthcheck prints the harness version (docker inspect --format '{{json .State.Health}}' <c>).
HEALTHCHECK --interval=5m --timeout=30s --start-period=30s --start-interval=5s --retries=2 CMD codex --version || exit 1
# Warm pod: idle until the worker runs the harness with `docker exec -u agent -e KEY=... <c> <cli> ...`.
# No API keys are baked in; they are passed at exec time.
CMD ["sleep", "infinity"]
