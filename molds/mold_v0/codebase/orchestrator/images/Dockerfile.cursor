# Worker image: Cursor CLI (`cursor-agent`, also installed as `agent`).
# Cursor publishes no npm package. Its official installer (https://cursor.com/install) downloads
# https://downloads.cursor.com/lab/<version>/linux/<x64|arm64>/agent-cli-package.tar.gz.
# We fetch that same tarball directly so the version is pinned (the installer always takes the latest).
# Neutral base: node 22, python 3, git, build tools. No dev-tool SDKs, no rules files, no MCP config.
FROM node:22-bookworm

ARG HARNESS_VERSION=2026.10.01-e373342

RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      git curl ca-certificates jq ripgrep less procps unzip build-essential \
      python3 python3-pip python3-venv python-is-python3 \
 && rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    case "$(uname -m)" in x86_64|amd64) arch=x64;; aarch64|arm64) arch=arm64;; *) echo "unsupported arch"; exit 1;; esac; \
    mkdir -p "/opt/cursor-agent/${HARNESS_VERSION}"; \
    curl -fsSL "https://downloads.cursor.com/lab/${HARNESS_VERSION}/linux/${arch}/agent-cli-package.tar.gz" \
      | tar --strip-components=1 -xzf - -C "/opt/cursor-agent/${HARNESS_VERSION}"; \
    ln -s "/opt/cursor-agent/${HARNESS_VERSION}/cursor-agent" /usr/local/bin/cursor-agent; \
    ln -s "/opt/cursor-agent/${HARNESS_VERSION}/cursor-agent" /usr/local/bin/agent; \
    cursor-agent --version

# Non-root user. npm global prefix in $HOME so the agent can `npm i -g` without sudo.
RUN useradd -m -s /bin/bash agent \
 && mkdir -p /home/agent/work /home/agent/.npm-global \
 && chown -R agent:agent /home/agent
USER agent
ENV HOME=/home/agent \
    NPM_CONFIG_PREFIX=/home/agent/.npm-global \
    PATH=/home/agent/.npm-global/bin:/home/agent/.local/bin:$PATH \
    PIP_BREAK_SYSTEM_PACKAGES=1
# Metadata as labels, not env: env would be visible to the agent and leak context into its session.
LABEL dev.app.harness="cursor" \
      dev.app.harness_version="${HARNESS_VERSION}"
WORKDIR /home/agent/work
# Healthcheck prints the harness version (docker inspect --format '{{json .State.Health}}' <c>).
HEALTHCHECK --interval=5m --timeout=30s --start-period=30s --start-interval=5s --retries=2 CMD cursor-agent --version || exit 1
# Warm pod: idle until the worker runs the harness with `docker exec -u agent -e KEY=... <c> <cli> ...`.
# No API keys are baked in; they are passed at exec time.
CMD ["sleep", "infinity"]
