{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "vercel-static",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.ts": {
      "includeFiles": "{public/**,sql/**,packs/**,harnesses/**,src/**,orchestrator/**}",
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/autoscale",
      "schedule": "*/5 * * * *"
    }
  ]
}
