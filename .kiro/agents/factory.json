{
  "name": "factory",
  "description": "Runs the software factory: AGENTS.md, the skills in .kiro/skills, and the same allow/ask split as .claude/settings.json. Use with: kiro-cli chat --agent factory",
  "tools": [
    "*"
  ],
  "permissions": {
    "rules": [
      {
        "capability": "shell",
        "match": [
          "python3 .claude/scripts/factory.py doctor*",
          "python3 .claude/scripts/factory.py status*",
          "python3 .claude/scripts/factory.py tasks*",
          "python3 .claude/scripts/factory.py next*",
          "python3 .claude/scripts/factory.py validate*",
          "python3 .claude/scripts/mint.py *",
          "python3 .claude/scripts/provision.py * --json",
          "python3 .claude/scripts/provision.py * status*",
          "python3 .claude/scripts/provision.py * --capacity*",
          "python3 .claude/scripts/provision.py * --dry-run*",
          "python3 .claude/scripts/lanes.py * --list*",
          "python3 .claude/scripts/lanes.py * --dry-run*",
          "python3 .claude/scripts/lanes.py * status*",
          "python3 .claude/scripts/repo.py * status*",
          "python3 .claude/scripts/mold.py check *",
          "python3 .claude/scripts/mold.py fetch *",
          "python3 .claude/scripts/packs.py list*",
          "python3 .claude/scripts/packs.py show *",
          "python3 .claude/scripts/packs.py check *",
          "python3 .claude/scripts/packs.py verify *",
          "python3 .claude/scripts/branding.py * show*",
          "python3 .claude/scripts/branding.py * preview*",
          "python3 .claude/scripts/branding.py * check*",
          "python3 .claude/scripts/domain.py * status*",
          "python3 .claude/scripts/domain.py * verify*",
          "python3 .claude/scripts/agent_cli.py * status*",
          "python3 .claude/scripts/library.py * show*",
          "python3 .claude/scripts/clone.py * plan*",
          "python3 .claude/scripts/app_usage.py *",
          "python3 .claude/scripts/mint_report.py *",
          "python3 .agents/scripts/factory.py doctor*",
          "python3 .agents/scripts/factory.py status*",
          "python3 .agents/scripts/factory.py tasks*",
          "python3 .agents/scripts/factory.py next*",
          "python3 .agents/scripts/factory.py validate*",
          "python3 .agents/scripts/mint.py *",
          "python3 .agents/scripts/provision.py * --json",
          "python3 .agents/scripts/provision.py * status*",
          "python3 .agents/scripts/provision.py * --capacity*",
          "python3 .agents/scripts/provision.py * --dry-run*",
          "python3 .agents/scripts/lanes.py * --list*",
          "python3 .agents/scripts/lanes.py * --dry-run*",
          "python3 .agents/scripts/lanes.py * status*",
          "python3 .agents/scripts/repo.py * status*",
          "python3 .agents/scripts/mold.py check *",
          "python3 .agents/scripts/mold.py fetch *",
          "python3 .agents/scripts/packs.py list*",
          "python3 .agents/scripts/packs.py show *",
          "python3 .agents/scripts/packs.py check *",
          "python3 .agents/scripts/packs.py verify *",
          "python3 .agents/scripts/branding.py * show*",
          "python3 .agents/scripts/branding.py * preview*",
          "python3 .agents/scripts/branding.py * check*",
          "python3 .agents/scripts/domain.py * status*",
          "python3 .agents/scripts/domain.py * verify*",
          "python3 .agents/scripts/agent_cli.py * status*",
          "python3 .agents/scripts/library.py * show*",
          "python3 .agents/scripts/clone.py * plan*",
          "python3 .agents/scripts/app_usage.py *",
          "python3 .agents/scripts/mint_report.py *"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "python3 .claude/scripts/mint.py * run*",
          "python3 .claude/scripts/mint.py * reuse-keys*",
          "python3 .claude/scripts/mint.py * code-request*",
          "python3 .claude/scripts/mint.py * code *",
          "python3 .claude/scripts/provision.py * --deploy*",
          "python3 .claude/scripts/provision.py * --set-secret*",
          "python3 .claude/scripts/provision.py * --verify-db*",
          "python3 .claude/scripts/provision.py * --verify-rls*",
          "python3 .claude/scripts/provision.py * --apply*",
          "python3 .claude/scripts/provision.py * --tunnel-remote*",
          "python3 .claude/scripts/lanes.py * --apply*",
          "python3 .claude/scripts/repo.py * publish*",
          "python3 .claude/scripts/repo.py * push*",
          "python3 .claude/scripts/repo.py * unlink*",
          "python3 .claude/scripts/repo.py * auto-push*",
          "python3 .claude/scripts/domain.py * attach*",
          "python3 .claude/scripts/domain.py * switch*",
          "python3 .claude/scripts/agent_cli.py * publish*",
          "python3 .claude/scripts/library.py * --apply*",
          "python3 .claude/scripts/clone.py * run*",
          "python3 .claude/scripts/clone.py * snapshot*",
          "python3 .claude/scripts/clone.py * configure*",
          "python3 .claude/scripts/workspace.py *",
          "python3 .claude/scripts/mold.py refresh *",
          "python3 .agents/scripts/mint.py * run*",
          "python3 .agents/scripts/mint.py * reuse-keys*",
          "python3 .agents/scripts/mint.py * code-request*",
          "python3 .agents/scripts/mint.py * code *",
          "python3 .agents/scripts/provision.py * --deploy*",
          "python3 .agents/scripts/provision.py * --set-secret*",
          "python3 .agents/scripts/provision.py * --verify-db*",
          "python3 .agents/scripts/provision.py * --verify-rls*",
          "python3 .agents/scripts/provision.py * --apply*",
          "python3 .agents/scripts/provision.py * --tunnel-remote*",
          "python3 .agents/scripts/lanes.py * --apply*",
          "python3 .agents/scripts/repo.py * publish*",
          "python3 .agents/scripts/repo.py * push*",
          "python3 .agents/scripts/repo.py * unlink*",
          "python3 .agents/scripts/repo.py * auto-push*",
          "python3 .agents/scripts/domain.py * attach*",
          "python3 .agents/scripts/domain.py * switch*",
          "python3 .agents/scripts/agent_cli.py * publish*",
          "python3 .agents/scripts/library.py * --apply*",
          "python3 .agents/scripts/clone.py * run*",
          "python3 .agents/scripts/clone.py * snapshot*",
          "python3 .agents/scripts/clone.py * configure*",
          "python3 .agents/scripts/workspace.py *",
          "python3 .agents/scripts/mold.py refresh *",
          "git push --force*",
          "git push -f*",
          "git push * --force*",
          "git push * -f*",
          "git push * +*",
          "npm publish*",
          "gh repo create*",
          "gh repo delete*",
          "vercel --prod*",
          "vercel * --prod*",
          "vercel deploy*",
          "vercel remove*",
          "vercel rm*",
          "vercel project rm*"
        ],
        "effect": "ask"
      }
    ]
  }
}
