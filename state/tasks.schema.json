{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tasks.schema.json",
  "title": "Task",
  "description": "One line of state/tasks/<mold_id>.jsonl. The factory operator (Fable + sol) picks tasks by mold and priority; a task closes with evidence.",
  "type": "object",
  "required": [
    "task_id",
    "mold_id",
    "title",
    "type",
    "status",
    "priority",
    "owner"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+-[0-9]{3}$"
    },
    "mold_id": {
      "type": "string"
    },
    "product_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "detail": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "build",
        "harden",
        "test",
        "infra",
        "docs",
        "productize",
        "research"
      ]
    },
    "lane": {
      "type": "string",
      "enum": [
        "load",
        "context",
        "functional",
        "accessibility",
        "responsiveness"
      ]
    },
    "capability": {
      "type": "string",
      "description": "For mold_v2/v3: which capability from factory.json this task delivers"
    },
    "status": {
      "type": "string",
      "enum": [
        "todo",
        "in_progress",
        "blocked",
        "review",
        "done",
        "dropped",
        "parked"
      ],
      "description": "parked: kept for later by the operator; not open work (hidden from tasks and the board until set back to todo)"
    },
    "priority": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3,
      "description": "1 = do next"
    },
    "owner": {
      "type": "string",
      "enum": [
        "fable",
        "sol",
        "unassigned"
      ]
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "description": "Commits, PR urls, report paths that closed the task",
      "items": {
        "type": "string"
      }
    },
    "advances_stage": {
      "type": "string",
      "enum": [
        "defined",
        "stamped",
        "lanes_passing",
        "deployed",
        "released"
      ]
    },
    "created": {
      "type": "string",
      "format": "date"
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "train": {
      "type": "string",
      "description": "The build train this ticket runs on (sweep.py): a train runs sweep.builders_per_train builders at once, in priority and depends_on order. Without it: state/factory.json sweep.trains, else the mold."
    },
    "gate": {
      "type": [
        "string",
        "object"
      ],
      "description": "Holds the ticket back from the sweep until the operator lifts it: a kind (dated_decision, operator_action, live_data_migration) or {\"kind\", \"until\" (YYYY-MM-DD), \"why\"}. Remove it to release the ticket."
    }
  }
}
