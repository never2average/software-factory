{
  "$schema": "./factory.schema.json",
  "factory_id": "factory_1",
  "operator": {
    "model": "fable",
    "human_role": "sol"
  },
  "service_surface": [
    {
      "name": "dm.md"
    },
    {
      "name": "browser",
      "optional": true,
      "flag": "ENABLE_BROWSER"
    },
    {
      "name": "web_search",
      "optional": true,
      "flag": "ENABLE_WEB_SEARCH"
    },
    {
      "name": "primary_context"
    },
    {
      "name": "multiplayer_context"
    },
    {
      "name": "custom_workflow_builder"
    }
  ],
  "molds": [
    {
      "mold_id": "mold_v0",
      "status": "wip",
      "definition": "the operator's existing MCP product pinned as-is (clone first, generalise after): stateless MCP endpoint, hashed per-organisation keys, admin console, client install pages, onboarding, usage analytics, key vault, billing and email; to become a general MCP product shell step by step (molds/mold_v0/MOLD.md)",
      "target_model": "none (proxies the upstream MCP server; runs no model)",
      "capabilities": [
        "install_pages",
        "generated_docs",
        "playground",
        "onboarding",
        "metering_gateway",
        "usage_tracking",
        "credential_vault",
        "mcp_oauth",
        "admin_console",
        "upstream_health",
        "tool_changelog",
        "billing_hooks",
        "email_notifications"
      ],
      "path": "molds/mold_v0",
      "source": {
        "commit": "5310a514bf491bcb43ed86f3efc7e9f2a5cf3d35",
        "snapshot_date": "2026-10-20"
      }
    },
    {
      "mold_id": "mold_v1",
      "status": "active",
      "definition": "multi-workspace multi-agent claude code web at feature parity application that is purely vanilla and works with GLM 5.2",
      "target_model": "GLM 5.2",
      "capabilities": [],
      "path": "molds/mold_v1",
      "source": {
        "commit": "6dca2d89aeffecc2cc7bd81f294f4d98ff93262e",
        "snapshot_date": "2026-10-20"
      }
    },
    {
      "mold_id": "mold_v2",
      "status": "coming_soon",
      "base": "mold_v1",
      "definition": "mold_v1 with full agent governance, pipeline level data isolation, budget management, and performance governor",
      "target_model": "GLM 5.2",
      "capabilities": [
        "agent_governance",
        "pipeline_data_isolation",
        "budget_management",
        "performance_governor"
      ],
      "path": "molds/mold_v2"
    },
    {
      "mold_id": "mold_v3",
      "status": "coming_soon",
      "base": "mold_v1",
      "definition": "mold_v1 with autoresearch and SAI along with multi-context + multi-role isolation per workflow",
      "target_model": "GLM 5.2",
      "capabilities": [
        "autoresearch",
        "sai",
        "multi_context_isolation",
        "multi_role_isolation"
      ],
      "path": "molds/mold_v3"
    }
  ],
  "loop": {
    "service": "operator->surface->mold",
    "revert": "surface->operator",
    "revert_on": [
      "load",
      "context",
      "functional",
      "accessibility",
      "responsiveness"
    ]
  },
  "applications": [
    "claudecode_web_internal",
    "claudecode_web_replica",
    "sf_gateway_probe",
    "onfinance_hfc",
    "onfinance_hfc_vm",
    "compliance_os"
  ],
  "products": "state/products.json",
  "tasks": "state/tasks/<mold_id>.jsonl",
  "defaults": {
    "confirmed": true,
    "deploy_target": "vercel",
    "secret_store": "vercel_env",
    "postgres_provider": "neon",
    "blob_provider": "vercel_blob",
    "inference_provider": "cloudflare_workers_ai",
    "inference_model": "@cf/zai-org/glm-5.2",
    "sandbox_provider": "vercel_sandbox",
    "vm": {
      "provider": "digitalocean",
      "host": "198.51.100.7",
      "ssh_alias": "digitalocean",
      "cpu": 4,
      "memory_gb": 8,
      "disk_gb": 154,
      "os": "ubuntu-24.04"
    },
    "vercel_team": "your-vercel-team",
    "postgres_scope": "fresh",
    "workspace_name": "OnFinance",
    "operator_email": "operator@example.com",
    "secret_source_project": "live-web",
    "agent_cli_scope": "@onfinance",
    "notify_domain": "example.com"
  }
}
