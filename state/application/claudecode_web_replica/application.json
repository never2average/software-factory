    "custom_workflow_builder": {
      "library": {
        "install": "all"
      },
      "scripts": [],
      "definitions": [
        {
          "id": "pwf_459024e864e6491f84f6ced4afab3517",
          "name": "Default task workflow",
          "entity": "task",
          "is_default": true,
          "stages": [
            {
              "id": "backlog",
              "label": "Backlog",
              "assign": {
                "type": "none"
              },
              "description": "Captured but not yet started.",
              "transitions": [
                {
                  "to": "open",
                  "migrate": {
                    "type": "manual"
                  }
                }
              ]
            },
            {
              "id": "open",
              "label": "Open",
              "assign": {
                "type": "least_loaded"
              },
              "description": "Ready to be picked up.",
              "transitions": [
                {
                  "to": "in_progress",
                  "migrate": {
                    "type": "manual"
                  }
                }
              ]
            },
            {
              "id": "in_progress",
              "label": "In progress",
              "assign": {
                "type": "none"
              },
              "description": "Actively being worked.",
              "transitions": [
                {
                  "to": "blocked",
                  "migrate": {
                    "type": "manual"
                  }
                },
                {
                  "to": "done",
                  "migrate": {
                    "type": "manual"
                  }
                }
              ]
            },
            {
              "id": "blocked",
              "label": "Blocked",
              "assign": {
                "type": "none"
              },
              "description": "Waiting on someone or something.",
              "transitions": [
                {
                  "to": "in_progress",
                  "migrate": {
                    "type": "manual"
                  }
                }
              ]
            },
            {
              "id": "done",
              "label": "Done",
              "assign": {
                "type": "none"
              },
              "description": "Completed and verified.",
              "transitions": []
            }
          ]
        }
      ]
    }
  },
