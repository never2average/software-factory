{
  "$schema": "../app_id/datastores.schema.json",
  "postgres": {
    "provider": "supabase",
    "orm": "drizzle",
    "migrations_dir": "drizzle/",
    "rls": "fail_closed",
    "tenancy": "multi_org",
    "url_ref": "DATABASE_URL",
    "scope": "fresh",
    "snapshot": {
      "source": "live_fde_agent",
      "ref": "fde-agent",
      "method": "pg_dump"
    }
  },
  "blob": {
    "provider": "vercel_blob",
    "root_prefix": "orgs/org-onfinance-ai",
    "token_ref": "BLOB_READ_WRITE_TOKEN",
    "snapshot": {
      "source": "live_fde_agent",
      "ref": "fde-agent"
    }
  },
  "cache": {
    "provider": "none"
  },
  "memory": {
    "backend": "postgres"
  }
}
