{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "infrastructure.schema.json",
  "title": "Infrastructure",
  "description": "Where the application runs. Targets map to infra/vercel and infra/vm.",
  "type": "object",
  "required": [
    "target"
  ],
  "properties": {
    "target": {
      "type": "string",
      "enum": [
        "vercel",
        "vm"
      ]
    },
    "vercel": {
      "type": "object",
      "properties": {
        "team": {
          "type": "string"
        },
        "project": {
          "type": "string"
        },
        "production_url": {
          "type": "string",
          "format": "uri"
        },
        "custom_domain": {
          "type": "string"
        },
        "functions": {
          "type": "object",
          "properties": {
            "api": {
              "type": "string",
              "description": "vercel.api.json"
            },
            "eve": {
              "type": "string",
              "description": "vercel.eve.json"
            }
          }
        },
        "workflow_url": {
          "type": "string",
          "format": "uri"
        },
        "api_url": {
          "type": "string",
          "format": "uri"
        },
        "crons": {
          "type": "string"
        }
      }
    },
    "vm": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "digitalocean",
            "aws",
            "gcp",
            "azure",
            "oci",
            "bare_metal"
          ]
        },
        "host": {
          "type": "string"
        },
        "ssh_alias": {
          "type": "string"
        },
        "cpu": {
          "type": "integer"
        },
        "memory_gb": {
          "type": "number"
        },
        "disk_gb": {
          "type": "number"
        },
        "os": {
          "type": "string"
        },
        "compose": {
          "type": "string"
        },
        "production_url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "inference": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "cloudflare_workers_ai",
            "vercel_ai_gateway"
          ]
        },
        "account_ref": {
          "type": "string",
          "description": "Name of the secret holding the account id, never the value"
        }
      }
    },
    "sandbox": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "vercel_sandbox",
            "modal",
            "none"
          ]
        },
        "prewarm": {
          "type": "boolean"
        }
      }
    },
    "secrets": {
      "type": "array",
      "description": "Names of env vars the deployment must carry (values live in the target platform, never here)",
      "items": {
        "type": "string"
      }
    },
    "secret_store": {
      "type": "string",
      "enum": [
        "vercel_env",
        "vm_env_file"
      ]
    },
    "secrets_user": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Only the user can supply these (external credentials)"
    },
    "secrets_derived": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "provision.py mints or derives these"
    },
    "secrets_optional": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "runtime_env": {
      "type": "object",
      "properties": {
        "OPS_MULTI_TENANT": {
          "type": "string",
          "enum": [
            "0",
            "1"
          ]
        },
        "BROWSER_LOCAL": {
          "type": "string",
          "enum": [
            "0",
            "1"
          ]
        },
        "CSP_REPORT_ONLY": {
          "type": "string",
          "enum": [
            "0",
            "1"
          ]
        },
        "ENABLE_WEB_SEARCH": {
          "type": "string",
          "enum": [
            "true",
            "false"
          ]
        },
        "ENABLE_BROWSER": {
          "type": "string",
          "enum": [
            "true",
            "false"
          ]
        },
        "MODEL_PROVIDER": {
          "type": "string",
          "enum": [
            "cloudflare",
            "gateway"
          ]
        }
      },
      "description": "Non-secret env values derived from application.json; written by provision.py, never edited by hand",
      "additionalProperties": false
    },
    "datastores": {
      "type": "object",
      "properties": {
        "supabase_resource": {
          "type": "string"
        },
        "blob_store": {
          "type": "string"
        }
      }
    },
    "deployed_at": {
      "type": "string",
      "format": "date"
    },
    "configured_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the surface configuration was last applied to the running app"
    }
  }
}
