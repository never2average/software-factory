{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "application.schema.json",
  "title": "Application",
  "description": "One application stamped from a mold. `surface` holds the operator-serviced configuration for each of the six service-surface items; every field maps to a table, env flag or operator:* script in the mold (see docs/STATE.md).",
  "type": "object",
  "required": [
    "app_id",
    "mold_id",
    "status"
  ],
  "properties": {
    "app_id": {
      "type": "string"
    },
    "mold_id": {
      "type": "string"
    },
    "mold_commit": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "stamping",
        "stamped",
        "testing",
        "serviceable",
        "reverted",
        "retired"
      ]
    },
    "customer_id": {
      "type": "string"
    },
    "model": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "cloudflare",
            "gateway"
          ]
        },
        "model": {
          "type": "string",
          "default": "@cf/zai-org/glm-5.2"
        },
        "context_window": {
          "type": "integer"
        },
        "roles": {
          "type": "object",
          "additionalProperties": false,
          "description": "Per-role models on Cloudflare Workers AI (mold: CLOUDFLARE_MODEL_ORCHESTRATOR / CLOUDFLARE_MODEL_SPECIALIST; each falls back to `model`). The orchestrator talks to the person, so it must be a vision model if the deployment wants native image input; the specialist runs delegated text-heavy work.",
          "properties": {
            "orchestrator": {
              "type": "string",
              "pattern": "^@cf/[A-Za-z0-9._/-]+$"
            },
            "specialist": {
              "type": "string",
              "pattern": "^@cf/[A-Za-z0-9._/-]+$"
            }
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "web_search": {
          "type": "boolean",
          "default": true,
          "description": "ENABLE_WEB_SEARCH, build-time"
        },
        "browser": {
          "type": "boolean",
          "default": true,
          "description": "ENABLE_BROWSER, build-time"
        },
        "multi_tenant": {
          "type": "boolean",
          "default": true,
          "description": "OPS_MULTI_TENANT, runtime; false = single workspace"
        }
      },
      "description": "Build-time and runtime toggles the mold recognises"
    },
    "service_surface": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "dm.md",
          "browser",
          "web_search",
          "primary_context",
          "multiplayer_context",
          "custom_workflow_builder"
        ]
      }
    },
    "testing": {
      "type": "object",
      "description": "Last result per lane",
      "additionalProperties": false,
      "properties": {
        "load": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "pass",
                "fail",
                "skipped"
              ]
            },
            "run_at": {
              "type": "string",
              "format": "date-time"
            },
            "report": {
              "type": "string"
            }
          }
        },
        "context": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "pass",
                "fail",
                "skipped"
              ]
            },
            "run_at": {
              "type": "string",
              "format": "date-time"
            },
            "report": {
              "type": "string"
            }
          }
        },
        "functional": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "pass",
                "fail",
                "skipped"
              ]
            },
            "run_at": {
              "type": "string",
              "format": "date-time"
            },
            "report": {
              "type": "string"
            }
          }
        },
        "accessibility": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "pass",
                "fail",
                "skipped"
              ]
            },
            "run_at": {
              "type": "string",
              "format": "date-time"
            },
            "report": {
              "type": "string"
            }
          }
        },
        "responsiveness": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "pass",
                "fail",
                "skipped"
              ]
            },
            "run_at": {
              "type": "string",
              "format": "date-time"
            },
            "report": {
              "type": "string"
            }
          }
        }
      }
    },
    "revert": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        },
        "lane": {
          "type": "string",
          "enum": [
            "load",
            "context",
            "functional",
            "accessibility",
            "responsiveness"
          ]
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "clone_of": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "live_deployment",
            "application"
          ]
        },
        "ref": {
          "type": "string",
          "description": "live: the Vercel project or URL of the source; application: an app_id"
        },
        "snapshot_date": {
          "type": "string",
          "format": "date"
        },
        "regression": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "pass",
                "fail",
                "skipped"
              ]
            },
            "report": {
              "type": "string"
            },
            "run_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "extracted_at": {
          "type": "string",
          "format": "date-time"
        },
        "live_counts": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "note": {
          "type": "string"
        },
        "live_evidence": {
          "type": "object",
          "description": "What extract found on the source deployment: workflows, recipes, definitions, cycles, todos, roster escalations"
        }
      },
      "required": [
        "kind",
        "ref"
      ],
      "description": "Set when this app is meant to replicate an existing deployment and be regression-tested against it"
    },
    "surface": {
      "type": "object",
      "properties": {
        "dm.md": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "top_level": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "Customers",
                  "Platform",
                  "Deployments",
                  "Solutions",
                  "Implementation",
                  "Tickets",
                  "People",
                  "Uploads"
                ]
              },
              "description": "Domains of the data-room tree (dataroom-schema.ts dataroomDomainSchema)"
            },
            "system_of_record": {
              "type": "string",
              "enum": [
                "postgres"
              ]
            }
          },
          "required": [
            "enabled"
          ]
        },
        "browser": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "local": {
              "type": "boolean",
              "default": false,
              "description": "BROWSER_LOCAL"
            },
            "default_on_for_agent": {
              "type": "boolean",
              "description": "agent_profiles.browserDefault"
            }
          },
          "required": [
            "enabled"
          ]
        },
        "web_search": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "default_on_for_agent": {
              "type": "boolean",
              "description": "agent_profiles.webSearchDefault"
            }
          },
          "required": [
            "enabled"
          ]
        },
        "primary_context": {
          "type": "object",
          "properties": {
            "corpus": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "customer_agreements",
                      "customer_context",
                      "customer_personas",
                      "customer_interactions",
                      "product_offerings",
                      "platform_design",
                      "solution_catalog",
                      "rollout_case_studies",
                      "implementation_history",
                      "deployment_records",
                      "tickets",
                      "people_context",
                      "custom"
                    ]
                  },
                  "dataroom_path": {
                    "type": "string",
                    "description": "Path template from dm.md, e.g. Customers/{customer_id}/agreements/"
                  },
                  "description": {
                    "type": "string"
                  },
                  "sync": {
                    "type": "string",
                    "enum": [
                      "manual_entry",
                      "email",
                      "slack",
                      "meeting_notes",
                      "github",
                      "aws",
                      "azure",
                      "gcp",
                      "oci",
                      "bare_metal",
                      "miro",
                      "claude",
                      "codex",
                      "analytics",
                      "observability",
                      "call"
                    ],
                    "description": "How the content arrives; manual_entry when people upload it"
                  },
                  "required": {
                    "type": "boolean",
                    "default": true,
                    "description": "The agent must not run without this content"
                  },
                  "seeded_from": {
                    "type": "string",
                    "enum": [
                      "live_snapshot",
                      "fixtures",
                      "none"
                    ]
                  },
                  "live_files": {
                    "type": "integer",
                    "description": "Files found under the path on the source deployment (extract)"
                  }
                },
                "required": [
                  "kind",
                  "dataroom_path"
                ]
              },
              "minItems": 1,
              "description": "The knowledge the agent reasons over: agreements, offerings, case studies, and so on. Every entry is a data-room location the mold already models"
            },
            "instructions": {
              "type": "object",
              "properties": {
                "workspace": {
                  "type": "string",
                  "description": "agent_profiles.instructions for the workspace default profile"
                },
                "persona_name": {
                  "type": "string"
                },
                "tone": {
                  "type": "string"
                },
                "default_mode": {
                  "type": "string",
                  "enum": [
                    "build",
                    "plan",
                    "goal",
                    "loop"
                  ]
                },
                "model": {
                  "type": "string"
                },
                "subagents": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "agent_key": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9-]{0,79}$",
                        "description": "A subagent key. It must exist in the application's mold (agent/subagents/<key>/agent.ts) or in one of its packs; factory.py validate checks that, since the set differs per application."
                      },
                      "paused": {
                        "type": "boolean",
                        "default": false
                      },
                      "instructions": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "agent_key"
                    ]
                  }
                }
              },
              "description": "How the agent is told to use the corpus (agent_profiles, agent_configs)"
            },
            "memory": {
              "type": "object",
              "properties": {
                "scopes": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "team",
                      "customer",
                      "person"
                    ]
                  }
                },
                "sensitivity_ceiling": {
                  "type": "string",
                  "enum": [
                    "internal",
                    "customer_shareable",
                    "restricted"
                  ],
                  "default": "internal"
                },
                "live_keys": {
                  "type": "integer",
                  "description": "Memory rows on the source deployment (extract)"
                }
              },
              "description": "memories table: what the agent is allowed to remember across turns"
            },
            "entity_vocabulary": {
              "type": "object",
              "properties": {
                "account_noun": {
                  "type": "string",
                  "default": "customer"
                },
                "note": {
                  "type": "string"
                }
              },
              "description": "What the workspace calls its accounts (customers, patients, clients). mold_v1 hardcodes 'customer' in tables, paths and tools; this is recorded for the parity audit and for mold_v2+, not applied"
            },
            "corpus_files": {
              "type": "object",
              "properties": {
                "total": {
                  "type": "integer"
                },
                "error": {
                  "type": "string"
                }
              }
            }
          },
          "required": [
            "corpus"
          ],
          "description": "What the agent knows: the content corpus, the instructions that frame it, and what it may remember"
        },
        "multiplayer_context": {
          "type": "object",
          "properties": {
            "processes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "enum": [
                      "sprint_planning",
                      "onboarding",
                      "escalation_handling",
                      "incident_postmortem",
                      "go_live",
                      "account_review",
                      "renewal",
                      "data_migration",
                      "solution_engineering",
                      "integration_wiring",
                      "eval_triage",
                      "custom"
                    ]
                  },
                  "label": {
                    "type": "string",
                    "description": "Free text when name is custom"
                  },
                  "enabled": {
                    "type": "boolean",
                    "default": true
                  },
                  "implemented_by": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "enum": [
                            "workflow_script",
                            "workflow_definition",
                            "recipe",
                            "cycles",
                            "todos",
                            "roster_escalations",
                            "ticket_folder",
                            "schedule_rule",
                            "chat_threads",
                            "inbox",
                            "api_route"
                          ]
                        },
                        "ref": {
                          "type": "string",
                          "description": "workflow name, recipe slug, definition id, ticket folder, route"
                        },
                        "present": {
                          "type": "boolean",
                          "description": "Found on the source deployment (extract)"
                        }
                      },
                      "required": [
                        "kind",
                        "ref"
                      ]
                    }
                  },
                  "owner_role": {
                    "type": "string",
                    "enum": [
                      "owner",
                      "admin",
                      "engineer",
                      "member"
                    ]
                  },
                  "notify": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
                    }
                  }
                },
                "required": [
                  "name",
                  "implemented_by"
                ]
              },
              "minItems": 1,
              "description": "The shared processes the team runs in the workspace: sprint planning, onboarding, escalation handling. Each points at the mold features that implement it; an empty implemented_by is a parity gap"
            },
            "escalation": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "enum": [
                    "roster_escalations",
                    "pagerduty",
                    "none"
                  ],
                  "description": "people_roster.escalations fan-out, or PagerDuty via route-incident"
                },
                "incident_workflow": {
                  "type": "string",
                  "default": "route-incident"
                },
                "ticket_folders": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "feat",
                      "search",
                      "bug",
                      "docs",
                      "evals",
                      "config_changes",
                      "data_migration",
                      "backfills",
                      "onboarding"
                    ]
                  }
                }
              }
            },
            "collaboration": {
              "type": "object",
              "properties": {
                "chat_threads": {
                  "type": "boolean",
                  "default": true
                },
                "presence": {
                  "type": "boolean",
                  "default": true
                },
                "comments": {
                  "type": "boolean",
                  "default": true
                },
                "inbox": {
                  "type": "boolean",
                  "default": true
                }
              },
              "description": "Mold constants; listed so a mold without them shows as a gap"
            }
          },
          "required": [
            "processes"
          ],
          "description": "How people work together in the workspace, expressed as processes mapped to mold features"
        },
        "custom_workflow_builder": {
          "type": "object",
          "properties": {
            "library": {
              "type": "object",
              "properties": {
                "install": {
                  "type": "string",
                  "enum": [
                    "all",
                    "none",
                    "listed"
                  ],
                  "default": "all"
                },
                "names": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "assign-account",
                      "data-migration-plan",
                      "eval-regression-triage",
                      "go-live-sprint",
                      "incident-postmortem",
                      "infosec-checklist",
                      "infra-sizing",
                      "integration-wiring",
                      "onboard-account",
                      "qbr-prep",
                      "renewal-risk",
                      "route-incident",
                      "solution-engineering"
                    ]
                  }
                }
              },
              "required": [
                "install"
              ],
              "description": "The 13 default workflow scripts installed by provisionWorkspace; 'listed' keeps only names"
            },
            "scripts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "trigger": {
                    "type": "string",
                    "enum": [
                      "on delegation",
                      "manual",
                      "on schedule"
                    ],
                    "default": "manual"
                  },
                  "steps": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "file": {
                    "type": "string",
                    "description": "path to a *.workflow.js relative to the app state dir; required for createdBy=system scripts because seed-workflows prunes rows without a file"
                  },
                  "customer_id": {
                    "type": "string"
                  },
                  "enabled": {
                    "type": "boolean",
                    "default": true
                  },
                  "instructions": {
                    "type": "string"
                  },
                  "instructions_enabled": {
                    "type": "boolean",
                    "default": false
                  },
                  "notify_emails": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
                    }
                  }
                },
                "required": [
                  "name",
                  "description"
                ]
              },
              "description": "Workflow scripts beyond the library (workflows table)"
            },
            "definitions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "entity": {
                    "type": "string",
                    "enum": [
                      "task",
                      "implementation"
                    ]
                  },
                  "is_default": {
                    "type": "boolean",
                    "default": false
                  },
                  "stages": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "label": {
                          "type": "string"
                        },
                        "description": {
                          "type": "string"
                        },
                        "assign": {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "enum": [
                                "none",
                                "role",
                                "person",
                                "team",
                                "customer_owner",
                                "least_loaded",
                                "prompt"
                              ]
                            },
                            "value": {
                              "type": "string"
                            },
                            "department": {
                              "type": "string"
                            },
                            "guidance": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "type"
                          ]
                        },
                        "transitions": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "to": {
                                "type": "string"
                              },
                              "migrate": {
                                "type": "object",
                                "properties": {
                                  "type": {
                                    "type": "string",
                                    "enum": [
                                      "manual",
                                      "rule",
                                      "prompt"
                                    ]
                                  },
                                  "value": {
                                    "type": "string"
                                  }
                                },
                                "required": [
                                  "type"
                                ]
                              }
                            },
                            "required": [
                              "to",
                              "migrate"
                            ]
                          }
                        }
                      },
                      "required": [
                        "id",
                        "label",
                        "assign",
                        "transitions"
                      ]
                    },
                    "minItems": 1
                  }
                },
                "required": [
                  "id",
                  "name",
                  "entity",
                  "stages"
                ]
              },
              "description": "Project workflow state machines (workflow_definitions); one is_default per entity"
            }
          },
          "required": [
            "library"
          ]
        },
        "branding": {
          "type": "object",
          "description": "The visual identity, complete and self-contained. THE SHORT WAY: `branding.py <app_id> set --name \"Acme Ops\" --color #1F6F5C --logo brands/acme/logo.png` fills every field below from those three inputs (palette, icon, sign-in mark, legible foreground, description). The long fields exist for a designer who wants an exact value. This application's visual identity, complete and self-contained: no pointer to shared files, so what this app looks like is readable here and cannot change under it. Copied from the product's `brand` at stamp time. branding.py applies it to a per-app copy of the mold at build time; molds/<mold_id>/branding/rules.json says which files in that mold carry each surface.",
          "properties": {
            "product_name": {
              "type": "string",
              "description": "Replaces the mold's product name in the browser tab, sign-in wordmark and footer, onboarding copy and every outgoing email"
            },
            "tagline": {
              "type": "string",
              "description": "Sign-in page subtitle"
            },
            "description": {
              "type": "string",
              "description": "Page metadata description"
            },
            "brand_color": {
              "type": "string",
              "pattern": "^(#[0-9a-fA-F]{3,6}|oklch\\(.+\\))$",
              "description": "One colour; the palette is derived from it for light and dark"
            },
            "neutral_chroma": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.05,
              "description": "How far neutrals are tinted toward the brand hue (0 = the mold's greyscale)"
            },
            "radius": {
              "type": "string",
              "description": "CSS --radius, e.g. 0.625rem"
            },
            "icon_bg": {
              "type": "string"
            },
            "icon_fg": {
              "type": "string"
            },
            "tokens": {
              "type": "object",
              "description": "Pin individual palette tokens, overriding the values derived from brand_color.",
              "properties": {
                "light": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "dark": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            },
            "icon_svg": {
              "type": "string",
