{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "datainfra.schema.json",
  "title": "DataInfra",
  "description": "How the data room, syncs, pipelines, agents and per-customer platform records are wired for this application. Instance ids here are the slots of DATAROOM_PATH_TEMPLATES.",
  "type": "object",
  "required": [
    "dataroom"
  ],
  "properties": {
    "dataroom": {
      "type": "object",
      "properties": {
        "spec": {
          "type": "string",
          "default": "molds/mold_v1/codebase/dm.md"
        },
        "top_level": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "Customers",
              "Platform",
              "Deployments",
              "Solutions",
              "Implementation",
              "Tickets",
              "People",
              "Uploads"
            ]
          }
        },
        "system_of_record": {
          "type": "string",
          "enum": [
            "postgres"
          ]
        },
        "backend": {
          "type": "string",
          "enum": [
            "vercel-blob",
            "local"
          ],
          "default": "vercel-blob"
        },
        "blob_prefix": {
          "type": "string",
          "description": "orgs/<org_id>"
        },
        "platform_version_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Platform/{platform_version_id} slots"
        },
        "seed": {
          "type": "object",
          "properties": {
            "customers_json": {
              "type": "string"
            },
            "people_json": {
              "type": "string"
            },
            "source": {
              "type": "string",
              "enum": [
                "fixtures",
                "live_snapshot",
                "none"
              ],
              "default": "none"
            }
          },
          "description": "Inputs for seed-dataroom (two flat JSON files) or a copy of the live blob tree"
        }
      },
      "required": [
        "top_level",
        "system_of_record"
      ]
    },
    "syncs": {
      "type": "array",
      "description": "Inbound sync sources enabled for this app",
      "items": {
        "type": "object",
        "required": [
          "source"
        ],
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "manual_entry",
              "email",
              "slack",
              "meeting_notes",
              "github",
              "aws",
              "azure",
              "gcp",
              "oci",
              "bare_metal",
              "miro",
              "claude",
              "codex",
              "analytics",
              "observability",
              "call"
            ]
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "schedule": {
            "type": "string",
            "description": "cron"
          }
        }
      }
    },
    "pipelines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pipeline_id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "customer_id": {
            "type": "string"
          },
          "use_case": {
            "type": "string"
          },
          "config": {
            "type": "string"
          },
          "isolation": {
            "type": "string",
            "enum": [
              "shared",
              "pipeline",
              "role"
            ],
            "description": "pipeline/role isolation arrive with mold_v2/mold_v3"
          }
        },
        "required": [
          "pipeline_id",
          "version"
        ]
      },
      "description": "operator:configure-solution (kind pipeline)"
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "agent_id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "customer_id": {
            "type": "string"
          },
          "use_case": {
            "type": "string"
          },
          "recipe": {
            "type": "string"
          },
          "evals_dir": {
            "type": "string"
          }
        },
        "required": [
          "agent_id",
          "version"
        ]
      },
      "description": "operator:configure-agents (kind agent)"
    },
    "connectors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "secret_ref": {
            "type": "string",
            "description": "name only"
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "deployment_model": {
            "type": "string",
            "default": "single_tenant"
          },
          "data_residency_constraint": {
            "type": "string",
            "default": "none"
          },
          "primary_model": {
            "type": "string"
          },
          "primary_use_case": {
            "type": "string"
          },
          "feature_flags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "enabled_connectors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "version"
        ]
      },
      "description": "operator:configure-platform; one platform row per customer"
    },
    "deployments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "environment": {
            "type": "string",
            "default": "production"
          },
          "region": {
            "type": "string"
          },
          "cloud": {
            "type": "string",
            "enum": [
              "aws",
              "azure",
              "gcp",
              "oci",
              "bare_metal",
              "vercel",
              "digitalocean"
            ]
          }
        },
        "required": [
          "customer_id",
          "version"
        ]
      },
      "description": "operator:configure-infra; deployment_id = version"
    }
  }
}
