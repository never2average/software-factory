{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "datastores.schema.json",
  "title": "Datastores",
  "description": "Backing stores for the application. Postgres is the system of record; blob holds the data room.",
  "type": "object",
  "required": [
    "postgres",
    "blob"
  ],
  "properties": {
    "postgres": {
      "type": "object",
      "required": [
        "provider",
        "scope"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "neon",
            "supabase",
            "rds",
            "self_hosted"
          ]
        },
        "orm": {
          "type": "string",
          "const": "drizzle"
        },
        "migrations_dir": {
          "type": "string",
          "default": "drizzle/"
        },
        "rls": {
          "type": "string",
          "enum": [
            "off",
            "on",
            "fail_closed"
          ]
        },
        "tenancy": {
          "type": "string",
          "enum": [
            "single_org",
            "multi_org"
          ]
        },
        "url_ref": {
          "type": "string"
        },
        "scope": {
          "type": "string",
          "enum": [
            "fresh",
            "shared_with_live"
          ],
          "description": "fresh = own database; shared_with_live = the live fde-agent database, crons stripped on deploy"
        },
        "snapshot": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "enum": [
                "live_fde_agent",
                "application",
                "none"
              ]
            },
            "ref": {
              "type": "string"
            },
            "taken_at": {
              "type": "string",
              "format": "date-time"
            },
            "method": {
              "type": "string",
              "enum": [
                "pg_dump",
                "supabase_branch"
              ]
            }
          },
          "description": "Where the initial data came from when cloning"
        },
        "sslmode": {
          "type": "string",
          "enum": [
            "require",
            "verify-full",
            "disable"
          ],
          "default": "require",
          "description": "The runtime clients pass NO ssl option (agent/lib/db/index.ts, lib/ops-db.ts), so this query parameter on DATABASE_URL is the only thing that turns TLS on. Without it the app speaks plaintext Postgres."
        },
        "admin_url_ref": {
          "type": "string",
          "description": "Secret NAME of the URL with DDL rights (migrations, pg_restore). Never DATABASE_URL after the app_rw bootstrap: that role owns nothing."
        },
        "pooling": {
          "type": "string",
          "enum": [
            "none",
            "transaction",
            "session"
          ],
          "description": "transaction = DATABASE_URL is a transaction pooler (Neon pooled endpoint, Supabase Supavisor:6543). Safe for RLS: app.org_id is set with set_config(...,true), which is transaction-local."
        },
        "exposure": {
          "type": "string",
          "enum": [
            "managed_provider",
            "private_docker_network"
          ],
          "description": "How the database is reachable. There is no public-port option, by design."
        },
        "network": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "database": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        }
      }
    },
    "blob": {
      "type": "object",
      "required": [
        "provider"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "vercel_blob",
            "s3",
            "gcs",
            "azure_blob"
          ]
        },
        "root_prefix": {
          "type": "string"
        },
        "token_ref": {
          "type": "string"
        },
        "store": {
          "type": "string",
          "description": "Store name in the provider"
        },
        "snapshot": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "enum": [
                "live_fde_agent",
                "application",
                "none"
              ]
            },
            "ref": {
              "type": "string"
            },
            "taken_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      }
    },
    "cache": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "upstash_redis",
            "none"
          ]
        },
        "url_ref": {
          "type": "string"
        }
      }
    },
    "memory": {
      "type": "object",
      "description": "Agent memory store",
      "properties": {
        "backend": {
          "type": "string",
          "enum": [
            "postgres",
            "blob"
          ]
        }
      }
    }
  }
}
