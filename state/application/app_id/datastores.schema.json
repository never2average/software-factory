{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "datastores.schema.json",
  "title": "Datastores",
  "description": "Backing stores for the application. Postgres is the system of record; blob holds the data room.",
  "type": "object",
  "required": [
    "postgres",
    "blob"
  ],
  "properties": {
    "postgres": {
      "type": "object",
      "required": [
        "provider",
        "scope"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "neon",
            "supabase",
            "rds",
            "self_hosted"
          ]
        },
        "orm": {
          "type": "string",
          "const": "drizzle"
        },
        "migrations_dir": {
          "type": "string",
          "default": "drizzle/"
        },
        "rls": {
          "type": "string",
          "enum": [
            "off",
            "on",
            "fail_closed"
          ]
        },
        "tenancy": {
          "type": "string",
          "enum": [
            "single_org",
            "multi_org"
          ]
        },
        "url_ref": {
          "type": "string"
        },
        "scope": {
          "type": "string",
          "enum": [
            "fresh",
            "shared_with_live"
          ],
          "description": "fresh = own database; shared_with_live = the live fde-agent database, crons stripped on deploy"
        },
        "snapshot": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "enum": [
                "live_fde_agent",
                "application",
                "none"
              ]
            },
            "ref": {
              "type": "string"
            },
            "taken_at": {
              "type": "string",
              "format": "date-time"
            },
            "method": {
              "type": "string",
              "enum": [
                "pg_dump",
                "supabase_branch"
              ]
            }
          },
          "description": "Where the initial data came from when cloning"
        }
      }
    },
    "blob": {
      "type": "object",
      "required": [
        "provider"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "vercel_blob",
            "s3",
            "gcs",
            "azure_blob"
          ]
        },
        "root_prefix": {
          "type": "string"
        },
        "token_ref": {
          "type": "string"
        },
        "store": {
          "type": "string",
          "description": "Store name in the provider"
        },
        "snapshot": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "enum": [
                "live_fde_agent",
                "application",
                "none"
              ]
            },
            "ref": {
              "type": "string"
            },
            "taken_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      }
    },
    "cache": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "upstash_redis",
            "none"
          ]
        },
        "url_ref": {
          "type": "string"
        }
      }
    },
    "memory": {
      "type": "object",
      "description": "Agent memory store",
      "properties": {
        "backend": {
          "type": "string",
          "enum": [
            "postgres",
            "blob"
          ]
        }
      }
    }
  }
}
