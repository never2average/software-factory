{
  "$schema": "../app_id/infrastructure.schema.json",
  "target": "vercel",
  "secret_store": "vercel_env",
  "inference": {
    "provider": "cloudflare_workers_ai",
    "account_ref": "CLOUDFLARE_ACCOUNT_ID"
  },
  "sandbox": {
    "provider": "vercel_sandbox",
    "prewarm": false
  },
  "secrets": [
    "AUTH_JWT_PRIVATE_KEY",
    "AUTH_JWT_PUBLIC_KEY",
    "BLOB_READ_WRITE_TOKEN",
    "CLOUDFLARE_ACCOUNT_ID",
    "CLOUDFLARE_API_TOKEN",
    "CRON_SECRET",
    "DATABASE_URL",
    "DATABASE_URL_UNPOOLED",
    "EXA_API_KEY",
    "GOOGLE_CLIENT_ID",
    "MODEL_PROVIDER",
    "NEXT_PUBLIC_EVE_API_URL",
    "NEXT_PUBLIC_GOOGLE_CLIENT_ID",
    "OPS_SECRETS_KEY",
    "PLATFORM_NOTIFY_FROM",
    "RESEND_API_KEY",
    "TASK_WORKFLOW_SERVICE_TOKEN",
    "TASK_WORKFLOW_SERVICE_URL"
  ],
  "secrets_user": [
    "CLOUDFLARE_ACCOUNT_ID",
    "CLOUDFLARE_API_TOKEN",
    "RESEND_API_KEY",
    "PLATFORM_NOTIFY_FROM",
    "EXA_API_KEY",
    "GOOGLE_CLIENT_ID",
    "NEXT_PUBLIC_GOOGLE_CLIENT_ID"
  ],
  "secrets_derived": [
    "DATABASE_URL",
    "DATABASE_URL_UNPOOLED",
    "BLOB_READ_WRITE_TOKEN",
    "CRON_SECRET",
    "OPS_SECRETS_KEY",
    "AUTH_JWT_PRIVATE_KEY",
    "AUTH_JWT_PUBLIC_KEY",
    "MODEL_PROVIDER",
    "TASK_WORKFLOW_SERVICE_TOKEN",
    "TASK_WORKFLOW_SERVICE_URL",
    "NEXT_PUBLIC_EVE_API_URL"
  ],
  "secrets_optional": [],
  "runtime_env": {
    "OPS_MULTI_TENANT": "1",
    "ENABLE_WEB_SEARCH": "true",
    "ENABLE_BROWSER": "false",
    "MODEL_PROVIDER": "cloudflare"
  },
  "vercel": {
    "team": "f20170061g-3183s-projects",
    "project": "onfinance-hfc",
    "functions": {
      "api": "vercel.api.json",
      "eve": "vercel.eve.json"
    }
  }
}
