{
  "$schema": "../app_id/datastores.schema.json",
  "postgres": {
    "provider": "neon",
    "orm": "drizzle",
    "migrations_dir": "drizzle/",
    "rls": "fail_closed",
    "tenancy": "multi_org",
    "url_ref": "DATABASE_URL",
    "scope": "fresh",
    "sslmode": "require",
    "admin_url_ref": "DATABASE_URL_UNPOOLED",
    "pooling": "transaction"
  },
  "blob": {
    "provider": "vercel_blob",
    "root_prefix": "orgs/onfinance-ai",
    "token_ref": "BLOB_READ_WRITE_TOKEN"
  },
  "cache": {
    "provider": "none"
  },
  "memory": {
    "backend": "postgres"
  }
}
