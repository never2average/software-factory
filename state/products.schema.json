{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "products.schema.json",
  "title": "Products",
  "description": "Software products the factory converts molds into. One product per mold; a product advances through stages as tasks close.",
  "type": "object",
  "required": [
    "products"
  ],
  "properties": {
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "product_id",
          "mold_id",
          "name",
          "stage",
          "gates"
        ],
        "properties": {
          "product_id": {
            "type": "string"
          },
          "mold_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "tagline": {
            "type": "string"
          },
          "stage": {
            "type": "string",
            "enum": [
              "defined",
              "stamped",
              "lanes_passing",
              "deployed",
              "released"
            ]
          },
          "target_model": {
            "type": "string"
          },
          "gates": {
            "type": "object",
            "description": "What must be true to advance to each stage",
            "properties": {
              "stamped": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "lanes_passing": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "deployed": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "released": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "app_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "deploy_targets": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "vercel",
                "vm",
                "vm_remote",
                "compose_remote"
              ]
            }
          },
          "vercel_project": {
            "type": "string",
            "description": "Project name for the product's first app; later apps get <project>-<suffix>."
          },
          "brand": {
            "type": "object",
            "description": "The visual identity, complete and self-contained. THE SHORT WAY: `branding.py <app_id> set --name \"Acme Ops\" --color #1F6F5C --logo brands/acme/logo.png` fills every field below from those three inputs (palette, icon, sign-in mark, legible foreground, description). The long fields exist for a designer who wants an exact value. The product's visual identity. Copied into an application's surface.branding when it is stamped, so an app is self-contained: editing this later does not change an app that already exists.",
            "properties": {
              "product_name": {
                "type": "string"
              },
              "tagline": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "brand_color": {
                "type": "string",
                "pattern": "^(#[0-9a-fA-F]{3,6}|oklch\\(.+\\))$"
              },
              "neutral_chroma": {
                "type": "number",
                "minimum": 0,
                "maximum": 0.05
              },
              "radius": {
                "type": "string"
              },
              "icon_bg": {
                "type": "string"
              },
              "icon_fg": {
                "type": "string"
              },
              "icon_svg": {
                "type": "string",
                "description": "32x32 SVG source, viewBox=\"0 0 32 32\""
              },
              "tokens": {
                "type": "object",
                "properties": {
                  "light": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "dark": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                }
              },
              "logo": {
                "type": "string",
                "description": "Where the mark came from: a PNG, JPG, WebP or SVG file path relative to the repo root (e.g. brands/acme/logo.png). Provenance only; icon_svg carries the inlined result."
              }
            },
            "required": [
              "product_name"
            ]
          },
          "packs": {
            "type": "array",
            "description": "Packs every application of this product gets (packs/<pack_id>/). Products differ by pack and brand, never by forking a mold. The ids are the mold's (as application.json packs): mold_v1's lowercase letters, digits and hyphens; mold_v0's letters, digits and underscores.",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{1,40}$"
            }
          },
          "gate_evidence": {
            "type": "object",
            "description": "Optional, written by the productize skill: per stage, each gate with the evidence that exists today and, for an open one, what closes it. A record for people and agents; `stage` still moves only through factory.py close.",
            "additionalProperties": false,
            "properties": {
              "stamped": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "gate",
                    "status",
                    "evidence"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "gate": {
                      "type": "string",
                      "description": "The gate's text, as it stands in `gates.<stage>`."
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "met",
                        "open"
                      ],
                      "description": "met: the evidence shows it true today. open: something named in closes_with is still missing."
                    },
                    "evidence": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "What exists today: merged PRs, task ids, lane reports, deploy records (paths and dates). Never a hope."
                    },
                    "closes_with": {
                      "type": "string",
                      "description": "For an open gate: exactly what closes it, and who does it."
                    },
                    "as_of": {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    }
                  }
                }
              },
              "lanes_passing": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "gate",
                    "status",
                    "evidence"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "gate": {
                      "type": "string",
                      "description": "The gate's text, as it stands in `gates.<stage>`."
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "met",
                        "open"
                      ],
                      "description": "met: the evidence shows it true today. open: something named in closes_with is still missing."
                    },
                    "evidence": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "What exists today: merged PRs, task ids, lane reports, deploy records (paths and dates). Never a hope."
                    },
                    "closes_with": {
                      "type": "string",
                      "description": "For an open gate: exactly what closes it, and who does it."
                    },
                    "as_of": {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    }
                  }
                }
              },
              "deployed": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "gate",
                    "status",
                    "evidence"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "gate": {
                      "type": "string",
                      "description": "The gate's text, as it stands in `gates.<stage>`."
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "met",
                        "open"
                      ],
                      "description": "met: the evidence shows it true today. open: something named in closes_with is still missing."
                    },
                    "evidence": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "What exists today: merged PRs, task ids, lane reports, deploy records (paths and dates). Never a hope."
                    },
                    "closes_with": {
                      "type": "string",
                      "description": "For an open gate: exactly what closes it, and who does it."
                    },
                    "as_of": {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    }
                  }
                }
              },
              "released": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "gate",
                    "status",
                    "evidence"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "gate": {
                      "type": "string",
                      "description": "The gate's text, as it stands in `gates.<stage>`."
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "met",
                        "open"
                      ],
                      "description": "met: the evidence shows it true today. open: something named in closes_with is still missing."
                    },
                    "evidence": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "What exists today: merged PRs, task ids, lane reports, deploy records (paths and dates). Never a hope."
                    },
                    "closes_with": {
                      "type": "string",
                      "description": "For an open gate: exactly what closes it, and who does it."
                    },
                    "as_of": {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    }
                  }
                }
              }
            }
          }
        },
        "description": "One product. Several products may share a mold: same codebase, different brand and packaging (a brief picks one with `product: <id>`)."
      }
    }
  }
}
