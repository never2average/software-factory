{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "products.schema.json",
  "title": "Products",
  "description": "Software products the factory converts molds into. One product per mold; a product advances through stages as tasks close.",
  "type": "object",
  "required": [
    "products"
  ],
  "properties": {
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "product_id",
          "mold_id",
          "name",
          "stage",
          "gates"
        ],
        "properties": {
          "product_id": {
            "type": "string"
          },
          "mold_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "tagline": {
            "type": "string"
          },
          "stage": {
            "type": "string",
            "enum": [
              "defined",
              "stamped",
              "lanes_passing",
              "deployed",
              "released"
            ]
          },
          "target_model": {
            "type": "string"
          },
          "gates": {
            "type": "object",
            "description": "What must be true to advance to each stage",
            "properties": {
              "stamped": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "lanes_passing": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "deployed": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "released": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "app_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "deploy_targets": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "vercel",
                "vm"
              ]
            }
          },
          "vercel_project": {
            "type": "string",
            "description": "Project name for the product's first app; later apps get <project>-<suffix>."
          },
          "brand": {
            "type": "object",
            "description": "The product's visual identity. Copied into an application's surface.branding when it is stamped, so an app is self-contained: editing this later does not change an app that already exists.",
            "properties": {
              "product_name": {
                "type": "string"
              },
              "tagline": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "brand_color": {
                "type": "string",
                "pattern": "^(#[0-9a-fA-F]{3,6}|oklch\\(.+\\))$"
              },
              "neutral_chroma": {
                "type": "number",
                "minimum": 0,
                "maximum": 0.05
              },
              "radius": {
                "type": "string"
              },
              "icon_bg": {
                "type": "string"
              },
              "icon_fg": {
                "type": "string"
              },
              "icon_svg": {
                "type": "string",
                "description": "32x32 SVG source, viewBox=\"0 0 32 32\""
              },
              "tokens": {
                "type": "object",
                "properties": {
                  "light": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "dark": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "required": [
              "product_name"
            ]
          }
        },
        "description": "One product. Several products may share a mold: same codebase, different brand and packaging (a brief picks one with `product: <id>`)."
      }
    }
  }
}
