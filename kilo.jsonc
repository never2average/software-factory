// Kilo CLI: the same allow/ask split as .claude/settings.json. Last matching rule wins, so every command asks
// first, then the read-only factory commands are allowed, then the risky ones ask again. Kilo's docs say compound
// commands are split and every part must be permitted, so wildcards are safe here (opencode.json, whose docs don't
// say so, allows exact commands only). See docs/AGENT_INTEGRATION.md.
{
  "permission": {
    "bash": {
      "*": "ask",
      "python3 .claude/scripts/factory.py doctor*": "allow",
      "python3 .claude/scripts/factory.py status*": "allow",
      "python3 .claude/scripts/factory.py tasks*": "allow",
      "python3 .claude/scripts/factory.py next*": "allow",
      "python3 .claude/scripts/factory.py validate*": "allow",
      "python3 .claude/scripts/mint.py *": "allow",
      "python3 .claude/scripts/provision.py * --json": "allow",
      "python3 .claude/scripts/provision.py * status*": "allow",
      "python3 .claude/scripts/provision.py * --capacity*": "allow",
      "python3 .claude/scripts/provision.py * --dry-run*": "allow",
      "python3 .claude/scripts/lanes.py * --list*": "allow",
      "python3 .claude/scripts/lanes.py * --dry-run*": "allow",
      "python3 .claude/scripts/lanes.py * status*": "allow",
      "python3 .claude/scripts/repo.py * status*": "allow",
      "python3 .claude/scripts/mold.py check *": "allow",
      "python3 .claude/scripts/mold.py fetch *": "allow",
      "python3 .claude/scripts/packs.py list*": "allow",
      "python3 .claude/scripts/packs.py show *": "allow",
      "python3 .claude/scripts/packs.py check *": "allow",
      "python3 .claude/scripts/packs.py verify *": "allow",
      "python3 .claude/scripts/branding.py * show*": "allow",
      "python3 .claude/scripts/branding.py * preview*": "allow",
      "python3 .claude/scripts/branding.py * check*": "allow",
      "python3 .claude/scripts/domain.py * status*": "allow",
      "python3 .claude/scripts/domain.py * verify*": "allow",
      "python3 .claude/scripts/agent_cli.py * status*": "allow",
      "python3 .claude/scripts/library.py * show*": "allow",
      "python3 .claude/scripts/clone.py * plan*": "allow",
      "python3 .claude/scripts/app_usage.py *": "allow",
      "python3 .claude/scripts/mint_report.py *": "allow",
      "python3 .agents/scripts/factory.py doctor*": "allow",
      "python3 .agents/scripts/factory.py status*": "allow",
      "python3 .agents/scripts/factory.py tasks*": "allow",
      "python3 .agents/scripts/factory.py next*": "allow",
      "python3 .agents/scripts/factory.py validate*": "allow",
      "python3 .agents/scripts/mint.py *": "allow",
      "python3 .agents/scripts/provision.py * --json": "allow",
      "python3 .agents/scripts/provision.py * status*": "allow",
      "python3 .agents/scripts/provision.py * --capacity*": "allow",
      "python3 .agents/scripts/provision.py * --dry-run*": "allow",
      "python3 .agents/scripts/lanes.py * --list*": "allow",
      "python3 .agents/scripts/lanes.py * --dry-run*": "allow",
      "python3 .agents/scripts/lanes.py * status*": "allow",
      "python3 .agents/scripts/repo.py * status*": "allow",
      "python3 .agents/scripts/mold.py check *": "allow",
      "python3 .agents/scripts/mold.py fetch *": "allow",
      "python3 .agents/scripts/packs.py list*": "allow",
      "python3 .agents/scripts/packs.py show *": "allow",
      "python3 .agents/scripts/packs.py check *": "allow",
      "python3 .agents/scripts/packs.py verify *": "allow",
      "python3 .agents/scripts/branding.py * show*": "allow",
      "python3 .agents/scripts/branding.py * preview*": "allow",
      "python3 .agents/scripts/branding.py * check*": "allow",
      "python3 .agents/scripts/domain.py * status*": "allow",
      "python3 .agents/scripts/domain.py * verify*": "allow",
      "python3 .agents/scripts/agent_cli.py * status*": "allow",
      "python3 .agents/scripts/library.py * show*": "allow",
      "python3 .agents/scripts/clone.py * plan*": "allow",
      "python3 .agents/scripts/app_usage.py *": "allow",
      "python3 .agents/scripts/mint_report.py *": "allow",
      "python3 .claude/scripts/mint.py * run*": "ask",
      "python3 .claude/scripts/mint.py * reuse-keys*": "ask",
      "python3 .claude/scripts/mint.py * code-request*": "ask",
      "python3 .claude/scripts/mint.py * code *": "ask",
      "python3 .claude/scripts/provision.py * --deploy*": "ask",
      "python3 .claude/scripts/provision.py * --set-secret*": "ask",
      "python3 .claude/scripts/provision.py * --verify-db*": "ask",
      "python3 .claude/scripts/provision.py * --verify-rls*": "ask",
      "python3 .claude/scripts/provision.py * --apply*": "ask",
      "python3 .claude/scripts/provision.py * --tunnel-remote*": "ask",
      "python3 .claude/scripts/lanes.py * --apply*": "ask",
      "python3 .claude/scripts/repo.py * publish*": "ask",
      "python3 .claude/scripts/repo.py * push*": "ask",
      "python3 .claude/scripts/repo.py * unlink*": "ask",
      "python3 .claude/scripts/repo.py * auto-push*": "ask",
      "python3 .claude/scripts/domain.py * attach*": "ask",
      "python3 .claude/scripts/domain.py * switch*": "ask",
      "python3 .claude/scripts/agent_cli.py * publish*": "ask",
      "python3 .claude/scripts/library.py * --apply*": "ask",
      "python3 .claude/scripts/clone.py * run*": "ask",
      "python3 .claude/scripts/clone.py * snapshot*": "ask",
      "python3 .claude/scripts/clone.py * configure*": "ask",
      "python3 .claude/scripts/workspace.py *": "ask",
      "python3 .claude/scripts/mold.py refresh *": "ask",
      "python3 .agents/scripts/mint.py * run*": "ask",
      "python3 .agents/scripts/mint.py * reuse-keys*": "ask",
      "python3 .agents/scripts/mint.py * code-request*": "ask",
      "python3 .agents/scripts/mint.py * code *": "ask",
      "python3 .agents/scripts/provision.py * --deploy*": "ask",
      "python3 .agents/scripts/provision.py * --set-secret*": "ask",
      "python3 .agents/scripts/provision.py * --verify-db*": "ask",
      "python3 .agents/scripts/provision.py * --verify-rls*": "ask",
      "python3 .agents/scripts/provision.py * --apply*": "ask",
      "python3 .agents/scripts/provision.py * --tunnel-remote*": "ask",
      "python3 .agents/scripts/lanes.py * --apply*": "ask",
      "python3 .agents/scripts/repo.py * publish*": "ask",
      "python3 .agents/scripts/repo.py * push*": "ask",
      "python3 .agents/scripts/repo.py * unlink*": "ask",
      "python3 .agents/scripts/repo.py * auto-push*": "ask",
      "python3 .agents/scripts/domain.py * attach*": "ask",
      "python3 .agents/scripts/domain.py * switch*": "ask",
      "python3 .agents/scripts/agent_cli.py * publish*": "ask",
      "python3 .agents/scripts/library.py * --apply*": "ask",
      "python3 .agents/scripts/clone.py * run*": "ask",
      "python3 .agents/scripts/clone.py * snapshot*": "ask",
      "python3 .agents/scripts/clone.py * configure*": "ask",
      "python3 .agents/scripts/workspace.py *": "ask",
      "python3 .agents/scripts/mold.py refresh *": "ask",
      "git push --force*": "ask",
      "git push -f*": "ask",
      "git push * --force*": "ask",
      "git push * -f*": "ask",
      "git push * +*": "ask",
      "npm publish*": "ask",
      "gh repo create*": "ask",
      "gh repo delete*": "ask",
      "vercel --prod*": "ask",
      "vercel * --prod*": "ask",
      "vercel deploy*": "ask",
      "vercel remove*": "ask",
      "vercel rm*": "ask",
      "vercel project rm*": "ask"
    }
  }
}
