.DS_Store
*.log
node_modules/
.env
.env.*
!.env.example
.vercel/
molds/**/vercel.nocron.json
__pycache__/
*.pyc
build/

# generated per-app database artifacts: the compose file and README are generated output and may be
# committed, but the Postgres superuser password and the server TLS private key never are. These two
# rules exist so the protection cannot depend on which provision.py path created the directory.
infra/vm/apps/*/.pg-admin
infra/vm/apps/*/pg/

# dry-run lane reports: scratch by construction — the header of each says nothing was recorded
molds/**/testing/*/reports/dry/
