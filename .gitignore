.DS_Store
*.log
node_modules/
.env
.env.*
!.env.example
.vercel/
molds/**/vercel.nocron.json
__pycache__/
*.pyc
build/

# generated per-app database artifacts: the compose file and README are generated output and may be
# committed, but the Postgres superuser password and the server TLS private key never are. These two
# rules exist so the protection cannot depend on which provision.py path created the directory.
infra/vm/apps/*/.pg-admin
infra/vm/apps/*/pg/

# dry-run lane reports: scratch by construction — the header of each says nothing was recorded
molds/**/testing/*/reports/dry/
plugins/*/.claude-plugin/types/

# per-app usage reports (app_usage.py): regenerated on demand, counts only
reports/usage/
# app_usage.py --self-test: a stand-in `postgres` package (fixture code, not an install)
!.claude/scripts/fixtures/app_usage/fake-app/node_modules/
!.agents/scripts/fixtures/app_usage/fake-app/node_modules/

# Kept on the factory machine, never in the repository (open-source split, 2026-10-09): each application's own code,
# records and results. The factory reads them from disk. (Each mold's codebase IS committed, at its pinned version.)
/packs/
/brands/
/briefs/
/reports/
/molds/*/testing/*/reports/
/state/application/*
!/state/application/app_id/

# This machine's real operator email, notification domain, Vercel team and address (lib/factory_local.py).
/state/factory.local.json

# This machine's and operator's own agent instructions (AGENTS.md says to read it when present).
/AGENTS.local.md

# Run records, logs and locks of deploys and lane runs (lib/runs.py, lib/agent_result.py): this machine's own.
/.runs/
